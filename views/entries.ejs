<%- include('layout', { title: 'Giriş/Çıkış Listesi' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="bi bi-arrow-left-right"></i> Giriş/Çıkış Listesi</h4>
</div>

<!-- Tarih Filtresi -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-2">
    <form method="GET" class="row g-2 align-items-center" id="entriesFilterForm">
      <div class="col-md-3">
        <label class="form-label form-label-sm mb-1">Tarih Seç</label>
        <input type="date" class="form-control form-control-sm" name="date" value="<%= selectedDate %>" onchange="this.form.submit()">
      </div>
    </form>
  </div>
</div>

<!-- Bugünün Girişleri -->
<h5 class="mb-3">
  <i class="bi bi-box-arrow-in-right"></i> Bugünün Girişleri
  <span class="badge bg-success"><%= dailyEntries.length %></span>
</h5>
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body p-0">
    <% if (dailyEntries.length === 0) { %>
      <div class="text-center text-muted py-4">
        <p class="mb-0">Seçili tarihte giriş yapan personel yok</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Personel</th>
            <th>Departman</th>
            <th>Oda</th>
            <th>Giriş Saati</th>
            <th>Durum</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% dailyEntries.forEach(item => { %>
          <tr>
            <td>
              <% const fullName = `${item.first_name || ''} ${item.last_name || ''}`.trim(); %>
              <% if (item.personnel_id) { %>
                <a href="/personel/<%= item.personnel_id %>" class="text-decoration-none fw-bold"><%= fullName || '-' %></a>
              <% } else { %>
                <strong><%= fullName || '-' %></strong>
              <% } %>
            </td>
            <td><%= item.department || '-' %></td>
            <td>
              <% if (item.room_id) { %>
                <a href="/odalar/<%= item.room_id %>"><span class="badge bg-primary"><%= item.room_number || '-' %></span></a>
              <% } else { %>
                -
              <% } %>
            </td>
            <td><small><%= item.entry_at ? new Date(item.entry_at).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) : '-' %></small></td>
            <td>
              <% if (item.personnel_status === 'aktif') { %>
                <span class="badge bg-success">Aktif</span>
              <% } else if (item.personnel_status === 'bosta') { %>
                <span class="badge bg-warning text-dark">Boşta</span>
              <% } else if (item.personnel_status === 'cikis_yapti') { %>
                <span class="badge bg-secondary">Çıkış Yapmış</span>
              <% } else { %>
                <span class="badge bg-light text-dark">-</span>
              <% } %>
            </td>
            <td>
              <% if (item.personnel_id) { %>
                <a href="/personel/<%= item.personnel_id %>" class="btn btn-sm btn-outline-primary" title="Detay"><i class="bi bi-eye"></i></a>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Bugünün Çıkışları -->
<h5 class="mb-3">
  <i class="bi bi-box-arrow-right"></i> Bugünün Çıkışları
  <span class="badge bg-danger"><%= dailyExits.length %></span>
</h5>
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (dailyExits.length === 0) { %>
      <div class="text-center text-muted py-4">
        <p class="mb-0">Seçili tarihte çıkış yapan personel yok</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Personel</th>
            <th>Departman</th>
            <th>Oda</th>
            <th>Çıkış Saati</th>
            <th>Durum</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% dailyExits.forEach(item => { %>
          <tr>
            <td>
              <% const fullName = `${item.first_name || ''} ${item.last_name || ''}`.trim(); %>
              <% if (item.personnel_id) { %>
                <a href="/personel/<%= item.personnel_id %>" class="text-decoration-none fw-bold"><%= fullName || '-' %></a>
              <% } else { %>
                <strong><%= fullName || '-' %></strong>
              <% } %>
            </td>
            <td><%= item.department || '-' %></td>
            <td>
              <% if (item.room_id) { %>
                <a href="/odalar/<%= item.room_id %>"><span class="badge bg-primary"><%= item.room_number || '-' %></span></a>
              <% } else { %>
                -
              <% } %>
            </td>
            <td><small><%= item.exit_at ? new Date(item.exit_at).toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) : '-' %></small></td>
            <td>
              <% if (item.personnel_status === 'aktif') { %>
                <span class="badge bg-success">Aktif</span>
              <% } else if (item.personnel_status === 'bosta') { %>
                <span class="badge bg-warning text-dark">Boşta</span>
              <% } else if (item.personnel_status === 'cikis_yapti') { %>
                <span class="badge bg-secondary">Çıkış Yapmış</span>
              <% } else { %>
                <span class="badge bg-light text-dark">-</span>
              <% } %>
            </td>
            <td>
              <% if (item.personnel_id) { %>
                <a href="/personel/<%= item.personnel_id %>" class="btn btn-sm btn-outline-primary" title="Detay"><i class="bi bi-eye"></i></a>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('footer') %>
