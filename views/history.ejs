<%- include('layout', { title: 'Geçmiş Hareketler' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="bi bi-clock-history"></i> Geçmiş Hareketler</h4>
</div>

<!-- Filtre -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-2">
    <form method="GET" class="row g-2 align-items-center">
      <div class="col-md-3">
        <input type="text" class="form-control form-control-sm" name="search" placeholder="Açıklama ara..." value="<%= search %>">
      </div>
      <div class="col-md-2">
        <input type="date" class="form-control form-control-sm" name="date" value="<%= dateFilter %>" onchange="this.form.submit()">
      </div>
      <div class="col-md-3">
        <select class="form-select form-select-sm" name="type" onchange="this.form.submit()">
          <option value="">Tüm İşlemler</option>
          <% actionTypes.forEach(at => { %>
            <option value="<%= at.action_type %>" <%= typeFilter === at.action_type ? 'selected' : '' %>><%= at.action_type %></option>
          <% }) %>
        </select>
      </div>
      <% if (search || dateFilter || typeFilter) { %>
      <div class="col-md-2">
        <a href="/gecmis" class="btn btn-sm btn-outline-secondary w-100">Temizle</a>
      </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Kayıtlar -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (activities.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-clock-history fs-1"></i>
        <p class="mt-2">Hareket kaydı bulunamadı</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Tarih/Saat</th>
            <th>İşlem</th>
            <th>Açıklama</th>
            <th>Detay</th>
            <th>Kullanıcı</th>
          </tr>
        </thead>
        <tbody>
          <% activities.forEach(a => { %>
          <tr>
            <td class="text-nowrap"><small><%= new Date(a.created_at).toLocaleString('tr-TR') %></small></td>
            <td><span class="badge bg-primary"><%= a.action_type %></span></td>
            <td><%= a.description %></td>
            <td><small class="text-muted"><%= a.details || '-' %></small></td>
            <td><%= a.user_name || '-' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('footer') %>
