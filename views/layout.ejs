<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %>Lojman Yönetim Paneli</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="d-flex">
    <!-- Sidebar -->
    <nav id="sidebar" class="sidebar bg-dark">
      <div class="sidebar-header p-3 text-center">
        <h5 class="text-white mb-0"><i class="bi bi-building"></i> Lojman Paneli</h5>
      </div>
      <ul class="nav flex-column px-2">
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath === '/dashboard' ? 'active' : '' %>" href="/dashboard">
            <i class="bi bi-speedometer2"></i> Ana Sayfa
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/notlar') ? 'active' : '' %>" href="/notlar">
            <i class="bi bi-journal-text"></i> Notlar
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/personel') ? 'active' : '' %>" href="/personel">
            <i class="bi bi-people"></i> Personel
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/odalar') ? 'active' : '' %>" href="/odalar">
            <i class="bi bi-door-open"></i> Odalar
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/ziyaretciler') ? 'active' : '' %>" href="/ziyaretciler">
            <i class="bi bi-person-badge"></i> Ziyaretçi Takip
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/esya-takip') ? 'active' : '' %>" href="/esya-takip">
            <i class="bi bi-box-seam"></i> Eşya Takip
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/giris-cikis') ? 'active' : '' %>" href="/giris-cikis">
            <i class="bi bi-arrow-left-right"></i> Giriş/Çıkış
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/rapor-olustur') ? 'active' : '' %>" href="/rapor-olustur">
            <i class="bi bi-file-earmark-text"></i> Rapor Oluştur
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link text-white <%= currentPath.startsWith('/gecmis') ? 'active' : '' %>" href="/gecmis">
            <i class="bi bi-clock-history"></i> Geçmiş
          </a>
        </li>

      </ul>
      <div class="sidebar-footer p-3 mt-auto">
        <div class="text-white-50 small">
          <i class="bi bi-building"></i> Lojman Yönetim v1.0
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="main-content flex-grow-1">
      <nav class="navbar navbar-light bg-white shadow-sm px-3 px-md-4 mb-0">
        <button class="btn btn-link text-dark d-md-none" id="sidebarToggle">
          <i class="bi bi-list fs-4"></i>
        </button>
        <span class="navbar-text ms-auto text-muted small d-none d-sm-inline">
          <%= new Date().toLocaleDateString('tr-TR', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %>
        </span>
        <span class="navbar-text ms-auto text-muted small d-sm-none">
          <%= new Date().toLocaleDateString('tr-TR', { year: 'numeric', month: '2-digit', day: '2-digit' }) %>
        </span>
      </nav>
      <div class="container-fluid p-4">
