<%- include('../layout', { title: `Oda ${room.room_number}` }) %>

<%
const defaultDepartmentOptions = [
  'Gece Denetimi',
  'Güvenlik',
  'Steward',
  'Bar',
  'Restaurant',
  'Houskeeping',
  'Meydan',
  'Önbüro',
  'Satış Pazarlama',
  'Housekeeping',
  'Resepsiyon',
  'Ön Büro',
  'Teknik Servis',
  'Kat Hizmetleri',
  'Yiyecek & İçecek',
  'Mutfak',
  'Muhasebe',
  'İnsan Kaynakları',
  'Satış & Pazarlama',
  'Çamaşırhane',
  'Bellboy'
];
const dynamicDepartmentOptions = (departments || []).map(d => d.department).filter(Boolean);
const departmentOptions = Array.from(new Set([...defaultDepartmentOptions, ...dynamicDepartmentOptions]))
  .sort((a, b) => a.localeCompare(b, 'tr'));
const roomAvailability = room.availability_status || 'musait';
%>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <a href="javascript:history.back();" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i> Geri Dön</a>
    <h4 class="mt-1 mb-0">
      <i class="bi bi-door-open"></i> Oda <%= room.room_number %>
      <% if (room.status === 'bos') { %>
        <span class="badge bg-success fs-6">Boş</span>
      <% } else if (room.status === 'dolu') { %>
        <span class="badge bg-danger fs-6">Dolu</span>
      <% } else if (room.status === 'kismi_dolu') { %>
        <span class="badge bg-warning text-dark fs-6">Kısmi Dolu</span>
      <% } else if (room.status === 'depo') { %>
        <span class="badge bg-info text-dark fs-6"><i class="bi bi-box-seam"></i> Depo</span>
      <% } else { %>
        <span class="badge bg-secondary fs-6">Bakımda</span>
      <% } %>
    </h4>
  </div>
  <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
    <form method="POST" action="/odalar/<%= room.id %>/musaitlik-guncelle" class="d-flex align-items-center gap-2">
      <label class="small text-muted mb-0">Müsaitlik</label>
      <select class="form-select form-select-sm" name="availability_status" style="min-width: 220px;" onchange="this.form.submit()">
        <option value="musait" <%= roomAvailability === 'musait' ? 'selected' : '' %>>Oda Müsait</option>
        <option value="temizlenmeli" <%= roomAvailability === 'temizlenmeli' ? 'selected' : '' %>>Temizlenmesi Gerekiyor</option>
        <option value="kullanilamaz" <%= roomAvailability === 'kullanilamaz' ? 'selected' : '' %>>Oda Kullanılamaz</option>
      </select>
    </form>
    <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editRoomModal">
      <i class="bi bi-pencil"></i> Düzenle
    </button>
    <form method="POST" action="/odalar/<%= room.id %>/sil" class="d-inline" onsubmit="return confirm('Bu odayı silmek istediğinize emin misiniz?')">
      <button class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Sil</button>
    </form>
  </div>
</div>

<% if (errorMessage) { %>
  <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
<% } %>

<!-- Oda Bilgileri -->
<div class="row g-3 mb-4">
  <div class="col-md-3">
    <div class="card border-0 shadow-sm text-center">
      <div class="card-body">
        <% if (room.status === 'depo') { %>
          <h6 class="text-muted">Kullanım</h6>
          <h3><i class="bi bi-box-seam"></i></h3>
          <small class="text-info">Depo</small>
        <% } else { %>
          <h6 class="text-muted">Kapasite</h6>
          <h3><%= occupants.length %>/<%= room.capacity %></h3>
        <% } %>
      </div>
    </div>
  </div>
  <div class="col-md-3">
    <div class="card border-0 shadow-sm text-center">
      <div class="card-body">
        <h6 class="text-muted">Kat</h6>
        <h3><%= room.floor || '-' %></h3>
      </div>
    </div>
  </div>
  <div class="col-md-6">
    <div class="card border-0 shadow-sm">
      <div class="card-body">
        <h6 class="text-muted">Açıklama</h6>
        <p class="mb-0"><%= room.description || 'Açıklama yok' %></p>
      </div>
    </div>
  </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item">
    <a class="nav-link active" data-bs-toggle="tab" href="#personeller">
      <i class="bi bi-people"></i> Personeller (<%= occupants.length %>)
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-bs-toggle="tab" href="#sorunlar">
      <i class="bi bi-exclamation-circle"></i> Sorunlar (<%= (openRoomIssueCount || 0) + (openInventoryIssueCount || 0) %>)
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-bs-toggle="tab" href="#envanter">
      <i class="bi bi-box-seam"></i> Demirbaş (<%= inventory.length %>)
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-bs-toggle="tab" href="#gecmis">
      <i class="bi bi-clock-history"></i> Geçmiş (<%= (roomHistory || []).length %>)
    </a>
  </li>
</ul>

<div class="tab-content">
  <!-- Personeller Tab -->
  <div class="tab-pane fade show active" id="personeller">
    <% if (room.status !== 'depo') { %>
      <div class="d-flex gap-2 mb-3">
        <button class="btn btn-sm btn-outline-primary" id="showSelectPersonnelBtn">
          <i class="bi bi-list-check"></i> Listeden Seç
        </button>
        <button class="btn btn-sm btn-outline-success" data-bs-toggle="modal" data-bs-target="#addPersonnelAndAssignModal">
          <i class="bi bi-plus-lg"></i> Yeni Kayıt
        </button>
      </div>

      <!-- Personel Seçme Alanı (Gizli) -->
      <div id="selectPersonnelSection" class="card border-0 shadow-sm mb-4" style="display: none;">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
          <h6 class="mb-0"><i class="bi bi-people"></i> Odaya Atanacak Personeli Seçin</h6>
          <button type="button" class="btn-close btn-sm" id="hideSelectPersonnelBtn"></button>
        </div>
        <div class="card-body">
          <!-- Filtreler -->
          <div class="row g-2 mb-3">
            <div class="col-md-4">
              <input type="text" class="form-control form-control-sm" id="personnelSearchInput" placeholder="İsim veya telefon ara...">
            </div>
            <div class="col-md-3">
              <select class="form-select form-select-sm" id="personnelDepartmentFilter">
                <option value="">Tüm Departmanlar</option>
                <% departmentOptions.forEach(dep => { %>
                  <option value="<%= dep %>"><%= dep %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <!-- Personel Listesi -->
          <div id="personnelListContainer" class="table-responsive">
            <% if (availablePersonnel.length === 0) { %>
              <div class="text-center text-muted py-4">Atanabilir personel yok.</div>
            <% } else { %>
              <table class="table table-hover table-sm">
                <thead class="table-light">
                  <tr>
                    <th>Ad Soyad</th>
                    <th>Cinsiyet</th>
                    <th>Departman</th>
                    <th>İlk Kayıt</th>
                    <th>Durum</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% availablePersonnel.forEach(p => { %>
                    <tr class="personnel-list-item" 
                        data-name="<%= p.first_name.toLowerCase() %> <%= p.last_name.toLowerCase() %>" 
                        data-phone="<%= p.phone || '' %>" 
                        data-department="<%= p.department || '' %>">
                      <td><strong><%= p.first_name %> <%= p.last_name %></strong></td>
                      <td><%= p.gender === 'erkek' ? 'Erkek' : (p.gender === 'kadin' ? 'Kadın' : '-') %></td>
                      <td><%= p.department || '-' %></td>
                      <td><%= p.created_at ? new Date(p.created_at).toLocaleDateString('tr-TR') : '-' %></td>
                      <td>
                        <% if (p.status === 'cikis_yapti') { %>
                          <span class="badge bg-secondary">Çıkış Yapmış</span>
                        <% } else if (p.status === 'bosta') { %>
                          <span class="badge bg-warning text-dark">Boşta</span>
                        <% } else { %>
                          <span class="badge bg-success">Aktif</span>
                        <% } %>
                      </td>
                      <td>
                        <button type="button" class="btn btn-sm btn-outline-primary assign-btn" 
                                data-bs-toggle="modal" 
                                data-bs-target="#assignAndHandoverModal"
                                data-personnel-id="<%= p.id %>"
                                data-personnel-name="<%= p.first_name %> <%= p.last_name %>">
                          <i class="bi bi-arrow-right-circle"></i> Ata
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>

    <% if (occupants.length === 0) { %>
      <div class="text-center text-muted py-4">Bu odada personel yok</div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="table-light">
          <tr><th>Ad Soyad</th><th>Cinsiyet</th><th>Telefon</th><th>Departman</th><th>Giriş Tarihi</th><th></th></tr>
        </thead>
        <tbody>
          <% occupants.forEach(p => { %>
          <tr>
            <td><a href="/personel/<%= p.id %>"><%= p.first_name %> <%= p.last_name %></a></td>
            <td><%= p.gender === 'erkek' ? 'Erkek' : 'Kadın' %></td>
            <td><%= p.phone || '-' %></td>
            <td><%= p.department || '-' %></td>
            <td><%= p.check_in_date ? new Date(p.check_in_date).toLocaleDateString('tr-TR') : '-' %></td>
            <td><a href="/personel/<%= p.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <!-- Sorunlar Tab -->
  <div class="tab-pane fade" id="sorunlar">
    <button class="btn btn-sm btn-outline-danger mb-3" data-bs-toggle="modal" data-bs-target="#addIssueModal">
      <i class="bi bi-plus-lg"></i> Sorun Ekle
    </button>
    <div class="mb-3 p-3 border rounded bg-light">
      <h6 class="mb-2"><i class="bi bi-house-exclamation"></i> Oda Sorunları (Açık: <%= openRoomIssueCount || 0 %>)</h6>
      <% if (roomIssues.length === 0) { %>
        <div class="text-muted">Kayıtlı oda sorunu yok</div>
      <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr><th>Başlık</th><th>Açıklama</th><th>Durum</th><th>Açılış</th><th>Kapanış</th><th></th></tr>
          </thead>
          <tbody>
            <% roomIssues.forEach(i => { %>
            <tr>
              <td><strong><%= i.title %></strong></td>
              <td><%= i.description || '-' %></td>
              <td>
                <% if (i.status === 'acik') { %>
                  <span class="badge bg-danger">Açık</span>
                <% } else { %>
                  <span class="badge bg-success">Çözüldü</span>
                <% } %>
              </td>
              <td><small><%= i.created_at ? new Date(i.created_at).toLocaleDateString('tr-TR') : '-' %></small></td>
              <td><small><%= i.resolved_at ? new Date(i.resolved_at).toLocaleDateString('tr-TR') : '-' %></small></td>
              <td>
                <form method="POST" action="/odalar/<%= room.id %>/sorun/<%= i.id %>/guncelle" class="d-inline">
                  <select name="status" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                    <option value="acik" <%= i.status === 'acik' ? 'selected' : '' %>>Açık</option>
                    <option value="cozuldu" <%= i.status === 'cozuldu' ? 'selected' : '' %>>Çözüldü</option>
                  </select>
                </form>
                <form method="POST" action="/odalar/<%= room.id %>/sorun/<%= i.id %>/sil" class="d-inline" onsubmit="return confirm('Bu sorun kaydını silmek istiyor musunuz?')">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

    <div class="p-3 border rounded bg-light">
      <h6 class="mb-2"><i class="bi bi-box-seam"></i> Demirbaş Sorunları (Açık: <%= openInventoryIssueCount || 0 %>)</h6>
      <% if (inventoryIssues.length === 0) { %>
        <div class="text-muted">Kayıtlı demirbaş sorunu yok</div>
      <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr><th>Demirbaş</th><th>Etiket</th><th>Açıklama</th><th>Durum</th><th>Açılış</th><th>Kapanış</th><th></th></tr>
        </thead>
        <tbody>
          <% inventoryIssues.forEach(i => { %>
          <tr>
            <td><strong><%= i.inventory_item_name || i.title %></strong></td>
            <td>
              <% if (i.issue_tag === 'eksik') { %>
                <span class="badge bg-warning text-dark">Eksik</span>
              <% } else if (i.issue_tag === 'arizali') { %>
                <span class="badge bg-danger">Arızalı</span>
              <% } else if (i.issue_tag === 'kirik') { %>
                <span class="badge bg-danger">Kırık</span>
              <% } else if (i.issue_tag === 'calismiyor') { %>
                <span class="badge bg-danger">Çalışmıyor</span>
              <% } else if (i.issue_tag === 'kayip') { %>
                <span class="badge bg-dark">Kayıp</span>
              <% } else if (i.issue_tag === 'diger') { %>
                <span class="badge bg-secondary">Diğer</span>
              <% } else { %>
                <span class="badge bg-secondary">-</span>
              <% } %>
            </td>
            <td><%= i.description || '-' %></td>
            <td>
              <% if (i.status === 'acik') { %>
                <span class="badge bg-danger">Açık</span>
              <% } else { %>
                <span class="badge bg-success">Çözüldü</span>
              <% } %>
            </td>
            <td><small><%= i.created_at ? new Date(i.created_at).toLocaleDateString('tr-TR') : '-' %></small></td>
            <td><small><%= i.resolved_at ? new Date(i.resolved_at).toLocaleDateString('tr-TR') : '-' %></small></td>
            <td>
              <form method="POST" action="/odalar/<%= room.id %>/sorun/<%= i.id %>/guncelle" class="d-inline">
                <select name="status" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                  <option value="acik" <%= i.status === 'acik' ? 'selected' : '' %>>Açık</option>
                  <option value="cozuldu" <%= i.status === 'cozuldu' ? 'selected' : '' %>>Çözüldü</option>
                </select>
              </form>
              <form method="POST" action="/odalar/<%= room.id %>/sorun/<%= i.id %>/sil" class="d-inline" onsubmit="return confirm('Bu sorun kaydını silmek istiyor musunuz?')">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
    </div>
  </div>

  <!-- Demirbaş Tab -->
  <div class="tab-pane fade" id="envanter">
    <button class="btn btn-sm btn-outline-success mb-3" data-bs-toggle="modal" data-bs-target="#addInventoryModal">
      <i class="bi bi-plus-lg"></i> Demirbaş Ekle
    </button>

    <% if (inventory.length === 0) { %>
      <div class="text-center text-muted py-4">Bu odada kayıtlı demirbaş yok</div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover">
        <thead class="table-light">
          <tr><th>Eşya</th><th>Adet</th><th>Durum</th><th>Not</th><th></th></tr>
        </thead>
        <tbody>
          <% inventory.forEach(inv => { %>
          <tr>
            <td><%= inv.item_name %></td>
            <td>
              <% if ((inv.item_name || '').toLowerCase() === 'oda anahtarı') { %>
                <span id="key-count-<%= room.id %>"><%= inv.quantity %>/<%= requiredKeyCount %></span>
              <% } else { %>
                <%= inv.quantity %>
              <% } %>
            </td>
            <td>
              <% if (inv.condition === 'saglam' || inv.condition === 'iyi') { %>
                <span class="badge bg-success">Sağlam</span>
              <% } else if (inv.condition === 'eksik') { %>
                <span class="badge bg-warning text-dark">Eksik</span>
              <% } else if (inv.condition === 'arizali' || inv.condition === 'kotu') { %>
                <span class="badge bg-danger">Arızalı</span>
              <% } else if (inv.condition === 'kirik') { %>
                <span class="badge bg-danger">Kırık</span>
              <% } else if (inv.condition === 'calismiyor') { %>
                <span class="badge bg-danger">Çalışmıyor</span>
              <% } else if (inv.condition === 'kayip') { %>
                <span class="badge bg-dark">Kayıp</span>
              <% } else { %>
                <span class="badge bg-secondary">Diğer</span>
              <% } %>
            </td>
            <td><%= inv.notes || '-' %></td>
            <td>
              <button
                type="button"
                class="btn btn-sm btn-outline-primary"
                title="Düzenle"
                data-bs-toggle="modal"
                data-bs-target="#editInventoryModal"
                data-item-id="<%= inv.id %>"
                data-item-name="<%= inv.item_name %>"
                data-item-quantity="<%= inv.quantity %>"
                data-item-condition="<%= inv.condition %>"
                data-item-notes="<%= inv.notes || '' %>">
                <i class="bi bi-pencil"></i>
              </button>
              <button
                type="button"
                class="btn btn-sm btn-outline-warning report-item-issue-btn"
                title="Sorun Bildir"
                data-bs-toggle="modal"
                data-bs-target="#addInventoryIssueModal"
                data-item-id="<%= inv.id %>"
                data-item-name="<%= inv.item_name %>">
                <i class="bi bi-exclamation-triangle"></i>
              </button>
              <form method="POST" action="/odalar/<%= room.id %>/envanter/<%= inv.id %>/sil" class="d-inline" onsubmit="return confirm('Bu eşyayı silmek istediğinize emin misiniz?')">
                <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <!-- Geçmiş Tab -->
  <div class="tab-pane fade" id="gecmis">
    <% if (!roomHistory || roomHistory.length === 0) { %>
      <div class="text-center text-muted py-4">Bu oda için giriş/çıkış geçmişi bulunamadı</div>
    <% } else { %>
      <div class="row g-2 mb-3">
        <div class="col-md-4 col-lg-4">
          <input
            type="text"
            class="form-control form-control-sm"
            id="historySearchInput"
            placeholder="İsim, TC veya departman ara..."
          >
        </div>
        <div class="col-md-4 col-lg-4">
          <input
            type="text"
            class="form-control form-control-sm"
            id="historyEntryRange"
            placeholder="Giriş tarihi aralığı"
            autocomplete="off"
          >
        </div>
        <div class="col-md-4 col-lg-4">
          <input
            type="text"
            class="form-control form-control-sm"
            id="historyExitRange"
            placeholder="Çıkış tarihi aralığı"
            autocomplete="off"
          >
        </div>
      </div>
      <div class="table-responsive">
        <table class="table table-hover">
          <thead class="table-light">
            <tr>
              <th>İsim Soyisim</th>
              <th>Departman</th>
              <th>Giriş Tarihi</th>
              <th>Çıkış Tarihi</th>
              <th></th>
            </tr>
          </thead>
          <tbody id="historyTableBody">
            <% roomHistory.forEach(h => { %>
              <% const personName = `${h.first_name || '-'} ${h.last_name || ''}`.trim(); %>
              <% const entryText = h.entry_at ? new Date(h.entry_at).toLocaleString('tr-TR') : '-'; %>
              <% const exitText = h.exit_at ? new Date(h.exit_at).toLocaleString('tr-TR') : '-'; %>
              <% const entryDateValue = h.entry_at ? new Date(h.entry_at).toISOString().slice(0, 10) : ''; %>
              <% const exitDateValue = h.exit_at ? new Date(h.exit_at).toISOString().slice(0, 10) : ''; %>
              <% const filterText = `${personName} ${h.department || ''} ${entryText} ${exitText}`.toLowerCase(); %>
              <tr data-entry-date="<%= entryDateValue %>" data-exit-date="<%= exitDateValue %>">
                <td data-history-filter="<%= filterText %>"><strong><%= personName || '-' %></strong></td>
                <td><%= h.department || '-' %></td>
                <td><%= entryText %></td>
                <td><%= exitText %></td>
                <td>
                  <% if (h.personnel_id) { %>
                    <a href="/personel/<%= h.personnel_id %>" class="btn btn-sm btn-outline-primary" title="Personel Detayı">
                      <i class="bi bi-eye"></i>
                    </a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- Oda Düzenle Modal -->
<div class="modal fade" id="editRoomModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/odalar/<%= room.id %>/guncelle">
        <div class="modal-header">
          <h5 class="modal-title">Oda Düzenle</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Kapasite</label>
            <input type="number" class="form-control" name="capacity" value="<%= room.capacity %>" min="1" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Kat</label>
            <select class="form-select" name="floor">
              <option value="">Kat Seçin</option>
              <% floors.forEach(f => { %>
                <option value="<%= f %>" <%= room.floor === f ? 'selected' : '' %>><%= f %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" name="description" rows="2"><%= room.description || '' %></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label">Durum</label>
            <select class="form-select" name="status">
              <option value="bos" <%= room.status === 'bos' ? 'selected' : '' %>>Boş</option>
              <option value="dolu" <%= room.status === 'dolu' ? 'selected' : '' %>>Dolu</option>
