<!-- Yeni Personel Ekle ve Ata Modal -->
<div class="modal fade" id="addPersonnelAndAssignModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="POST" action="/personel/ekle-ve-ata" enctype="multipart/form-data">
        <input type="hidden" name="room_id" value="<%= room.id %>">
        <input type="hidden" name="allow_cleaning_override" id="addAllowCleaningOverrideInput" value="0">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-person-plus"></i> Odaya Yeni Personel Ekle</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <!-- Personel Bilgileri -->
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Ad *</label>
              <input type="text" class="form-control" name="first_name" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Soyad *</label>
              <input type="text" class="form-control" name="last_name" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Cinsiyet *</label>
              <select class="form-select" name="gender" required>
                <option value="erkek">Erkek</option>
                <option value="kadin">Kadın</option>
              </select>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Telefon</label>
              <input type="tel" class="form-control" name="phone">
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Departman</label>
              <select class="form-select" id="roomDepartmentSelect">
                <option value="">Departman seçin</option>
                <% departmentOptions.forEach(dep => { %>
                  <option value="<%= dep %>"><%= dep %></option>
                <% }) %>
                <option value="__manual__">El ile gir...</option>
              </select>
              <input type="text" class="form-control mt-2 d-none" id="roomDepartmentInput" name="department" placeholder="Departman yazın">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">TC Kimlik No *</label>
              <input type="text" class="form-control" name="tc_number" placeholder="11 haneli TC no" required maxlength="11" pattern="[0-9]{11}">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Fotoğraf</label>
            <button type="button" class="btn btn-outline-primary w-100" id="roomAddPhotoBtn">
              <i class="bi bi-camera"></i> Fotoğraf Ekle
            </button>

            <div id="roomPhotoOptions" class="mt-2" style="display:none;">
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary flex-fill" id="roomChooseCameraBtn">
                  <i class="bi bi-camera-video"></i> Çek
                </button>
                <button type="button" class="btn btn-outline-secondary flex-fill" id="roomChooseUploadBtn">
                  <i class="bi bi-upload"></i> Yükle
                </button>
              </div>

              <div class="mt-2" id="roomCameraInputWrap" style="display:none;">
                <div class="border rounded p-2">
                  <video id="roomCameraPreview" class="w-100 rounded" autoplay playsinline style="max-height: 260px; background:#000; transform: scaleX(-1);"></video>
                  <img id="roomCapturedPreview" class="w-100 rounded" alt="Çekilen fotoğraf" style="display:none; max-height: 260px; object-fit: contain;">
                  <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-primary flex-fill" id="roomTakePhotoBtn">
                      <i class="bi bi-camera"></i> Fotoğraf Çek
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="roomStopCameraBtn" disabled>
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </div>
                  <small class="text-muted d-block mt-2">İlk kullanımda kamera izni isteyebilir.</small>
                </div>
                <input type="hidden" name="captured_photo" id="roomCapturedPhotoFlag" value="0">
              </div>

              <div class="mt-2" id="roomUploadInputWrap" style="display:none;">
                <input type="file" class="form-control" id="roomUploadPhotoInput" name="photo" accept="image/jpeg,image/png,image/gif,image/*">
                <small class="text-muted">JPEG, PNG, GIF (Max 5MB)</small>
              </div>

              <small class="text-muted d-block mt-1">Max 5MB</small>
            </div>
          </div>
          <hr>
          <!-- Zimmet Bilgileri -->
          <h5 class="mb-3">Zimmet Bilgileri</h5>
          <div class="border rounded p-3">
            <h6 class="mb-3"><i class="bi bi-clipboard-check"></i> Demirbaş Teslim Kontrolü</h6>
            <div class="border rounded p-2 mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong>Zimmet Formu</strong>
                  <small class="text-muted d-block">İmzalandı mı?</small>
                </div>
                <div class="form-check m-0">
                  <input class="form-check-input" type="checkbox" id="formSignedCheck" name="form_signed">
                  <label class="form-check-label" for="formSignedCheck">Evet</label>
                </div>
              </div>
            </div>
            <% (handoverInventoryItems || []).forEach((itemName, idx) => { %>
              <div class="border rounded p-2 mb-2 handover-item" data-item-name="<%= itemName %>">
                <div class="mb-2">
                  <strong><%= itemName %></strong>
                  <div class="form-check mt-1 mb-3">
                    <input class="form-check-input handover-delivered" type="radio" name="delivery_<%= idx %>" id="delivered_yes_<%= idx %>" value="yes" checked>
                    <label class="form-check-label" for="delivered_yes_<%= idx %>">✓ Sağlam Teslim Edildi</label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input handover-delivered-no" type="radio" name="delivery_<%= idx %>" id="delivered_no_<%= idx %>" value="no">
                    <label class="form-check-label" for="delivered_no_<%= idx %>">✗ Teslim Edilmedi</label>
                  </div>
                </div>
                <div class="handover-problem" style="display:none; padding-top: 10px; border-top: 1px solid #dee2e6;">
                  <div class="mb-2">
                    <label class="form-label form-label-sm">Sorun Türü *</label>
                    <select class="form-select form-select-sm handover-tag">
                      <option value="">Seçin</option>
                      <option value="eksik">Eksik</option>
                      <option value="arizali">Arızalı</option>
                      <option value="kirik">Kırık</option>
                      <option value="calismiyor">Çalışmıyor</option>
                      <option value="kayip">Kayıp</option>
                      <option value="diger">Diğer</option>
                    </select>
                  </div>
                  <div>
                    <label class="form-label form-label-sm">Neden Teslim Edilmedi? *</label>
                    <textarea class="form-control form-control-sm handover-description" rows="3" placeholder="Sorunu detaylı açıklayın..."></textarea>
                  </div>
                </div>
              </div>
            <% }) %>
            <div class="border rounded p-2 mt-3">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong>Oda Anahtarı</strong>
                  <small class="text-muted d-block">Olması gereken: <%= requiredKeyCount %> | Elde: <%= keyCountInHand %></small>
                </div>
                <div class="form-check m-0">
                  <input class="form-check-input" type="checkbox" id="keyDeliveredCheck" name="key_delivered" value="1">
                  <label class="form-check-label" for="keyDeliveredCheck">Teslim Edildi</label>
                </div>
              </div>
            </div>
          </div>
          <input type="hidden" name="handover_payload" id="handoverPayloadInput">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Kaydet ve Ata</button>
        </div>
      </form>
    </div>
  </div>
</div>

