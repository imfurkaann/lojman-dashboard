        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-danger">Sorun Ekle</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../footer') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const roomTabStorageKey = `room-detail-active-tab-<%= room.id %>`;

    function getCurrentActiveTabHash() {
      const activeTab = document.querySelector('.nav-tabs .nav-link.active');
      if (!activeTab) return '#personeller';
      const href = activeTab.getAttribute('href') || '#personeller';
      return href.startsWith('#') ? href : '#personeller';
    }

    function activateTabByHash(hash) {
      if (!hash || !hash.startsWith('#')) return false;
      const trigger = document.querySelector(`.nav-tabs .nav-link[href="${hash}"]`);
      if (!trigger) return false;
      const tab = bootstrap.Tab.getOrCreateInstance(trigger);
      tab.show();
      return true;
    }

    const hashFromUrl = window.location.hash;
    const storedTabHash = sessionStorage.getItem(roomTabStorageKey);
    if (hashFromUrl) {
      activateTabByHash(hashFromUrl);
      sessionStorage.setItem(roomTabStorageKey, hashFromUrl);
    } else if (storedTabHash) {
      activateTabByHash(storedTabHash);
    }

    document.querySelectorAll('.nav-tabs .nav-link').forEach(tabEl => {
      tabEl.addEventListener('shown.bs.tab', event => {
        const href = event.target.getAttribute('href');
        if (href && href.startsWith('#')) {
          sessionStorage.setItem(roomTabStorageKey, href);
        }
      });
    });

    document.querySelectorAll('form').forEach(formEl => {
      formEl.addEventListener('submit', () => {
        sessionStorage.setItem(roomTabStorageKey, getCurrentActiveTabHash());
      });
    });

    const showSelectPersonnelBtn = document.getElementById('showSelectPersonnelBtn');
    const selectPersonnelSection = document.getElementById('selectPersonnelSection');
    const hideSelectPersonnelBtn = document.getElementById('hideSelectPersonnelBtn');
    const personnelSearchInput = document.getElementById('personnelSearchInput');
    const personnelDepartmentFilter = document.getElementById('personnelDepartmentFilter');
    const personnelListContainer = document.getElementById('personnelListContainer');
    const personnelItems = Array.from(personnelListContainer.querySelectorAll('tbody tr'));
    const currentRoomId = <%- JSON.stringify(Number(room.id)) %>;
    const inventoryIssuesData = <%- JSON.stringify(inventoryIssues || []) %>;
    const roomDepartmentSelect = document.getElementById('roomDepartmentSelect');
    const roomDepartmentInput = document.getElementById('roomDepartmentInput');

    function syncRoomDepartmentField() {
      if (!roomDepartmentSelect || !roomDepartmentInput) return;
      const selected = roomDepartmentSelect.value;
      if (selected === '__manual__') {
        roomDepartmentInput.classList.remove('d-none');
        roomDepartmentInput.value = '';
        roomDepartmentInput.focus();
        return;
      }

      roomDepartmentInput.classList.add('d-none');
      roomDepartmentInput.value = selected || '';
    }

    if (roomDepartmentSelect && roomDepartmentInput) {
      roomDepartmentSelect.addEventListener('change', syncRoomDepartmentField);
      syncRoomDepartmentField();
    }

    const historySearchInput = document.getElementById('historySearchInput');
    const historyEntryRange = document.getElementById('historyEntryRange');
    const historyExitRange = document.getElementById('historyExitRange');
    const historyTableBody = document.getElementById('historyTableBody');
    if (historySearchInput && historyTableBody) {
      const historyRows = Array.from(historyTableBody.querySelectorAll('tr'));

      let entryRangeFrom = '';
      let entryRangeTo = '';
      let exitRangeFrom = '';
      let exitRangeTo = '';

      function setupHistoryRangePicker(inputEl, onChange) {
        if (!inputEl || typeof flatpickr === 'undefined') return null;

        return flatpickr(inputEl, {
          mode: 'range',
          dateFormat: 'Y-m-d',
          locale: (flatpickr && flatpickr.l10ns && flatpickr.l10ns.tr) ? flatpickr.l10ns.tr : 'tr',
          onChange: (selectedDates) => {
            const from = selectedDates[0] ? flatpickr.formatDate(selectedDates[0], 'Y-m-d') : '';
            const to = selectedDates[1] ? flatpickr.formatDate(selectedDates[1], 'Y-m-d') : '';
            onChange(from, to || from);
          }
        });
      }

      function isDateInRange(value, from, to) {
        if (!from && !to) return true;
        if (!value) return false;
        if (from && value < from) return false;
        if (to && value > to) return false;
        return true;
      }

      function filterHistoryRows() {
        const query = historySearchInput.value.trim().toLowerCase();

        historyRows.forEach(row => {
          const filterCell = row.querySelector('[data-history-filter]');
          const text = filterCell ? (filterCell.getAttribute('data-history-filter') || '') : '';
          const entryDate = row.getAttribute('data-entry-date') || '';
          const exitDate = row.getAttribute('data-exit-date') || '';

          const matchesSearch = !query || text.includes(query);
          const matchesEntryRange = isDateInRange(entryDate, entryRangeFrom, entryRangeTo);
          const matchesExitRange = isDateInRange(exitDate, exitRangeFrom, exitRangeTo);

          row.style.display = matchesSearch && matchesEntryRange && matchesExitRange ? '' : 'none';
        });
      }

      historySearchInput.addEventListener('input', filterHistoryRows);

      setupHistoryRangePicker(historyEntryRange, (from, to) => {
        entryRangeFrom = from;
        entryRangeTo = to;
        filterHistoryRows();
      });

      setupHistoryRangePicker(historyExitRange, (from, to) => {
        exitRangeFrom = from;
        exitRangeTo = to;
        filterHistoryRows();
      });
    }
    const validIssueTags = ['eksik', 'arizali', 'kirik', 'calismiyor', 'kayip', 'diger'];
    const openInventoryIssueMap = {};

    (inventoryIssuesData || []).forEach(issue => {
      if (!issue || issue.status === 'cozuldu') return;
      const itemKey = (issue.inventory_item_name || '').trim().toLowerCase();
      const tag = (issue.issue_tag || '').trim().toLowerCase();
      if (!itemKey || !validIssueTags.includes(tag)) return;
      if (openInventoryIssueMap[itemKey]) return;

      openInventoryIssueMap[itemKey] = {
        tag,
        description: issue.description || ''
      };
    });

    function applyOpenIssueDefaults(modalRoot, radioPrefix) {
      if (!modalRoot) return;

      modalRoot.querySelectorAll('.handover-item').forEach((itemEl, idx) => {
        const itemKey = (itemEl.dataset.itemName || '').trim().toLowerCase();
        const issue = openInventoryIssueMap[itemKey];

        const yesRadio = itemEl.querySelector(`input[name="${radioPrefix}${idx}"][value="yes"]`);
        const noRadio = itemEl.querySelector(`input[name="${radioPrefix}${idx}"][value="no"]`);
        const problemDiv = itemEl.querySelector('.handover-problem');
        const tagSelect = itemEl.querySelector('.handover-tag');
        const descriptionInput = itemEl.querySelector('.handover-description');

        if (!yesRadio || !noRadio || !problemDiv) return;

        if (issue) {
          noRadio.checked = true;
          if (tagSelect) tagSelect.value = issue.tag;
          if (descriptionInput) descriptionInput.value = issue.description;
          problemDiv.style.display = 'block';
        } else {
          yesRadio.checked = true;
          if (tagSelect) tagSelect.value = '';
          if (descriptionInput) descriptionInput.value = '';
          problemDiv.style.display = 'none';
        }
      });
    }

    async function resolveOpenIssueForItem(itemName) {
      const response = await fetch(`/odalar/${currentRoomId}/demirbas-sorun-coz`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ item_name: itemName })
      });

      const payload = await response.json().catch(() => ({}));
      if (!response.ok || !payload.ok) {
        throw new Error(payload.error || 'Sorun çözümlenirken hata oluştu.');
      }
      return payload;
    }

    async function handleHealthyOverrideChange(e, radioPrefix) {
      if (!e.target.classList.contains('handover-delivered')) return;
      if (!(e.target.value === 'yes' && e.target.checked)) return;

      const itemEl = e.target.closest('.handover-item');
      if (!itemEl) return;

      const itemName = (itemEl.dataset.itemName || '').trim();
      const itemKey = itemName.toLowerCase();
      const currentIssue = openInventoryIssueMap[itemKey];
      if (!currentIssue) return;

      const confirmed = window.confirm('Bu demirbaş için açık sorun kaydı var. Sağlam teslim edildi olarak işaretlerseniz ilgili sorun çözüldü kabul edilecektir. Onaylıyor musunuz?');
      const noRadio = itemEl.querySelector(`input[name^="${radioPrefix}"][value="no"]`);
      const problemDiv = itemEl.querySelector('.handover-problem');

      if (!confirmed) {
        if (noRadio) noRadio.checked = true;
        if (problemDiv) problemDiv.style.display = 'block';
        return;
      }

      try {
        await resolveOpenIssueForItem(itemName);
        delete openInventoryIssueMap[itemKey];
        if (problemDiv) problemDiv.style.display = 'none';
        const tagSelect = itemEl.querySelector('.handover-tag');
        const descriptionInput = itemEl.querySelector('.handover-description');
        if (tagSelect) tagSelect.value = '';
        if (descriptionInput) descriptionInput.value = '';
      } catch (error) {
        alert(error.message || 'Sorun kaydı çözümlenirken hata oluştu.');
        if (noRadio) noRadio.checked = true;
        if (problemDiv) problemDiv.style.display = 'block';
      }
    }

    // "Listeden Seç" butonuna tıklayınca personelleri göster/gizle
    showSelectPersonnelBtn.addEventListener('click', () => {
        if (selectPersonnelSection.style.display === 'none') {
            selectPersonnelSection.style.display = 'block';
            showSelectPersonnelBtn.textContent = 'Listeyi Gizle';
            showSelectPersonnelBtn.classList.remove('btn-outline-primary');
            showSelectPersonnelBtn.classList.add('btn-outline-secondary');
        } else {
            selectPersonnelSection.style.display = 'none';
            showSelectPersonnelBtn.textContent = 'Listeden Seç';
            showSelectPersonnelBtn.classList.remove('btn-outline-secondary');
            showSelectPersonnelBtn.classList.add('btn-outline-primary');
        }
    });
    
    hideSelectPersonnelBtn.addEventListener('click', () => {
        selectPersonnelSection.style.display = 'none';
        showSelectPersonnelBtn.textContent = 'Listeden Seç';
        showSelectPersonnelBtn.classList.remove('btn-outline-secondary');
        showSelectPersonnelBtn.classList.add('btn-outline-primary');
    });


    // Arama ve filtreleme fonksiyonu
    function filterPersonnel() {
        const searchTerm = personnelSearchInput.value.toLowerCase();
        const selectedDepartment = personnelDepartmentFilter.value;

        personnelItems.forEach(item => {
            const name = item.dataset.name.toLowerCase();
            const department = item.dataset.department;
            
            const matchesSearch = name.includes(searchTerm);
            const matchesDepartment = selectedDepartment === '' || department === selectedDepartment;

            if (matchesSearch && matchesDepartment) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    }

    personnelSearchInput.addEventListener('input', filterPersonnel);
    personnelDepartmentFilter.addEventListener('change', filterPersonnel);

    const assignAndHandoverModal = document.getElementById('assignAndHandoverModal');
    if (assignAndHandoverModal) {
      const form = assignAndHandoverModal.querySelector('form');
      const personnelIdInput = assignAndHandoverModal.querySelector('#assignPersonnelId');
      const personnelNameSpan = assignAndHandoverModal.querySelector('#assignPersonnelName');
      const payloadInput = assignAndHandoverModal.querySelector('#assignHandoverPayloadInput');
      const assignAllowCleaningOverrideInput = assignAndHandoverModal.querySelector('#assignAllowCleaningOverrideInput');

      assignAndHandoverModal.addEventListener('show.bs.modal', event => {
        const button = event.relatedTarget;
        const personnelId = button.dataset.personnelId;
        const personnelName = button.dataset.personnelName;

        personnelIdInput.value = personnelId;
        personnelNameSpan.textContent = personnelName;
        form.reset(); // Formu her açılışta sıfırla

        applyOpenIssueDefaults(assignAndHandoverModal, 'assign_delivery_');
      });

      form.addEventListener('submit', function(e) {
        if (assignAllowCleaningOverrideInput) assignAllowCleaningOverrideInput.value = '0';
        if ('<%= roomAvailability %>' === 'kullanilamaz') {
          e.preventDefault();
          alert('Bu oda kullanılamaz durumda olduğu için personel atanamaz.');
          return;
        }
        if ('<%= roomAvailability %>' === 'temizlenmeli') {
          const confirmed = window.confirm('Bu oda temizlenmesi gerekiyor durumda. Yine de personele atamak istiyor musunuz?');
          if (!confirmed) {
            e.preventDefault();
            return;
          }
          if (assignAllowCleaningOverrideInput) assignAllowCleaningOverrideInput.value = '1';
        }

        const handoverData = {
          form_signed: form.querySelector('#assignFormSignedCheck').checked,
          key_delivered: form.querySelector('#assignKeyDeliveredCheck').checked,
          items: []
        };

        form.querySelectorAll('.handover-item').forEach((item, idx) => {
          const itemName = item.dataset.itemName;
          const delivered = item.querySelector(`input[name="assign_delivery_${idx}"]:checked`).value;
          const problemDiv = item.querySelector('.handover-problem');
          
          if (delivered === 'no') {
            handoverData.items.push({
              name: itemName,
              delivered: false,
              tag: problemDiv.querySelector('.handover-tag').value,
              description: problemDiv.querySelector('.handover-description').value
            });
          } else {
            handoverData.items.push({
              name: itemName,
              delivered: true
            });
          }
        });
        payloadInput.value = JSON.stringify(handoverData);
      });

      assignAndHandoverModal.addEventListener('change', e => {
        if (e.target.classList.contains('handover-delivered-no')) {
          const problemDiv = e.target.closest('.handover-item').querySelector('.handover-problem');
          problemDiv.style.display = 'block';
        } else if (e.target.classList.contains('handover-delivered')) {
          const problemDiv = e.target.closest('.handover-item').querySelector('.handover-problem');
          problemDiv.style.display = 'none';
        }

        handleHealthyOverrideChange(e, 'assign_delivery_');
      });
    }

    const addPersonnelAndAssignModal = document.getElementById('addPersonnelAndAssignModal');
    if (addPersonnelAndAssignModal) {
      const addForm = addPersonnelAndAssignModal.querySelector('form');
      const addPayloadInput = addPersonnelAndAssignModal.querySelector('#handoverPayloadInput');
      const roomAddPhotoBtn = addPersonnelAndAssignModal.querySelector('#roomAddPhotoBtn');
      const roomPhotoOptions = addPersonnelAndAssignModal.querySelector('#roomPhotoOptions');
      const roomChooseCameraBtn = addPersonnelAndAssignModal.querySelector('#roomChooseCameraBtn');
      const roomChooseUploadBtn = addPersonnelAndAssignModal.querySelector('#roomChooseUploadBtn');
      const roomCameraInputWrap = addPersonnelAndAssignModal.querySelector('#roomCameraInputWrap');
      const roomUploadInputWrap = addPersonnelAndAssignModal.querySelector('#roomUploadInputWrap');
      const roomUploadPhotoInput = addPersonnelAndAssignModal.querySelector('#roomUploadPhotoInput');
      const roomCameraPreview = addPersonnelAndAssignModal.querySelector('#roomCameraPreview');
      const roomCapturedPreview = addPersonnelAndAssignModal.querySelector('#roomCapturedPreview');
      const roomTakePhotoBtn = addPersonnelAndAssignModal.querySelector('#roomTakePhotoBtn');
      const roomStopCameraBtn = addPersonnelAndAssignModal.querySelector('#roomStopCameraBtn');
      const roomCapturedPhotoFlag = addPersonnelAndAssignModal.querySelector('#roomCapturedPhotoFlag');
      const addAllowCleaningOverrideInput = addPersonnelAndAssignModal.querySelector('#addAllowCleaningOverrideInput');

      let roomCameraStream = null;
      let roomCapturedBlob = null;

      function setRoomTakeButtonLabel() {
        if (!roomTakePhotoBtn) return;
        roomTakePhotoBtn.innerHTML = roomCameraStream
          ? '<i class="bi bi-camera"></i> Çek'
          : '<i class="bi bi-camera"></i> Fotoğraf Çek';
      }

      function clearRoomCapturedPreview() {
        roomCapturedBlob = null;
        if (roomCapturedPhotoFlag) roomCapturedPhotoFlag.value = '0';
        if (roomCapturedPreview) {
          roomCapturedPreview.style.display = 'none';
          roomCapturedPreview.src = '';
        }
        if (roomCameraPreview) roomCameraPreview.style.display = 'block';
      }

      function stopRoomCamera() {
        if (roomCameraStream) {
          roomCameraStream.getTracks().forEach(track => track.stop());
          roomCameraStream = null;
        }
        if (roomCameraPreview) roomCameraPreview.srcObject = null;
        if (roomStopCameraBtn) roomStopCameraBtn.disabled = false;
        setRoomTakeButtonLabel();
      }

      async function startRoomCamera() {
        if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
          alert('Bu tarayıcı kamera erişimini desteklemiyor.');
          return;
        }
        try {
          const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
          roomCameraStream = stream;
          if (roomCameraPreview) {
            roomCameraPreview.style.display = 'block';
            roomCameraPreview.srcObject = stream;
            await roomCameraPreview.play();
          }
          if (roomCapturedPreview) {
            roomCapturedPreview.style.display = 'none';
            roomCapturedPreview.src = '';
          }
          if (roomStopCameraBtn) roomStopCameraBtn.disabled = false;
          setRoomTakeButtonLabel();
        } catch (e) {
          console.error('Kamera açılamadı:', e);
          alert('Kamera açılamadı. Tarayıcı izinlerini kontrol edin.');
        }
      }

      function showRoomCameraInput() {
        if (roomUploadPhotoInput) roomUploadPhotoInput.value = '';
        if (roomCameraInputWrap) roomCameraInputWrap.style.display = 'block';
        if (roomUploadInputWrap) roomUploadInputWrap.style.display = 'none';
        if (roomCapturedPreview) {
          roomCapturedPreview.style.display = 'none';
          roomCapturedPreview.src = '';
        }
        if (roomCameraPreview) roomCameraPreview.style.display = 'block';
      }

      function showRoomUploadInput() {
        stopRoomCamera();
        if (roomUploadInputWrap) roomUploadInputWrap.style.display = 'block';
        if (roomCameraInputWrap) roomCameraInputWrap.style.display = 'none';
      }

      function takeRoomSnapshot() {
        if (!roomCameraPreview) return;
        const canvas = document.createElement('canvas');
        const width = roomCameraPreview.videoWidth || 640;
        const height = roomCameraPreview.videoHeight || 480;
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        ctx.drawImage(roomCameraPreview, 0, 0, width, height);
        canvas.toBlob((blob) => {
          if (!blob) return;
          roomCapturedBlob = blob;
          if (roomCapturedPhotoFlag) roomCapturedPhotoFlag.value = '1';
          if (roomCapturedPreview) {
            roomCapturedPreview.src = URL.createObjectURL(blob);
            roomCapturedPreview.style.display = 'block';
            roomCapturedPreview.style.transform = 'scaleX(-1)';
          }
          if (roomCameraPreview) roomCameraPreview.style.display = 'none';
          stopRoomCamera();
        }, 'image/jpeg', 0.9);
      }

      if (roomAddPhotoBtn && roomPhotoOptions) {
        roomAddPhotoBtn.addEventListener('click', () => {
          roomPhotoOptions.style.display = roomPhotoOptions.style.display === 'none' ? 'block' : 'none';
          if (roomPhotoOptions.style.display === 'none') {
            if (roomCameraInputWrap) roomCameraInputWrap.style.display = 'none';
            if (roomUploadInputWrap) roomUploadInputWrap.style.display = 'none';
            if (roomUploadPhotoInput) roomUploadPhotoInput.value = '';
            clearRoomCapturedPreview();
            stopRoomCamera();
          }
        });
      }

      if (roomChooseUploadBtn) {
        roomChooseUploadBtn.addEventListener('click', showRoomUploadInput);
      }

      if (roomChooseCameraBtn) {
        roomChooseCameraBtn.addEventListener('click', async () => {
          showRoomCameraInput();
          await startRoomCamera();
        });
      }

      if (roomStopCameraBtn) {
        roomStopCameraBtn.disabled = false;
        roomStopCameraBtn.addEventListener('click', async () => {
          stopRoomCamera();
          clearRoomCapturedPreview();
          await startRoomCamera();
        });
      }

      if (roomTakePhotoBtn) {
        roomTakePhotoBtn.addEventListener('click', () => {
          if (roomCapturedBlob || (roomCapturedPreview && roomCapturedPreview.style.display !== 'none')) {
            clearRoomCapturedPreview();
          }
          if (!roomCameraStream) {
            alert('Önce "Çek" butonuyla canlı önizlemeyi başlatın.');
            return;
          }
          takeRoomSnapshot();
        });
      }

      addPersonnelAndAssignModal.addEventListener('hidden.bs.modal', () => {
        stopRoomCamera();
        clearRoomCapturedPreview();
        if (roomPhotoOptions) roomPhotoOptions.style.display = 'none';
        if (roomCameraInputWrap) roomCameraInputWrap.style.display = 'none';
        if (roomUploadInputWrap) roomUploadInputWrap.style.display = 'none';
        if (roomUploadPhotoInput) roomUploadPhotoInput.value = '';
        if (addPayloadInput) addPayloadInput.value = '';
      });

      addPersonnelAndAssignModal.addEventListener('show.bs.modal', () => {
        addForm.reset();
        applyOpenIssueDefaults(addPersonnelAndAssignModal, 'delivery_');
      });

      addForm.addEventListener('change', e => {
        if (e.target.classList.contains('handover-delivered-no')) {
          const problemDiv = e.target.closest('.handover-item').querySelector('.handover-problem');
          problemDiv.style.display = 'block';
        } else if (e.target.classList.contains('handover-delivered')) {
          const problemDiv = e.target.closest('.handover-item').querySelector('.handover-problem');
          problemDiv.style.display = 'none';
        }

        handleHealthyOverrideChange(e, 'delivery_');
      });

      addForm.addEventListener('submit', function(event) {
        if (addAllowCleaningOverrideInput) addAllowCleaningOverrideInput.value = '0';
        if ('<%= roomAvailability %>' === 'kullanilamaz') {
          event.preventDefault();
          alert('Bu oda kullanılamaz durumda olduğu için personel atanamaz.');
          return;
        }
        if ('<%= roomAvailability %>' === 'temizlenmeli') {
          const confirmed = window.confirm('Bu oda temizlenmesi gerekiyor durumda. Yine de personele atamak istiyor musunuz?');
          if (!confirmed) {
            event.preventDefault();
            return;
          }
          if (addAllowCleaningOverrideInput) addAllowCleaningOverrideInput.value = '1';
        }

        const handoverData = {
          form_signed: !!addForm.querySelector('#formSignedCheck')?.checked,
          key_delivered: !!addForm.querySelector('#keyDeliveredCheck')?.checked,
          items: []
        };

        let invalid = false;
        addForm.querySelectorAll('.handover-item').forEach((item, idx) => {
          const itemName = item.dataset.itemName;
          const deliveredInput = item.querySelector(`input[name="delivery_${idx}"]:checked`);
          const delivered = deliveredInput ? deliveredInput.value === 'yes' : true;
          const problemDiv = item.querySelector('.handover-problem');
          const tag = (problemDiv.querySelector('.handover-tag')?.value || '').trim();
          const description = (problemDiv.querySelector('.handover-description')?.value || '').trim();

          if (!delivered && !tag) {
            invalid = true;
          }

          handoverData.items.push({
            name: itemName,
            delivered,
            tag,
            description
          });
        });

        if (invalid) {
          event.preventDefault();
          alert('Teslim edilmeyen her demirbaş için sorun türü seçilmelidir.');
          return;
        }

        if (addPayloadInput) {
          addPayloadInput.value = JSON.stringify(handoverData);
        }

        if (roomCapturedBlob && roomUploadPhotoInput) {
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(new File([roomCapturedBlob], `personel_${Date.now()}.jpg`, { type: 'image/jpeg' }));
          roomUploadPhotoInput.files = dataTransfer.files;
        }
      });
    }

    const editInventoryModal = document.getElementById('editInventoryModal');
    if (editInventoryModal) {
      editInventoryModal.addEventListener('show.bs.modal', (event) => {
        const trigger = event.relatedTarget;
        if (!trigger) return;

        const itemId = trigger.getAttribute('data-item-id');
        const itemName = trigger.getAttribute('data-item-name') || '';
        const itemQuantity = trigger.getAttribute('data-item-quantity') || '1';
        const rawItemCondition = trigger.getAttribute('data-item-condition') || 'saglam';
        const legacyConditionMap = {
          iyi: 'saglam',
          orta: 'diger',
          kotu: 'arizali'
        };
        const itemCondition = legacyConditionMap[rawItemCondition] || rawItemCondition;
        const itemNotes = trigger.getAttribute('data-item-notes') || '';

        const form = document.getElementById('editInventoryForm');
        const nameInput = document.getElementById('editInventoryItemName');
        const quantityInput = document.getElementById('editInventoryQuantity');
        const conditionInput = document.getElementById('editInventoryCondition');
        const notesInput = document.getElementById('editInventoryNotes');

        if (form) form.action = `/odalar/<%= room.id %>/envanter/${itemId}/guncelle`;
        if (nameInput) nameInput.value = itemName;
        if (quantityInput) quantityInput.value = itemQuantity;
        if (conditionInput) conditionInput.value = itemCondition;
        if (notesInput) notesInput.value = itemNotes;
      });
    }

    const addInventoryIssueModal = document.getElementById('addInventoryIssueModal');
    if (addInventoryIssueModal) {
      let lastIssueItemName = '';
      let lastIssueItemId = '';
      const issueItemNameDisplay = document.getElementById('issueInventoryItemNameDisplay');
      const issueItemIdInput = document.getElementById('issueInventoryItemIdInput');
      const issueItemNameInput = document.getElementById('issueInventoryItemNameInput');
      const issueTagSelect = document.getElementById('issueTagSelect');
      const issueDescriptionInput = document.getElementById('issueDescriptionInput');
      const issueForm = addInventoryIssueModal.querySelector('form');

      const issueButtons = document.querySelectorAll('.report-item-issue-btn');
      issueButtons.forEach(btn => {
        btn.addEventListener('click', () => {
          lastIssueItemId = btn.getAttribute('data-item-id') || '';
          lastIssueItemName = btn.getAttribute('data-item-name') || '';
        });
      });

      addInventoryIssueModal.addEventListener('show.bs.modal', (event) => {
        const trigger = event.relatedTarget;
        const selectedItemName = trigger ? trigger.getAttribute('data-item-name') : null;
        const selectedItemId = trigger ? trigger.getAttribute('data-item-id') : null;

        const finalItemName = (selectedItemName || lastIssueItemName || '').trim();
        const finalItemId = (selectedItemId || lastIssueItemId || '').trim();

        if (issueItemNameDisplay) issueItemNameDisplay.value = finalItemName;
        if (issueItemNameInput) issueItemNameInput.value = finalItemName;
        if (issueItemIdInput) issueItemIdInput.value = finalItemId;
        if (issueTagSelect) issueTagSelect.value = '';
        if (issueDescriptionInput) issueDescriptionInput.value = '';
      });

      if (issueForm) {
        issueForm.addEventListener('submit', (event) => {
          if (issueItemNameInput && !issueItemNameInput.value.trim() && lastIssueItemName) {
            issueItemNameInput.value = lastIssueItemName;
          }
          if (issueItemIdInput && !issueItemIdInput.value.trim() && lastIssueItemId) {
            issueItemIdInput.value = lastIssueItemId;
          }
          if (!issueItemNameInput || !issueItemNameInput.value.trim()) {
            event.preventDefault();
            alert('Lütfen sorunu ilgili demirbaş satırındaki "Sorun Bildir" butonundan açın.');
          }
        });
      }
    }

});
</script>
</body>
</html>
