<%- include('../layout', { title: 'Odalar' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="bi bi-door-open"></i> Oda Yönetimi</h4>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addRoomModal">
    <i class="bi bi-plus-lg"></i> Yeni Oda Ekle
  </button>
</div>

<style>
  .room-card {
    border: 1px solid #e7edf4 !important;
    background: linear-gradient(180deg, #ffffff 0%, #f8fbff 100%);
  }

  .room-card-container {
    cursor: pointer;
    display: block;
    text-decoration: none !important;
  }

  .room-card .card-body {
    padding: 12px 12px;
  }

  .room-layout {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) auto minmax(120px, 1fr);
    gap: 12px;
    align-items: center;
  }

  .room-number-box {
    min-width: 88px;
    height: 88px;
    border-radius: 14px;
    border: 1px solid #d6e2ee;
    background: #eef4fb;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1f2d3d;
    line-height: 1;
    padding: 0 10px;
  }

  .room-occupant-column {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-height: 70px;
    justify-content: center;
  }

  .room-occupant-card {
    border: 1px solid #dfe8f1;
    border-radius: 10px;
    background: #ffffff;
    padding: 7px 9px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .room-occupant-card:hover {
    border-color: #b8d0e6;
    background: #f9fbfe;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
  }

  .room-occupant-name {
    font-size: 0.96rem;
    font-weight: 700;
    color: #1e2a36;
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .room-occupant-meta {
    font-size: 0.8rem;
    color: #536476;
    line-height: 1.2;
    margin-top: 2px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .room-department-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 600;
    background: #ffffff;
    color: #4f5e6d;
    border: 1px solid #cfd8e2;
  }

  .room-gender-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.74rem;
    font-weight: 600;
    border: 1px solid transparent;
  }

  .gender-erkek {
    background: #dbe8ff;
    color: #194a97;
    border-color: #bcd2f8;
  }

  .gender-kadin {
    background: #ffe0ea;
    color: #9b2f57;
    border-color: #f2bfd2;
  }

  .gender-diger {
    background: #e7edf3;
    color: #3f4d5c;
    border-color: #cfd8e2;
  }

  .room-occupant-empty {
    border: 1px dashed #d7e3ef;
    border-radius: 10px;
    background: #f4f8fc;
    padding: 8px;
    min-height: 50px;
  }

  .room-third-row {
    margin-top: 4px;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .room-layout {
      grid-template-columns: 1fr;
      justify-items: stretch;
    }

    .room-number-box {
      width: 100%;
      height: 64px;
      font-size: 1.1rem;
    }

    .room-occupant-column {
      min-height: 0;
    }
  }
</style>

<!-- Filtre -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-2">
    <form method="GET" class="row g-2 align-items-center" id="roomsFilterForm">
      <div class="col-md-3">
        <input type="text" class="form-control form-control-sm" id="roomsSearchInput" name="search" placeholder="Oda numarası ara..." value="<%= search %>">
      </div>
      <div class="col-md-2">
        <select class="form-select form-select-sm" name="floor" onchange="this.form.submit()">
          <option value="">Tüm Katlar</option>
          <% floors.forEach(f => { %>
            <option value="<%= f %>" <%= floorFilter === f ? 'selected' : '' %>><%= f %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
          <option value="">Tüm Durumlar</option>
          <option value="bos" <%= statusFilter === 'bos' ? 'selected' : '' %>>Boş</option>
          <option value="dolu" <%= statusFilter === 'dolu' ? 'selected' : '' %>>Dolu</option>
          <option value="kismi_dolu" <%= statusFilter === 'kismi_dolu' ? 'selected' : '' %>>Kısmi Dolu</option>
          <option value="bakimda" <%= statusFilter === 'bakimda' ? 'selected' : '' %>>Bakımda</option>
          <option value="depo" <%= statusFilter === 'depo' ? 'selected' : '' %>>Depo</option>
        </select>
      </div>
      <% if (search || statusFilter || floorFilter) { %>
      <div class="col-md-2">
        <a href="/odalar" class="btn btn-sm btn-outline-secondary w-100">Temizle</a>
      </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Oda Listesi -->
<% if (rooms.length === 0) { %>
  <div class="text-center text-muted py-5">
    <i class="bi bi-inbox fs-1"></i>
    <p class="mt-2">Henüz oda eklenmemiş</p>
  </div>
<% } else { %>
  <%
    // Odaları kata göre grupla
    const grouped = {};
    rooms.forEach(room => {
      const key = room.floor || 'Belirtilmemiş';
      if (!grouped[key]) grouped[key] = [];
      grouped[key].push(room);
    });
    // floors sırasına göre sırala
    const floorOrder = floors.concat(['Belirtilmemiş']);
    const sortedKeys = Object.keys(grouped).sort((a, b) => floorOrder.indexOf(a) - floorOrder.indexOf(b));
  %>
  <% sortedKeys.forEach(floor => { %>
    <h5 class="mt-3 mb-2 text-muted"><i class="bi bi-layers"></i> <%= floor %> <span class="badge bg-light text-dark"><%= grouped[floor].length %></span></h5>
    <div class="row g-3 mb-3">
      <% grouped[floor].forEach(room => { %>
      <% const occupants = (roomOccupantsMap && roomOccupantsMap[room.id]) ? roomOccupantsMap[room.id] : []; %>
      <% const leftOccupants = occupants.slice(0, 1); %>
      <% const rightOccupants = occupants.slice(1, 2); %>
      <% const extraOccupants = occupants.slice(2); %>
      <div class="col-lg-4 col-md-6 col-sm-6">
        <div class="text-decoration-none room-card-container" data-room-id="<%= room.id %>">
          <div class="card border-0 shadow-sm room-card h-100">
            <div class="card-body">
              <div class="mb-2">
                <% if (room.status === 'bos') { %>
                  <span class="badge bg-success">Boş</span>
                <% } else if (room.status === 'dolu') { %>
                  <span class="badge bg-danger">Dolu</span>
                <% } else if (room.status === 'kismi_dolu') { %>
                  <span class="badge bg-warning text-dark">Kısmi Dolu</span>
                <% } else if (room.status === 'depo') { %>
                  <span class="badge bg-info text-dark"><i class="bi bi-box-seam"></i> Depo</span>
                <% } else { %>
                  <span class="badge bg-secondary">Bakımda</span>
                <% } %>
              </div>

              <div class="room-layout">
                <div class="room-occupant-column">
                  <% if (leftOccupants.length > 0) { %>
                    <% leftOccupants.forEach(p => { %>
                      <% const genderLabel = p.gender === 'erkek' ? 'Erkek' : (p.gender === 'kadin' ? 'Kadın' : '-'); %>
                      <% const genderClass = p.gender === 'erkek' ? 'gender-erkek' : (p.gender === 'kadin' ? 'gender-kadin' : 'gender-diger'); %>
                      <div class="room-occupant-card" data-personnel-id="<%= p.id %>">
                        <div class="room-occupant-name" title="<%= p.first_name %> <%= p.last_name %>"><%= p.first_name %> <%= p.last_name %></div>
                        <div class="room-occupant-meta"><span class="room-department-pill"><%= p.department || '-' %></span></div>
                        <div class="room-occupant-meta"><span class="room-gender-pill <%= genderClass %>"><%= genderLabel %></span></div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div class="room-occupant-empty"></div>
                  <% } %>
                </div>

                <div class="room-number-box"><%= room.room_number %></div>

                <div class="room-occupant-column">
                  <% if (rightOccupants.length > 0) { %>
                    <% rightOccupants.forEach(p => { %>
                      <% const genderLabel = p.gender === 'erkek' ? 'Erkek' : (p.gender === 'kadin' ? 'Kadın' : '-'); %>
                      <% const genderClass = p.gender === 'erkek' ? 'gender-erkek' : (p.gender === 'kadin' ? 'gender-kadin' : 'gender-diger'); %>
                      <div class="room-occupant-card" data-personnel-id="<%= p.id %>">
                        <div class="room-occupant-name" title="<%= p.first_name %> <%= p.last_name %>"><%= p.first_name %> <%= p.last_name %></div>
                        <div class="room-occupant-meta"><span class="room-department-pill"><%= p.department || '-' %></span></div>
                        <div class="room-occupant-meta"><span class="room-gender-pill <%= genderClass %>"><%= genderLabel %></span></div>
                      </div>
                    <% }) %>
                  <% } else { %>
                    <div class="room-occupant-empty"></div>
                  <% } %>
                </div>
              </div>

              <% if (extraOccupants.length > 0) { %>
                <div class="room-third-row">
                  <% extraOccupants.forEach(p => { %>
                    <% const genderLabel = p.gender === 'erkek' ? 'Erkek' : (p.gender === 'kadin' ? 'Kadın' : '-'); %>
                    <% const genderClass = p.gender === 'erkek' ? 'gender-erkek' : (p.gender === 'kadin' ? 'gender-kadin' : 'gender-diger'); %>
                    <div class="room-occupant-card" data-personnel-id="<%= p.id %>">
                      <div class="room-occupant-name" title="<%= p.first_name %> <%= p.last_name %>"><%= p.first_name %> <%= p.last_name %></div>
                      <div class="room-occupant-meta"><span class="room-department-pill"><%= p.department || '-' %></span></div>
                      <div class="room-occupant-meta"><span class="room-gender-pill <%= genderClass %>"><%= genderLabel %></span></div>
                    </div>
                  <% }) %>
                </div>
              <% } %>

              <% if (room.status !== 'depo') { %>
              <p class="text-muted mb-1 mt-2 small text-center">
                <i class="bi bi-people"></i> <%= room.occupant_count %>/<%= room.capacity %> Kişi
              </p>
              <% } %>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  <% }) %>
<% } %>

<!-- Yeni Oda Ekle Modal -->
<div class="modal fade" id="addRoomModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/odalar">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-lg"></i> Yeni Oda Ekle</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Oda Numarası *</label>
            <input type="number" class="form-control" name="room_number" required placeholder="Örn: 101" min="1">
          </div>
          <div class="mb-3" id="capacityGroup">
            <label class="form-label">Kapasite (Kişi) *</label>
            <input type="number" class="form-control" name="capacity" min="1" value="1" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Kat *</label>
            <select class="form-select" name="floor" required>
              <option value="">Kat Seçin</option>
              <% floors.forEach(f => { %>
                <option value="<%= f %>"><%= f %></option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Açıklama</label>
            <textarea class="form-control" name="description" rows="2"></textarea>
          </div>
          <div class="mb-3 form-check">
            <input type="checkbox" class="form-check-input" name="is_storage" id="isStorage" value="1">
            <label class="form-check-label" for="isStorage"><i class="bi bi-box-seam"></i> Bu oda depo olarak kullanılacak</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Ekle</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../footer') %>

<script>
document.getElementById('isStorage').addEventListener('change', function() {
  const capGroup = document.getElementById('capacityGroup');
  const capInput = capGroup.querySelector('input');
  if (this.checked) {
    capGroup.style.display = 'none';
    capInput.removeAttribute('required');
    capInput.removeAttribute('min');
    capInput.value = '0';
  } else {
    capGroup.style.display = '';
    capInput.setAttribute('required', '');
    capInput.setAttribute('min', '1');
    capInput.value = '1';
  }
});

// Handle room card interactions - personnel cards go to personnel detail, other areas go to room detail
document.querySelectorAll('.room-occupant-card').forEach(card => {
  card.addEventListener('click', function(e) {
    e.stopPropagation();
    const personnelId = this.dataset.personnelId;
    if (personnelId) {
      window.location.href = '/personel/' + personnelId;
    }
  });
});

document.querySelectorAll('.room-card-container').forEach(container => {
  container.addEventListener('click', function(e) {
    // If clicked on a personnel card, let that handler take over
    if (e.target.closest('.room-occupant-card')) {
      return;
    }
    // Otherwise navigate to room detail
    const roomId = this.dataset.roomId;
    if (roomId) {
      window.location.href = '/odalar/' + roomId;
    }
  });
});

const roomsFilterForm = document.getElementById('roomsFilterForm');
const roomsSearchInput = document.getElementById('roomsSearchInput');
if (roomsFilterForm && roomsSearchInput) {
  let searchDebounceTimer = null;
  roomsSearchInput.addEventListener('input', () => {
    if (searchDebounceTimer) {
      clearTimeout(searchDebounceTimer);
    }
    searchDebounceTimer = setTimeout(() => {
      roomsFilterForm.submit();
    }, 250);
  });
}
</script>
