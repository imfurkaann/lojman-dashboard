      </div>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.socket.io/4.5.4/socket.io.js"></script>
  <script src="/js/app.js"></script>
  <script>
    // Back/forward navigasyonunda tarayici bazen sayfayi cache'ten getirir (bfcache).
    // Bu durumda veri eski kalabilecegi icin otomatik yenileme yapariz.
    window.addEventListener('pageshow', (event) => {
      const navEntries = performance.getEntriesByType('navigation');
      const navType = navEntries && navEntries[0] ? navEntries[0].type : '';
      if (event.persisted || navType === 'back_forward') {
        window.location.reload();
      }
    });

    // Socket.IO bağlantısı
    const socket = io();
    
    socket.on('connect', () => {
      console.log('Socket.IO bağlantılandı:', socket.id);
    });
    
    socket.on('disconnect', () => {
      console.log('Socket.IO bağlantısı koptu');
    });

    const whatsappNoticeToast = document.getElementById('whatsappNoticeToast');
    if (whatsappNoticeToast) {
      const toast = bootstrap.Toast.getOrCreateInstance(whatsappNoticeToast, {
        delay: 2500,
        autohide: true
      });
      toast.show();
    }

    const whatsappErrorToast = document.getElementById('whatsappErrorToast');
    if (whatsappErrorToast) {
      const toast = bootstrap.Toast.getOrCreateInstance(whatsappErrorToast, {
        delay: 2500,
        autohide: true
      });
      toast.show();
    }

    // Uygulamanin herhangi bir yerinde veri degisikligi oldugunda aktif sayfayi tazeler.
    let liveRefreshTimer = null;
    let pageIsNavigating = false;

    window.addEventListener('beforeunload', () => {
      pageIsNavigating = true;
    });

    function scheduleLiveRefresh(delayMs = 250) {
      if (pageIsNavigating) return;
      if (liveRefreshTimer) {
        clearTimeout(liveRefreshTimer);
      }
      liveRefreshTimer = setTimeout(() => {
        window.location.reload();
      }, delayMs);
    }

    socket.on('app:data-changed', (data) => {
      console.log('Genel veri güncellemesi aldı:', data);
      scheduleLiveRefresh();
    });
    
    // Personel detay sayfası güncellemeleri
    socket.on('personnel:room-update', (data) => {
      console.log('Oda güncellemesi aldı:', data);
      
      // Oda bilgisi güncellemesi
      const roomInfoElement = document.getElementById('oda-bilgisi');
      if (roomInfoElement && data.room_name) {
        roomInfoElement.innerHTML = `<strong>Oda:</strong> ${data.room_name}`;
      }
      
      // Oda detay sayfasındaki anahtar sayısı güncellemesi
      const keyCountElement = document.getElementById(`key-count-${data.roomId}`);
      if (keyCountElement && data.anahtar_sayisi !== undefined) {
        const parts = keyCountElement.textContent.split('/');
        if (parts.length === 2) {
          keyCountElement.textContent = `${data.anahtar_sayisi}/${parts[1]}`;
        } else {
          keyCountElement.textContent = data.anahtar_sayisi;
        }
      }
    });
    
    socket.on('personnel:data-update', (data) => {
      console.log('Personel verisi güncellemesi aldı:', data);
      
      // Durum güncellemesi
      if (data.status) {
        const statusElement = document.querySelector('.badge');
        if (statusElement) {
          statusElement.textContent = data.status === 'aktif' ? 'Aktif' : 'Çıkış Yapmış';
          statusElement.className = data.status === 'aktif' ? 'badge bg-success fs-6' : 'badge bg-secondary fs-6';
        }
      }
    });
    
    socket.on('complaint:updated', (data) => {
      console.log('Şikayetler güncellemesi aldı:', data);
      
      // Şikayet listesi güncellemesi
      const complaintElement = document.getElementById(`complaint-${data.id}`);
      if (complaintElement && data.status) {
        const statusBadge = complaintElement.querySelector('.badge');
        if (statusBadge) {
          statusBadge.textContent = data.status;
        }
      }
    });

    // WhatsApp bağlantı modalı
    const whatsappModal = document.getElementById('whatsappConnectionModal');
    if (whatsappModal) {
      const connectionBadge = document.getElementById('whatsappConnectionBadge');
      const connectionStateText = document.getElementById('whatsappConnectionStateText');
      const connectionAccount = document.getElementById('whatsappConnectionAccount');
      const connectionLastConnected = document.getElementById('whatsappConnectionLastConnected');
      const connectionError = document.getElementById('whatsappConnectionError');
      const registrationBadge = document.getElementById('whatsappRegistrationBadge');
      const qrWrap = document.getElementById('whatsappQrWrap');
      const qrHint = document.getElementById('whatsappQrHint');
      const whatsappGroupCount = document.getElementById('whatsappGroupCount');
      const selectedGroupsWrap = document.getElementById('whatsappSelectedGroupsWrap');
      const selectedGroupsCount = document.getElementById('whatsappSelectedGroupsCount');
      const availableGroupsWrap = document.getElementById('whatsappAvailableGroupsWrap');
      const availableGroupsCount = document.getElementById('whatsappAvailableGroupsCount');
      const whatsappSendButton = document.getElementById('whatsappSendButton');
      const whatsappSendHint = document.getElementById('whatsappSendHint');
      const whatsappSendForm = document.getElementById('whatsappSendForm');
      const actionButtons = Array.from(document.querySelectorAll('[data-whatsapp-action]'));
      let whatsappPollTimer = null;
      let closeModalWhenOpen = false;

      function getSelectedGroupSet(groups) {
        return new Set((Array.isArray(groups) ? groups : []).map((group) => String(group.group_jid || group.id || '').trim()).filter(Boolean));
      }

      function setBadgeState(badge, kind, text) {
        if (!badge) return;
        badge.className = `badge bg-${kind}`;
        badge.textContent = text;
      }

      function renderQr(state) {
        if (!qrWrap) return;

        // Show loading spinner if connecting with QR
        if (state && state.connection === 'connecting' && state.qrDataUrl) {
          qrWrap.className = 'text-center';
          qrWrap.innerHTML = `
            <img id="whatsappQrImage" src="${state.qrDataUrl}" alt="WhatsApp QR" class="img-fluid border rounded-3 bg-white p-2 whatsapp-qr-image">
            <div class="mt-3">
              <div class="spinner-border spinner-border-sm text-primary mb-2" role="status">
                <span class="visually-hidden">Bağlanıyor...</span>
              </div>
              <p id="whatsappQrHint" class="small text-muted mb-0">Telefonunuzdan QR kodu okutun. Bağlantı kuruluyor...</p>
            </div>
          `;
          return;
        }

        if (state && state.qrDataUrl) {
          qrWrap.className = 'text-center';
          qrWrap.innerHTML = `
            <img id="whatsappQrImage" src="${state.qrDataUrl}" alt="WhatsApp QR" class="img-fluid border rounded-3 bg-white p-2 whatsapp-qr-image">
            <p id="whatsappQrHint" class="small text-muted mt-3 mb-0">Telefonunuzdan QR kodu okutun. Ekran açık kalabilir.</p>
          `;
          return;
        }

        qrWrap.className = 'border border-dashed rounded-3 p-4 text-center bg-light';
        qrWrap.innerHTML = `
          <i class="bi bi-qr-code-scan fs-1 text-muted"></i>
          <p id="whatsappQrHint" class="mb-0 mt-2 text-muted">QR kod görünür olduğunda burada çıkacak.</p>
        `;
      }

      function renderSelectedGroups(state) {
        if (!selectedGroupsWrap) return;

        const selectedGroups = Array.isArray(state && state.selectedGroups) ? state.selectedGroups : [];
        if (selectedGroupsCount) {
          selectedGroupsCount.textContent = `${selectedGroups.length} grup`;
        }

        if (whatsappSendButton) {
          whatsappSendButton.disabled = selectedGroups.length === 0;
        }

        if (whatsappSendHint) {
          whatsappSendHint.textContent = selectedGroups.length
            ? 'Mesaj bu gruplara aynı anda gönderilir.'
            : 'Önce modalden grup seçin.';
        }

        if (!selectedGroups.length) {
          selectedGroupsWrap.innerHTML = '<div class="small text-muted">Henüz seçili grup yok. Modalden gruplara tıklayarak ekleyin.</div>';
          return;
        }

        selectedGroupsWrap.innerHTML = selectedGroups.map((group) => `
          <button type="button" class="btn btn-success btn-sm rounded-pill d-inline-flex align-items-center gap-2"
            data-whatsapp-selected-remove
            data-group-jid="${String(group.group_jid || group.id || '').replace(/"/g, '&quot;')}"
            data-group-subject="${String(group.subject || '').replace(/"/g, '&quot;')}">
            <span>${String(group.subject || group.group_jid || '').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</span>
            <i class="bi bi-x-circle"></i>
          </button>
        `).join('');
      }

      function renderAvailableGroups(state) {
        if (!availableGroupsWrap) return;

        const groups = Array.isArray(state && state.groups) ? state.groups : [];
        const selectedGroups = Array.isArray(state && state.selectedGroups) ? state.selectedGroups : [];
        const selectedSet = getSelectedGroupSet(selectedGroups);

        if (whatsappGroupCount) {
          whatsappGroupCount.textContent = `${groups.length} grup yüklü`;
        }

        if (availableGroupsCount) {
          availableGroupsCount.textContent = `${groups.length} grup`;
        }

        if (!groups.length) {
          availableGroupsWrap.innerHTML = '<div class="col-12"><div class="text-muted small">Bağlantı tamamlanınca gruplar burada görünecek.</div></div>';
          return;
        }

        availableGroupsWrap.innerHTML = groups.map((group) => {
          const groupJid = String(group.id || '').replace(/"/g, '&quot;');
          const groupSubject = String(group.subject || group.id || '').replace(/"/g, '&quot;');
          const isSelected = selectedSet.has(String(group.id || '').trim());
          const buttonClass = isSelected ? 'btn-success' : 'btn-outline-secondary';
          const badgeClass = isSelected ? 'bg-light text-dark' : 'bg-secondary';
          const badgeText = isSelected ? 'Seçili' : 'Ekle';
          return `
            <div class="col-12 col-md-6 col-xl-4">
              <button type="button"
                class="btn w-100 text-start ${buttonClass}"
                data-whatsapp-group-toggle
                data-group-jid="${groupJid}"
                data-group-subject="${groupSubject}"
                data-group-participants="${String(group.participants || 0)}"
                data-group-community="${group.isCommunity ? '1' : '0'}">
                <div class="d-flex align-items-center justify-content-between gap-2">
                  <div>
                    <div class="fw-semibold">${String(group.subject || group.id || '').replace(/</g, '&lt;').replace(/>/g, '&gt;')}</div>
                    <div class="small opacity-75">${String(group.participants || 0)} kişi</div>
                  </div>
                  <span class="badge ${badgeClass}">${badgeText}</span>
                </div>
              </button>
            </div>
          `;
        }).join('');
      }

      function renderGroupPanels(state) {
        renderSelectedGroups(state);
        renderAvailableGroups(state);
      }

      async function syncSelectedGroup(group, method) {
        const normalizedMethod = method === 'DELETE' ? 'DELETE' : 'POST';
        const url = normalizedMethod === 'DELETE'
          ? `/whatsapp/selected-groups/${encodeURIComponent(group.group_jid || group.id || '')}`
          : '/whatsapp/selected-groups';

        const response = await fetch(url, {
          method: normalizedMethod,
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: normalizedMethod === 'DELETE'
            ? undefined
            : JSON.stringify({
                group_jid: group.group_jid || group.id,
                subject: group.subject,
                participants: group.participants,
                isCommunity: group.isCommunity
              })
        });

        if (!response.ok) {
          throw new Error('Grup kaydı güncellenemedi.');
        }

        await refreshWhatsappState();
      }

      if (selectedGroupsWrap) {
        selectedGroupsWrap.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-whatsapp-selected-remove]');
          if (!button) return;

          event.preventDefault();
          const group = {
            group_jid: button.getAttribute('data-group-jid'),
            subject: button.getAttribute('data-group-subject') || button.getAttribute('data-group-jid')
          };

          try {
            await syncSelectedGroup(group, 'DELETE');
          } catch (error) {
            console.error('[WhatsApp] selected group remove failed:', error);
          }
        });
      }

      if (availableGroupsWrap) {
        availableGroupsWrap.addEventListener('click', async (event) => {
          const button = event.target.closest('[data-whatsapp-group-toggle]');
          if (!button) return;

          event.preventDefault();
          const group = {
            id: button.getAttribute('data-group-jid'),
            subject: button.getAttribute('data-group-subject') || button.getAttribute('data-group-jid'),
            participants: Number(button.getAttribute('data-group-participants') || 0),
            isCommunity: button.getAttribute('data-group-community') === '1'
          };

          const isSelected = button.classList.contains('btn-success');
          try {
            await syncSelectedGroup(group, isSelected ? 'DELETE' : 'POST');
          } catch (error) {
            console.error('[WhatsApp] available group toggle failed:', error);
          }
        });
      }

      if (whatsappSendForm) {
        whatsappSendForm.addEventListener('submit', async (event) => {
          event.preventDefault();

          if (whatsappSendButton) {
            whatsappSendButton.disabled = true;
          }

          try {
            const response = await fetch('/whatsapp/send-selected-groups', {
              method: 'POST',
              headers: {
                Accept: 'application/json'
              },
              body: new URLSearchParams(new FormData(whatsappSendForm)).toString()
            });

            if (!response.ok) {
              throw new Error('Mesaj gönderilmedi.');
            }

            // Force the browser back to the canonical page to avoid POST URL persistence.
            window.location.assign('/whatsapp?notice=sent');
          } catch (error) {
            window.location.assign('/whatsapp?error=send_failed');
          } finally {
            if (whatsappSendButton) {
              whatsappSendButton.disabled = false;
            }
          }
        });
      }

      function applyWhatsappState(state) {
        if (!state) return;

        const connection = String(state.connection || 'idle');
        const connectionLabel = connection === 'open' ? 'Bağlı' : connection === 'logged_out' ? 'Yeniden eşleme gerekli' : connection === 'error' ? 'Hata' : 'Bağlanıyor';
        const badgeKind = connection === 'open' ? 'success' : connection === 'logged_out' ? 'danger' : connection === 'error' ? 'danger' : 'warning';

        setBadgeState(connectionBadge, badgeKind, connectionLabel);
        if (connectionStateText) {
          connectionStateText.textContent = connection;
        }

        if (connectionAccount) {
          if (state.me && state.me.id) {
            connectionAccount.textContent = `Hesap: ${state.me.id}`;
            connectionAccount.classList.remove('d-none');
          } else {
            connectionAccount.textContent = '';
            connectionAccount.classList.add('d-none');
          }
        }

        if (connectionLastConnected) {
          if (state.lastConnectedAt) {
            connectionLastConnected.textContent = `Son bağlantı: ${state.lastConnectedAt}`;
            connectionLastConnected.classList.remove('d-none');
          } else {
            connectionLastConnected.textContent = '';
            connectionLastConnected.classList.add('d-none');
          }
        }

        if (connectionError) {
          if (state.lastError) {
            connectionError.textContent = state.lastError;
            connectionError.classList.remove('d-none');
          } else {
            connectionError.textContent = '';
            connectionError.classList.add('d-none');
          }
        }

        if (registrationBadge) {
          registrationBadge.textContent = state.registered ? 'Kayıtlı oturum' : 'Yeni eşleme';
        }

        renderQr(state);
        renderGroupPanels(state);

        // Auto-close modal only after a user-initiated action is waiting for connection
        if (state.connection === 'open' && whatsappModal && closeModalWhenOpen) {
          closeModalWhenOpen = false;
          setTimeout(() => {
            const modal = bootstrap.Modal.getOrCreateInstance(whatsappModal);
            modal.hide();
          }, 500); // Brief delay to show final state
        }
      }

      async function fetchWhatsappState() {
        const response = await fetch('/whatsapp/status', {
          headers: {
            Accept: 'application/json'
          }
        });

        if (!response.ok) {
          throw new Error('WhatsApp durumu alınamadı.');
        }

        const payload = await response.json();
        return payload.whatsapp || null;
      }

      async function refreshWhatsappState() {
        try {
          const state = await fetchWhatsappState();
          applyWhatsappState(state);

          if (state && state.connection === 'open' && closeModalWhenOpen) {
            closeModalWhenOpen = false;
            stopWhatsappPolling();
            if (whatsappModal) {
              const modal = bootstrap.Modal.getOrCreateInstance(whatsappModal);
              modal.hide();
            }
          }
        } catch (error) {
          console.error('[WhatsApp] state refresh failed:', error);
        }
      }

      function startWhatsappPolling() {
        if (whatsappPollTimer) return;
        whatsappPollTimer = window.setInterval(refreshWhatsappState, 1500);
      }

      function stopWhatsappPolling() {
        if (!whatsappPollTimer) return;
        window.clearInterval(whatsappPollTimer);
        whatsappPollTimer = null;
      }

      async function triggerWhatsappAction(action) {
        const response = await fetch('/whatsapp/control?format=json', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            Accept: 'application/json'
          },
          body: new URLSearchParams({ action }).toString()
        });

        if (!response.ok) {
          throw new Error('WhatsApp kontrol isteği başarısız oldu.');
        }

        const payload = await response.json();
        applyWhatsappState(payload.whatsapp || null);

        if (payload.whatsapp && payload.whatsapp.connection !== 'open' && !payload.whatsapp.qrDataUrl) {
          closeModalWhenOpen = true;
          startWhatsappPolling();
        }

        if (payload.whatsapp && payload.whatsapp.connection === 'open') {
          if (closeModalWhenOpen) {
            stopWhatsappPolling();
            // Auto-close modal when connection is established
            setTimeout(() => {
              const modal = bootstrap.Modal.getOrCreateInstance(whatsappModal);
              modal.hide();
            }, 500);
          }
        }

        return payload.whatsapp || null;
      }

      actionButtons.forEach((button) => {
        button.addEventListener('click', async () => {
          const action = button.getAttribute('data-whatsapp-action');
          if (!action) return;

          button.disabled = true;
          try {
            await triggerWhatsappAction(action);
            await refreshWhatsappState();
          } catch (error) {
            console.error('[WhatsApp] action failed:', error);
          } finally {
            button.disabled = false;
          }
        });
      });

      whatsappModal.addEventListener('shown.bs.modal', () => {
        refreshWhatsappState();
        startWhatsappPolling();
      });

      whatsappModal.addEventListener('hidden.bs.modal', () => {
        stopWhatsappPolling();
        closeModalWhenOpen = false;
      });

    }
  </script>
</body>
</html>
