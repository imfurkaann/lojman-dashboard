<%- include('layout', { title: 'Eşya Takip' }) %>

<style>
  .equipment-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .equipment-toolbar-title {
    margin: 0;
  }

  .equipment-toolbar-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  @media (max-width: 767.98px) {
    .equipment-toolbar {
      align-items: stretch;
    }

    .equipment-toolbar-actions {
      width: 100%;
    }

    .equipment-toolbar-actions .btn {
      flex: 1 1 0;
      white-space: nowrap;
    }
  }
</style>

<div class="equipment-toolbar">
  <h4 class="equipment-toolbar-title"><i class="bi bi-box-seam"></i> Ortak Eşya Takip</h4>
  <div class="equipment-toolbar-actions">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addEquipmentModal">
      <i class="bi bi-plus-lg"></i> Eşya Teslim Et
    </button>
    <button class="btn btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#manageItemsModal">
      <i class="bi bi-gear"></i> Eşya Listesi
    </button>
  </div>
</div>

<!-- Filtre -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-2">
    <form method="GET" class="row g-2 align-items-center" id="equipmentFilterForm">
      <div class="col-md-3">
        <input type="text" class="form-control form-control-sm" id="equipmentSearchInput" name="search" placeholder="Eşya, kişi veya oda ara..." value="<%= search %>">
      </div>
      <div class="col-md-3">
        <select class="form-select form-select-sm" name="item_name" onchange="this.form.submit()">
          <option value="">Tüm Eşyalar</option>
          <% (savedItems || []).forEach(item => { %>
            <option value="<%= item.name %>" <%= itemFilter === item.name ? 'selected' : '' %>><%= item.name %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
          <option value="">Tüm Durumlar</option>
          <option value="teslim_edildi" <%= statusFilter === 'teslim_edildi' ? 'selected' : '' %>>Teslim Edildi</option>
          <option value="iade_edildi" <%= statusFilter === 'iade_edildi' ? 'selected' : '' %>>Teslim Alındı</option>
          <option value="kayip" <%= statusFilter === 'kayip' ? 'selected' : '' %>>Eşya Bozuldu</option>
        </select>
      </div>
      <div class="col-md-2">
        <button type="submit" class="btn btn-sm btn-primary w-100">Filtrele</button>
      </div>
      <% if (search || statusFilter || itemFilter) { %>
      <div class="col-md-2">
        <a href="/esya-takip" class="btn btn-sm btn-outline-secondary w-100">Temizle</a>
      </div>
      <% } %>
    </form>
  </div>
</div>

<!-- Liste -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (equipment.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-box-seam fs-1"></i>
        <p class="mt-2">Eşya kaydı bulunamadı</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Eşya</th>
            <th>Teslim Alan</th>
            <th>Oda</th>
            <th>Teslim Tarihi</th>
            <th>İade Tarihi</th>
            <th>Durum</th>
            <th>Durum Güncelle</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% equipment.forEach(e => { %>
          <tr>
            <td><strong><%= e.item_name %></strong></td>
            <td><%= e.given_to %></td>
            <td><%= e.room_number || '-' %></td>
            <td><small><%= new Date(e.given_at).toLocaleString('tr-TR') %></small></td>
            <td><small><%= e.returned_at ? new Date(e.returned_at).toLocaleString('tr-TR') : '-' %></small></td>
            <td>
              <% if (e.status === 'teslim_edildi') { %>
                <span class="badge bg-warning text-dark">Teslim Edildi</span>
              <% } else if (e.status === 'iade_edildi') { %>
                <span class="badge bg-success">Teslim Alındı</span>
              <% } else { %>
                <span class="badge bg-danger">Eşya Bozuldu</span>
              <% } %>
            </td>
            <td>
              <form method="POST" action="/esya-takip/<%= e.id %>/durum" class="d-flex">
                <select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
                  <option value="">Seçiniz</option>
                  <option value="iade_edildi" <%= e.status === 'iade_edildi' ? 'selected' : '' %>>Teslim Alındı</option>
                  <option value="kayip" <%= e.status === 'kayip' ? 'selected' : '' %>>Eşya Bozuldu</option>
                </select>
              </form>
            </td>
            <td>
              <form method="POST" action="/esya-takip/<%= e.id %>/sil" class="d-inline" onsubmit="return confirm('Bu kaydı silmek istediğinize emin misiniz?')">
                <button class="btn btn-sm btn-outline-secondary" title="Sil"><i class="bi bi-trash"></i></button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Eşya Teslim Modal -->
<div class="modal fade" id="addEquipmentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form method="POST" action="/esya-takip/ekle">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-lg"></i> Eşya Teslim Et</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Eşya Adı *</label>
            <select class="form-select" name="item_name" required>
              <option value="">Eşya Seçin</option>
              <% if ((availableItems || []).length === 0) { %>
                <option value="" disabled>Teslim edilebilir eşya yok</option>
              <% } %>
              <% (availableItems || []).forEach(item => { %>
                <option value="<%= item.name %>"><%= item.name %></option>
              <% }) %>
            </select>
            <small class="text-muted">Listede yoksa "Eşya Listesi" butonundan ekleyin</small>
          </div>
          <div class="mb-3">
            <label class="form-label">Teslim Alan Kişi *</label>
            <div class="position-relative">
              <input type="text" class="form-control" id="personnelSearch" name="given_to" placeholder="İsim yazarak arayın veya manuel girin..." autocomplete="off" required>
              <div id="personnelSuggestions" class="list-group position-absolute w-100 shadow-sm d-none" style="z-index: 1080; max-height: 220px; overflow-y: auto;"></div>
            </div>
            <small class="text-muted">Kayıtlı personel seçerseniz oda otomatik gelir, kayıtlı değilse adı manuel yazabilirsiniz.</small>
          </div>
          <input type="hidden" name="room_number" id="roomNumberValue">
          <div class="mb-3">
            <label class="form-label">Not</label>
            <textarea class="form-control" name="notes" rows="2"></textarea>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Teslim Et</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Eşya Listesi Yönetim Modal -->
<div class="modal fade" id="manageItemsModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><i class="bi bi-gear"></i> Kayıtlı Eşya Listesi</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form method="POST" action="/esya-takip/esya-ekle" class="row g-2 mb-3">
          <div class="col">
            <input type="text" class="form-control form-control-sm" name="name" required placeholder="Yeni eşya adı...">
          </div>
          <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> Ekle</button>
          </div>
        </form>
        <% if (savedItems.length === 0) { %>
          <p class="text-muted text-center mb-0">Henüz kayıtlı eşya yok</p>
        <% } else { %>
        <ul class="list-group">
          <% savedItems.forEach(item => { %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= item.name %></span>
            <form method="POST" action="/esya-takip/esya-sil" class="d-inline" onsubmit="return confirm('Bu eşyayı listeden silmek istediğinize emin misiniz?')">
              <input type="hidden" name="name" value="<%= item.name %>">
              <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
            </form>
          </li>
          <% }) %>
        </ul>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
// Personel arama + otomatik oda doldurma
const personnelData = <%- JSON.stringify(personnel.map(p => ({ name: p.full_name, room_number: p.room_number, status: p.status }))) %>;
const searchInput = document.getElementById('personnelSearch');
const roomValue = document.getElementById('roomNumberValue');
const suggestionsEl = document.getElementById('personnelSuggestions');
const equipmentFilterForm = document.getElementById('equipmentFilterForm');
const equipmentSearchInput = document.getElementById('equipmentSearchInput');

if (equipmentFilterForm && equipmentSearchInput) {
  equipmentSearchInput.addEventListener('keydown', (event) => {
    if (event.key === 'Enter') {
      event.preventDefault();
      equipmentFilterForm.submit();
    }
  });
}

function setRoomFromName(name) {
  const person = personnelData.find(p => (p.name || '').toLocaleLowerCase('tr-TR') === (name || '').toLocaleLowerCase('tr-TR'));
  const roomNumber = person && person.room_number ? String(person.room_number) : '';
  roomValue.value = roomNumber;
}

function escapeHtml(text) {
  return String(text || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function hideSuggestions() {
  suggestionsEl.classList.add('d-none');
  suggestionsEl.innerHTML = '';
}

function renderSuggestions(query) {
  const q = (query || '').trim().toLocaleLowerCase('tr-TR');
  if (!q) {
    hideSuggestions();
    return;
  }

  const matches = personnelData
    .filter(p => (p.name || '').toLocaleLowerCase('tr-TR').includes(q))
    .slice(0, 8);

  if (matches.length === 0) {
    suggestionsEl.innerHTML = '<div class="list-group-item text-muted small">Eşleşen personel bulunamadı</div>';
    suggestionsEl.classList.remove('d-none');
    return;
  }

  suggestionsEl.innerHTML = matches.map(p => {
    const badge = (p.status || '').toLowerCase() === 'ayrilacak'
      ? '<span class="badge text-bg-warning">Ayrılacak</span>'
      : '<span class="badge text-bg-success">Aktif</span>';
    return `
      <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center personnel-option" data-name="${escapeHtml(p.name)}">
        <span class="text-truncate pe-2">${escapeHtml(p.name)}</span>
        <span class="d-flex align-items-center gap-2">
          ${badge}
        </span>
      </button>
    `;
  }).join('');

  suggestionsEl.classList.remove('d-none');

  suggestionsEl.querySelectorAll('.personnel-option').forEach(btn => {
    btn.addEventListener('click', function() {
      const selectedName = this.getAttribute('data-name') || '';
      searchInput.value = selectedName;
      setRoomFromName(selectedName);
      hideSuggestions();
    });
  });
}

searchInput.addEventListener('input', function() {
  const currentValue = this.value.trim();
  setRoomFromName(currentValue);
  renderSuggestions(currentValue);
});

searchInput.addEventListener('change', function() {
  setRoomFromName(this.value.trim());
});

searchInput.addEventListener('focus', function() {
  renderSuggestions(this.value.trim());
});

document.addEventListener('click', function(event) {
  if (!suggestionsEl.contains(event.target) && event.target !== searchInput) {
    hideSuggestions();
  }
});
</script>

<%- include('footer') %>
