<script id="checkoutIssueMapData" type="application/json"><%- JSON.stringify(openCheckoutIssueMap || {}) %></script>
<script id="roomInventoryItemsMapData" type="application/json"><%- JSON.stringify(roomInventoryItemsMap || {}) %></script>
<script id="roomOpenIssueMapData" type="application/json"><%- JSON.stringify(roomOpenIssueMap || {}) %></script>
<script id="roomAvailabilityMapData" type="application/json"><%- JSON.stringify(roomAvailabilityMap || {}) %></script>

<script>
// Open room change modal directly when coming from list shortcut
(function() {
  const modalEl = document.getElementById('changeRoomModal');
  if (!modalEl || typeof window === 'undefined') return;

  const params = new URLSearchParams(window.location.search || '');
  if (params.get('openRoomModal') !== '1') return;

  if (window.bootstrap && window.bootstrap.Modal) {
    window.bootstrap.Modal.getOrCreateInstance(modalEl).show();
  }

  params.delete('openRoomModal');
  const query = params.toString();
  const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash || ''}`;
  window.history.replaceState({}, '', nextUrl);
})();

// Room availability guard for room change/assignment
(function() {
  const roomAvailabilityRaw = document.getElementById('roomAvailabilityMapData');
  const roomSelect = document.getElementById('reassignRoomSelect');
  const form = document.querySelector('#changeRoomModal form');
  const overrideInput = document.getElementById('detailAllowCleaningOverrideInput');
  if (!roomAvailabilityRaw || !roomSelect || !form || !overrideInput) return;

  let roomAvailabilityMap = {};
  try {
    roomAvailabilityMap = JSON.parse(roomAvailabilityRaw.textContent || '{}');
  } catch (_) {
    roomAvailabilityMap = {};
  }

  function getAvailability(roomId) {
    return String(roomAvailabilityMap[String(roomId)] || roomAvailabilityMap[roomId] || 'musait');
  }

  form.addEventListener('submit', (e) => {
    overrideInput.value = '0';
    const roomId = roomSelect.value;
    if (!roomId) return;

    const availability = getAvailability(roomId);
    if (availability === 'kullanilamaz') {
      e.preventDefault();
      alert('Bu oda kullanılamaz durumda olduğu için personel atanamaz.');
      return;
    }

    if (availability === 'temizlenmeli') {
      const confirmed = window.confirm('Seçilen oda temizlenmesi gerekiyor durumda. Yine de personele atamak istiyor musunuz?');
      if (!confirmed) {
        e.preventDefault();
        return;
      }
      overrideInput.value = '1';
    }
  });
})();

// Edit modal logic (mirrors add-personnel modal UX)
(function() {
  const editModalEl = document.getElementById('editPersonModal');
  if (!editModalEl) return;


  // Camera/upload logic (edit)
  const editAddPhotoBtn = document.getElementById('editAddPhotoBtn');
  const editPhotoOptions = document.getElementById('editPhotoOptions');
  const editChooseCameraBtn = document.getElementById('editChooseCameraBtn');
  const editChooseUploadBtn = document.getElementById('editChooseUploadBtn');
  const editCameraInputWrap = document.getElementById('editCameraInputWrap');
  const editUploadInputWrap = document.getElementById('editUploadInputWrap');
  const editCameraPreview = document.getElementById('editCameraPreview');
  const editCapturedPreview = document.getElementById('editCapturedPreview');
  const editTakePhotoBtn = document.getElementById('editTakePhotoBtn');
  const editStopCameraBtn = document.getElementById('editStopCameraBtn');
  const editUploadPhotoInput = document.getElementById('editUploadPhotoInput');
  const editCapturedPhotoData = document.getElementById('editCapturedPhotoData');

  let editStream = null;
  let editCapturedBlob = null;

  function editResetCameraState() {
    editCapturedBlob = null;
    if (editCapturedPhotoData) editCapturedPhotoData.value = '';
    if (editCapturedPreview) {
      editCapturedPreview.src = '';
      editCapturedPreview.style.display = 'none';
    }
    if (editCameraPreview) {
      editCameraPreview.style.display = 'block';
    }
    if (editUploadPhotoInput) editUploadPhotoInput.value = '';
  }

  async function editStartCamera() {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      alert('Bu tarayıcı kamera erişimini desteklemiyor.');
      return;
    }
    try {
      editStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
      if (editCameraPreview) {
        editCameraPreview.srcObject = editStream;
        await editCameraPreview.play();
      }
      if (editStopCameraBtn) editStopCameraBtn.disabled = false;
    } catch (err) {
      console.error(err);
      alert('Kamera açılamadı. Tarayıcı izinlerini kontrol edin.');
    }
  }

  function editStopCamera() {
    if (editStream) {
      editStream.getTracks().forEach(t => t.stop());
      editStream = null;
    }
    if (editCameraPreview) editCameraPreview.srcObject = null;
    if (editStopCameraBtn) editStopCameraBtn.disabled = true;
  }

  function editTakeSnapshot() {
    if (!editCameraPreview) return;
    const canvas = document.createElement('canvas');
    const w = editCameraPreview.videoWidth || 640;
    const h = editCameraPreview.videoHeight || 480;
    canvas.width = w;
    canvas.height = h;
    const ctx = canvas.getContext('2d');
    ctx.translate(w, 0);
    ctx.scale(-1, 1);
    ctx.drawImage(editCameraPreview, 0, 0, w, h);
    canvas.toBlob((blob) => {
      if (!blob) return;
      editCapturedBlob = blob;
      if (editCapturedPhotoData) {
        editCapturedPhotoData.value = canvas.toDataURL('image/jpeg', 0.9);
      }
      if (editCapturedPreview) {
        editCapturedPreview.src = URL.createObjectURL(blob);
        editCapturedPreview.style.display = 'block';
      }
      if (editCameraPreview) editCameraPreview.style.display = 'none';
      editStopCamera();
    }, 'image/jpeg', 0.9);
  }

  if (editAddPhotoBtn && editPhotoOptions) {
    editAddPhotoBtn.addEventListener('click', () => {
      editPhotoOptions.style.display = editPhotoOptions.style.display === 'none' ? 'block' : 'none';
    });
  }
  if (editChooseCameraBtn) {
    editChooseCameraBtn.addEventListener('click', async () => {
      editResetCameraState();
      if (editUploadInputWrap) editUploadInputWrap.style.display = 'none';
      if (editCameraInputWrap) editCameraInputWrap.style.display = 'block';
      await editStartCamera();
    });
  }
  if (editChooseUploadBtn) {
    editChooseUploadBtn.addEventListener('click', () => {
      editStopCamera();
      editResetCameraState();
      if (editCameraInputWrap) editCameraInputWrap.style.display = 'none';
      if (editUploadInputWrap) editUploadInputWrap.style.display = 'block';
    });
  }
  if (editTakePhotoBtn) editTakePhotoBtn.addEventListener('click', editTakeSnapshot);
  if (editStopCameraBtn) editStopCameraBtn.addEventListener('click', () => {
    editStopCamera();
    editResetCameraState();
  });

  // On modal shown
  editModalEl.addEventListener('shown.bs.modal', () => {});
  // On modal hidden: stop camera
  editModalEl.addEventListener('hidden.bs.modal', () => {
    editStopCamera();
    editResetCameraState();
  });

  // Before submit: build payload + attach captured blob as photo
  const editForm = document.getElementById('editPersonnelForm');
  const editDepartmentSelect = document.getElementById('editDepartmentSelect');
  const editDepartmentInput = document.getElementById('editDepartmentInput');

  function syncEditDepartmentField() {
    if (!editDepartmentSelect || !editDepartmentInput) return;
    const selected = editDepartmentSelect.value;
    if (selected === '__manual__') {
      editDepartmentInput.classList.remove('d-none');
      if (!editDepartmentInput.value) {
        editDepartmentInput.focus();
      }
      return;
    }

    editDepartmentInput.classList.add('d-none');
    editDepartmentInput.value = selected || '';
  }

  if (editDepartmentSelect && editDepartmentInput) {
    editDepartmentSelect.addEventListener('change', syncEditDepartmentField);
    syncEditDepartmentField();
  }

  if (editForm) {
    editForm.addEventListener('submit', function(e) {
      // If captured via camera, attach as "photo" file
      if (editCapturedBlob) {
        const fileInput = editModalEl.querySelector('input[type="file"][name="photo"]');
        if (fileInput) {
          const dt = new DataTransfer();
          dt.items.add(new File([editCapturedBlob], `personel_${Date.now()}.jpg`, { type: 'image/jpeg' }));
          fileInput.files = dt.files;
        }
      }
    });
  }
})();

// Checkout modal logic
(function() {
  const checkoutModalEl = document.getElementById('checkoutModal');
  const checkoutForm = document.getElementById('checkoutForm');
  const checkoutPayloadInput = document.getElementById('checkoutPayloadInput');
  const checkoutIssueMapRaw = document.getElementById('checkoutIssueMapData');
  let checkoutIssueMap = {};
  try {
    checkoutIssueMap = checkoutIssueMapRaw ? JSON.parse(checkoutIssueMapRaw.textContent || '{}') : {};
  } catch (_) {
    checkoutIssueMap = {};
  }
  const initialCheckoutState = {};
  if (!checkoutModalEl || !checkoutForm || !checkoutPayloadInput) return;

  function getCheckoutItemState(itemEl) {
    const selected = itemEl.querySelector('input[type="radio"]:checked');
    const delivered = selected ? selected.value === 'yes' : true;
    const tagEl = itemEl.querySelector('.checkout-tag');
    const descEl = itemEl.querySelector('.checkout-description');
    const tag = delivered ? '' : (tagEl ? (tagEl.value || '') : '');
    const description = delivered ? '' : (descEl ? (descEl.value || '').trim() : '');
    return { delivered, tag, description };
  }

  function applyCheckoutItemState(itemEl, state) {
    const yesRadio = itemEl.querySelector('.checkout-delivered[value="yes"]');
    const noRadio = itemEl.querySelector('.checkout-delivered-no[value="no"]');
    const problemBox = itemEl.querySelector('.checkout-problem');
    const tagEl = itemEl.querySelector('.checkout-tag');
    const descEl = itemEl.querySelector('.checkout-description');

    if (state.delivered) {
      if (yesRadio) yesRadio.checked = true;
      if (problemBox) problemBox.style.display = 'none';
      if (tagEl) tagEl.value = '';
      if (descEl) descEl.value = '';
      return;
    }

    if (noRadio) noRadio.checked = true;
    if (problemBox) problemBox.style.display = 'block';
    if (tagEl) tagEl.value = state.tag || '';
    if (descEl) descEl.value = state.description || '';
  }

  function applyCheckoutDefaultsFromIssues() {
    checkoutForm.reset();

    checkoutForm.querySelectorAll('.checkout-item').forEach(itemEl => {
      const itemName = (itemEl.getAttribute('data-item-name') || '').trim();
      const key = itemName.toLowerCase();
      const issue = checkoutIssueMap[key];

      const yesRadio = itemEl.querySelector('.checkout-delivered[value="yes"]');
      const noRadio = itemEl.querySelector('.checkout-delivered-no[value="no"]');
      const problemBox = itemEl.querySelector('.checkout-problem');
      const tagEl = itemEl.querySelector('.checkout-tag');
      const descEl = itemEl.querySelector('.checkout-description');

      if (issue) {
        if (noRadio) noRadio.checked = true;
        if (problemBox) problemBox.style.display = 'block';
        if (tagEl) tagEl.value = issue.tag || '';
        if (descEl) descEl.value = issue.description || '';
        initialCheckoutState[key] = {
          delivered: false,
          tag: issue.tag || '',
          description: issue.description || ''
        };
      } else {
        if (yesRadio) yesRadio.checked = true;
        if (problemBox) problemBox.style.display = 'none';
        if (tagEl) tagEl.value = '';
        if (descEl) descEl.value = '';
        initialCheckoutState[key] = {
          delivered: true,
          tag: '',
          description: ''
        };
      }
    });
  }

  checkoutModalEl.addEventListener('show.bs.modal', () => {
    applyCheckoutDefaultsFromIssues();
  });

  checkoutModalEl.addEventListener('change', (e) => {
    const t = e.target;
    if (!t) return;

    const item = t.closest('.checkout-item');
    if (!item) return;
    const name = (item.getAttribute('data-item-name') || '').trim();
    const key = name.toLowerCase();

    if (t.classList.contains('checkout-delivered-no')) {
      const box = item.querySelector('.checkout-problem');
      if (box) box.style.display = t.checked ? 'block' : 'none';
    }

    if (t.classList.contains('checkout-delivered') && t.value === 'yes' && t.checked) {
      const box = item.querySelector('.checkout-problem');
      if (box) box.style.display = 'none';
    }

    const hasOpenIssue = !!checkoutIssueMap[key];
    const isRelevantControl = t.classList.contains('checkout-delivered') || t.classList.contains('checkout-tag');
    if (!hasOpenIssue || !isRelevantControl) return;

    const previous = initialCheckoutState[key];
    if (!previous) return;

    const current = getCheckoutItemState(item);
    const changed = previous.delivered !== current.delivered
      || previous.tag !== current.tag
      || (previous.description || '') !== (current.description || '');

    if (!changed) return;

    const confirmText = `${name} için kayıtlı sorun seçimini değiştiriyorsunuz. Onay verirseniz personel çıkış kaydı ve oda demirbaş sorunu bu yeni seçime göre güncellenecek. Devam etmek istiyor musunuz?`;
    if (!window.confirm(confirmText)) {
      applyCheckoutItemState(item, previous);
      return;
    }

    initialCheckoutState[key] = current;
  });

  checkoutForm.addEventListener('submit', (e) => {
    const items = [];
    let invalid = false;

    checkoutForm.querySelectorAll('.checkout-item').forEach(itemEl => {
      const name = itemEl.getAttribute('data-item-name') || '';
      const selected = itemEl.querySelector('input[type="radio"]:checked');
      if (!selected) {
        invalid = true;
        return;
      }

      const delivered = selected.value === 'yes';
      const tagEl = itemEl.querySelector('.checkout-tag');
      const descEl = itemEl.querySelector('.checkout-description');
      const tag = tagEl ? (tagEl.value || '') : '';
      const description = descEl ? (descEl.value || '').trim() : '';

      if (!delivered && !tag) {
        invalid = true;
      }

      items.push({
        name,
        delivered,
        tag: delivered ? null : tag,
        description: delivered ? null : (description || null)
      });
    });

    if (invalid) {
      e.preventDefault();
      alert('Çıkış için tüm demirbaşlar işaretlenmeli; teslim alınmayanlar için sorun türü seçilmelidir.');
      return;
    }

    checkoutPayloadInput.value = JSON.stringify({
      type: 'checkout',
      items,
      checked_at: new Date().toISOString()
    });
  });
})();

// Reassign modal logic (for non-active personnel)
(function() {
  const needsHandoverOnAssign = "<%= person.status %>" !== 'aktif';
  if (!needsHandoverOnAssign) return;

  const roomInventoryItemsRaw = document.getElementById('roomInventoryItemsMapData');
  const roomOpenIssueMapRaw = document.getElementById('roomOpenIssueMapData');
  let roomInventoryItemsMap = {};
  let roomOpenIssueMap = {};

  try {
    roomInventoryItemsMap = roomInventoryItemsRaw ? JSON.parse(roomInventoryItemsRaw.textContent || '{}') : {};
  } catch (_) {
    roomInventoryItemsMap = {};
  }

  try {
    roomOpenIssueMap = roomOpenIssueMapRaw ? JSON.parse(roomOpenIssueMapRaw.textContent || '{}') : {};
  } catch (_) {
    roomOpenIssueMap = {};
  }

  const reassignForm = document.querySelector('#changeRoomModal form');
  const roomSelect = document.getElementById('reassignRoomSelect');
  const section = document.getElementById('reassignHandoverSection');
  const itemsContainer = document.getElementById('reassignItemsContainer');
  const payloadInput = document.getElementById('reassignHandoverPayloadInput');
  if (!reassignForm || !roomSelect || !section || !itemsContainer || !payloadInput) return;

  let pendingIssueResolution = null;

  function normalizeName(name) {
    return String(name || '').trim().toLocaleLowerCase('tr-TR');
  }

  function getRoomItems(roomId) {
    const list = roomInventoryItemsMap[String(roomId)] || roomInventoryItemsMap[roomId] || [];
    return Array.isArray(list) ? list : [];
  }

  function getOpenIssue(roomId, itemName) {
    const roomIssues = roomOpenIssueMap[String(roomId)] || {};
    return roomIssues[normalizeName(itemName)] || null;
  }

  function renderReassignItems(roomId) {
    const items = getRoomItems(roomId);
    if (!items.length) {
      itemsContainer.innerHTML = '<div class="text-muted small mb-2">Bu odada teslim kontrolü gerektiren demirbaş bulunmuyor.</div>';
      return;
    }

    itemsContainer.innerHTML = items.map((itemName, idx) => {
      const safeName = String(itemName || '').replace(/"/g, '&quot;');
      return `
        <div class="border rounded p-2 mb-2 reassign-handover-item" data-item-name="${safeName}">
          <div class="mb-2">
            <strong>${safeName}</strong>
            <div class="form-check mt-1 mb-2">
              <input class="form-check-input reassign-delivered" type="radio" name="reassign_delivery_${idx}" id="reassign_delivered_yes_${idx}" value="yes" checked>
              <label class="form-check-label" for="reassign_delivered_yes_${idx}">✓ Sağlam Teslim Edildi</label>
            </div>
            <div class="form-check">
              <input class="form-check-input reassign-delivered-no" type="radio" name="reassign_delivery_${idx}" id="reassign_delivered_no_${idx}" value="no">
              <label class="form-check-label" for="reassign_delivered_no_${idx}">✗ Teslim Edilmedi</label>
            </div>
          </div>
          <div class="reassign-problem" style="display:none; padding-top: 10px; border-top: 1px solid #dee2e6;">
            <label class="form-label form-label-sm">Sorun Türü *</label>
            <select class="form-select form-select-sm reassign-tag mb-2">
              <option value="">Seçin</option>
              <option value="eksik">Eksik</option>
              <option value="arizali">Arızalı</option>
              <option value="kirik">Kırık</option>
              <option value="calismiyor">Çalışmıyor</option>
              <option value="kayip">Kayıp</option>
              <option value="diger">Diğer</option>
            </select>
            <label class="form-label form-label-sm">Açıklama</label>
            <textarea class="form-control form-control-sm reassign-description" rows="2" placeholder="Opsiyonel açıklama..."></textarea>
          </div>
        </div>
      `;
    }).join('');
  }

  function applyReassignIssueDefaults(roomId) {
    section.querySelectorAll('.reassign-handover-item').forEach(itemEl => {
      const itemName = itemEl.getAttribute('data-item-name') || '';
      const issue = getOpenIssue(roomId, itemName);
      const yesRadio = itemEl.querySelector('.reassign-delivered[value="yes"]');
      const noRadio = itemEl.querySelector('.reassign-delivered-no[value="no"]');
      const problem = itemEl.querySelector('.reassign-problem');
      const tag = itemEl.querySelector('.reassign-tag');
      const desc = itemEl.querySelector('.reassign-description');

      if (issue) {
        if (noRadio) noRadio.checked = true;
        if (problem) problem.style.display = 'block';
        if (tag) tag.value = issue.tag || '';
        if (desc) desc.value = issue.description || '';
      } else {
        if (yesRadio) yesRadio.checked = true;
        if (problem) problem.style.display = 'none';
        if (tag) tag.value = '';
        if (desc) desc.value = '';
      }
    });
  }

  async function resolveRoomIssueInBackground(roomId, itemName) {
    const response = await fetch(`/odalar/${roomId}/demirbas-sorun-coz`, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      },
      body: JSON.stringify({ item_name: itemName })
    });

    const payload = await response.json().catch(() => ({}));
    if (!response.ok || !payload.ok) {
      throw new Error(payload.error || 'Sorun kaydı çözümlenirken hata oluştu.');
    }
  }

  function toggleSection() {
    if (roomSelect.value) {
      section.style.display = 'block';
      renderReassignItems(roomSelect.value);
      applyReassignIssueDefaults(roomSelect.value);
      pendingIssueResolution = null;
    } else {
      section.style.display = 'none';
      payloadInput.value = '';
      itemsContainer.innerHTML = '';
      pendingIssueResolution = null;
    }
  }

  roomSelect.addEventListener('change', toggleSection);
  toggleSection();

  section.addEventListener('change', (e) => {
    const t = e.target;
    if (!t) return;

    if (t.classList.contains('reassign-delivered-no')) {
      const item = t.closest('.reassign-handover-item');
      const problem = item ? item.querySelector('.reassign-problem') : null;
      if (problem) problem.style.display = t.checked ? 'block' : 'none';
    }

    if (t.classList.contains('reassign-delivered') && t.value === 'yes' && t.checked) {
      const item = t.closest('.reassign-handover-item');
      const problem = item ? item.querySelector('.reassign-problem') : null;
      const itemName = item ? (item.getAttribute('data-item-name') || '').trim() : '';
      const issue = getOpenIssue(roomSelect.value, itemName);

      if (!issue) {
        if (problem) problem.style.display = 'none';
        return;
      }

      const noRadio = item ? item.querySelector('.reassign-delivered-no[value="no"]') : null;
      const confirmed = window.confirm('Bu demirbaş için açık sorun kaydı var. Sağlam teslim edildi olarak işaretlerseniz ilgili sorun çözüldü kabul edilecektir. Onaylıyor musunuz?');
      if (!confirmed) {
        if (noRadio) noRadio.checked = true;
        if (problem) problem.style.display = 'block';
        return;
      }

      pendingIssueResolution = { roomId: roomSelect.value, itemName };
      resolveRoomIssueInBackground(roomSelect.value, itemName)
        .then(() => {
          if (!pendingIssueResolution || pendingIssueResolution.roomId !== roomSelect.value) {
            console.log('Ignoring stale issue resolution (room changed)');
            return;
          }
          try {
            const roomIssues = roomOpenIssueMap[String(roomSelect.value)] || {};
            delete roomIssues[normalizeName(itemName)];
            roomOpenIssueMap[String(roomSelect.value)] = roomIssues;
            if (problem) problem.style.display = 'none';
            const tag = item ? item.querySelector('.reassign-tag') : null;
            const desc = item ? item.querySelector('.reassign-description') : null;
            if (tag) tag.value = '';
            if (desc) desc.value = '';
          } catch (domErr) {
            console.error('Sorun kaydı çöz sonrası UI güncelleme hatası:', domErr);
          }
          pendingIssueResolution = null;
        })
        .catch((err) => {
          if (!pendingIssueResolution || pendingIssueResolution.roomId !== roomSelect.value) {
            console.log('Ignoring stale issue resolution error (room changed)');
            pendingIssueResolution = null;
            return;
          }
          try {
            if (noRadio && noRadio !== t) noRadio.checked = true;
            if (problem) problem.style.display = 'block';
            alert(err.message || 'Sorun kaydı çözümlenirken hata oluştu.');
          } catch (cleanupErr) {
            console.error('Error cleanup failed:', cleanupErr);
            alert('Sorun kaydı çözümlenirken hata oluştu.');
          }
          pendingIssueResolution = null;
        });
    }
  });

  reassignForm.addEventListener('submit', (e) => {
    if (!roomSelect.value) return;

    const formSigned = document.getElementById('reassignFormSignedCheck');
    const keyDelivered = document.getElementById('reassignKeyDeliveredCheck');

    if (!formSigned || !formSigned.checked) {
      e.preventDefault();
      alert('Oda tahsisi için zimmet formu imzası zorunludur.');
      return;
    }

    const items = [];
    let invalid = false;
    section.querySelectorAll('.reassign-handover-item').forEach(itemEl => {
      const name = itemEl.getAttribute('data-item-name') || '';
      const selected = itemEl.querySelector('input[type="radio"]:checked');
      if (!selected) {
        invalid = true;
        return;
      }

      const delivered = selected.value === 'yes';
      const tag = (itemEl.querySelector('.reassign-tag')?.value || '').trim();
      const description = (itemEl.querySelector('.reassign-description')?.value || '').trim();
      if (!delivered && !tag) invalid = true;

      items.push({
        name,
        delivered,
        tag: delivered ? null : tag,
        description: delivered ? null : (description || null)
      });
    });

    if (invalid) {
      e.preventDefault();
      alert('Tüm demirbaşlar seçilmeli; teslim edilmeyenler için sorun türü zorunludur.');
      return;
    }

    payloadInput.value = JSON.stringify({ items });
  });
})();
</script>

