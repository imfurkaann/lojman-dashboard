<%- include('../layout', { title: `${person.first_name} ${person.last_name}` }) %>

<%
const defaultDepartmentOptions = [
  'Gece Denetimi',
  'Güvenlik',
  'Steward',
  'Bar',
  'Restaurant',
  'Houskeeping',
  'Meydan',
  'Önbüro',
  'Satış Pazarlama',
  'Housekeeping',
  'Resepsiyon',
  'Ön Büro',
  'Teknik Servis',
  'Kat Hizmetleri',
  'Yiyecek & İçecek',
  'Mutfak',
  'Muhasebe',
  'İnsan Kaynakları',
  'Satış & Pazarlama',
  'Çamaşırhane',
  'Bellboy'
];
const departmentOptions = Array.from(new Set([...defaultDepartmentOptions, ...(person.department ? [person.department] : [])]))
  .sort((a, b) => a.localeCompare(b, 'tr'));
%>

<style>
  .person-info-table td {
    padding-top: 0.35rem;
    padding-bottom: 0.35rem;
    vertical-align: middle;
  }

  .person-info-label {
    width: 28%;
    white-space: nowrap;
  }

  .delivery-note-inline {
    margin-left: 0.5rem;
    font-size: 0.8rem;
    color: #6c757d;
  }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <a href="javascript:history.back();" class="text-decoration-none text-muted"><i class="bi bi-arrow-left"></i> Geri Dön</a>
    <h4 class="mt-1 mb-0">
      <i class="bi bi-person"></i> <%= person.first_name %> <%= person.last_name %>
      <% if (person.status === 'aktif') { %>
        <span class="badge bg-success fs-6">Aktif</span>
      <% } else if (person.status === 'bosta') { %>
        <span class="badge bg-warning text-dark fs-6">Boşta</span>
      <% } else { %>
        <span class="badge bg-secondary fs-6">Çıkış Yapmış</span>
      <% } %>
    </h4>
  </div>
  <div>
    <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#editPersonModal">
      <i class="bi bi-pencil"></i> Düzenle
    </button>
    <% if (person.status === 'aktif') { %>
      <button class="btn btn-outline-warning btn-sm" data-bs-toggle="modal" data-bs-target="#changeRoomModal">
        <i class="bi bi-arrow-left-right"></i> Oda Değiştir
      </button>
      <button class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#checkoutModal">
        <i class="bi bi-box-arrow-right"></i> Çıkış Yap
      </button>
    <% } else { %>
      <button class="btn btn-outline-success btn-sm" data-bs-toggle="modal" data-bs-target="#changeRoomModal">
        <i class="bi bi-house-add"></i> Oda Ver
      </button>
    <% } %>

    <form method="POST" action="/personel/<%= person.id %>/sil" class="d-inline" onsubmit="return confirm('Bu personeli tamamen silmek istediğinize emin misiniz? Bu işlem geri alınamaz.')">
      <button type="submit" class="btn btn-outline-danger btn-sm"><i class="bi bi-trash"></i> Sil</button>
    </form>
  </div>
</div>

<%
  const entryItems = entryHandoverItems || [];
  const checkoutItems = checkoutHandoverItems || [];
  const registrationDateSource = person.created_at || person.check_in_date;
  const registrationDate = registrationDateSource
    ? new Date(registrationDateSource).toLocaleDateString('tr-TR')
    : '-';
%>

<!-- Personel Tabs -->
<ul class="nav nav-tabs mb-3" role="tablist">
  <li class="nav-item">
    <a class="nav-link active" data-bs-toggle="tab" href="#kisisel-bilgi">
      <i class="bi bi-person-vcard"></i> Kişisel Bilgi
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-bs-toggle="tab" href="#teslimatlar">
      <i class="bi bi-clipboard-check"></i> Giriş / Çıkış Teslimat
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-bs-toggle="tab" href="#sikayetler">
      <i class="bi bi-chat-dots"></i> Şikayetler (<%= complaints.length %>)
    </a>
  </li>
  <li class="nav-item">
    <a class="nav-link" data-bs-toggle="tab" href="#gecmis">
      <i class="bi bi-clock-history"></i> Geçmiş (<%= (personRoomHistory || []).length %>)
    </a>
  </li>
</ul>

<div class="tab-content mb-4">
  <div class="tab-pane fade show active" id="kisisel-bilgi">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-person-vcard"></i> Kişisel Bilgiler</h6></div>
      <div class="card-body">
        <% if (person.photo_path) { %>
          <div class="text-center mb-3">
            <img src="<%= person.photo_path %>" alt="Personel Fotoğraf" class="rounded" style="max-height: 220px; max-width: 100%; object-fit: cover;">
          </div>
        <% } %>
        <table class="table table-borderless table-sm mb-0 person-info-table">
          <tr><td class="text-muted person-info-label">Ad Soyad</td><td><strong><%= person.first_name %> <%= person.last_name %></strong></td></tr>
          <tr><td class="text-muted person-info-label">Cinsiyet</td><td><%= person.gender === 'erkek' ? 'Erkek' : 'Kadın' %></td></tr>
          <tr><td class="text-muted person-info-label">Sicil Numarası</td><td>
            <% 
              const tcDisplay = person.tc_last_four 
                ? '*'.repeat(Math.max(0, 11 - 4)) + person.tc_last_four  // TC kimlik 11 haneli, son 4 hane + 7 adet ****
                : '-';
            %>
            <span class="font-monospace" style="letter-spacing: 2px;">
              <strong><%= tcDisplay %></strong>
            </span>
          </td></tr>
          <tr><td class="text-muted person-info-label">Telefon</td><td><%= person.phone || '-' %></td></tr>
          <tr><td class="text-muted person-info-label">Departman</td><td><%= person.department || '-' %></td></tr>
          <tr><td class="text-muted person-info-label">Oda</td><td>
            <% if (person.room_number) { %>
              <a href="/odalar/<%= person.room_id %>"><span class="badge bg-primary fs-6" id="oda-bilgisi"><%= person.room_number %></span></a>
            <% } else { %>
              <span class="text-muted" id="oda-bilgisi">Atanmamış</span>
            <% } %>
          </td></tr>
          <tr><td class="text-muted person-info-label">Durum</td><td>
            <% if (person.status === 'aktif') { %>
              <span class="badge bg-success">Aktif</span>
            <% } else if (person.status === 'bosta') { %>
              <span class="badge bg-warning text-dark">Boşta</span>
            <% } else { %>
              <span class="badge bg-secondary">Çıkış Yapmış</span>
            <% } %>
          </td></tr>
          <tr><td class="text-muted person-info-label">Kayıt Tarihi</td><td><%= registrationDate %></td></tr>
          <tr><td class="text-muted person-info-label">Giriş Tarihi</td><td><%= person.check_in_date ? new Date(person.check_in_date).toLocaleDateString('tr-TR') : '-' %></td></tr>
          <% if (person.check_out_date) { %>
          <tr><td class="text-muted person-info-label">Çıkış Tarihi</td><td><%= new Date(person.check_out_date).toLocaleDateString('tr-TR') %></td></tr>
          <% } %>
          <tr><td class="text-muted person-info-label">Zimmet Formu</td><td>
            <% if (person.form_signed) { %>
              <span class="badge bg-success">İmzalı</span>
            <% } else { %>
              <span class="badge bg-warning text-dark">İmzasız</span>
            <% } %>
          </td></tr>
        </table>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="teslimatlar">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white"><h6 class="mb-0"><i class="bi bi-clipboard-check"></i> Giriş ve Çıkış Teslimatları</h6></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <h6 class="mb-2"><i class="bi bi-box-arrow-in-right"></i> Giriş Teslimatları</h6>

            <div class="border rounded p-2 mb-2">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong>Oda Anahtarı</strong>
                  <span class="delivery-note-inline">Teslim durumu</span>
                </div>
                <div>
                  <% if (person.key_delivered) { %>
                    <span class="badge bg-success">Teslim Edildi</span>
                  <% } else { %>
                    <span class="badge bg-warning text-dark">Teslim Edilmedi</span>
                  <% } %>
                </div>
              </div>
            </div>

            <% if (entryItems.length === 0) { %>
              <div class="text-muted small">Demirbaş teslim bilgisi yok.</div>
            <% } else { %>
              <% entryItems.forEach(it => { %>
                <div class="border rounded p-2 mb-2">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong><%= it.name %></strong>
                      <% if (it.delivered) { %>
                        <span class="delivery-note-inline">Sağlam teslim edildi</span>
                      <% } else { %>
                        <span class="delivery-note-inline">Teslim edilmedi</span>
                      <% } %>
                    </div>
                    <div>
                      <% if (it.delivered) { %>
                        <span class="badge bg-success">✓</span>
                      <% } else { %>
                        <span class="badge bg-danger">✗</span>
                      <% } %>
                    </div>
                  </div>
                  <% if (!it.delivered) { %>
                    <div class="mt-2 small">
                      <div><span class="text-muted">Sorun:</span> <strong><%= (it.tag || '-') %></strong></div>
                      <div class="text-muted" style="white-space: pre-wrap;"><%= (it.description || '-') %></div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            <% } %>
          </div>

          <div class="col-md-6">
            <h6 class="mb-2"><i class="bi bi-box-arrow-right"></i> Çıkış Teslim Bilgileri</h6>

            <% if (person.status !== 'cikis_yapti' && checkoutItems.length === 0) { %>
              <div class="text-muted small">Henüz çıkış teslim kaydı yok.</div>
            <% } %>

            <% if (person.status === 'cikis_yapti') { %>
              <div class="border rounded p-2 mb-2">
                <div class="d-flex justify-content-between align-items-center">
                  <div>
                    <strong>Oda Anahtarı</strong>
                    <span class="delivery-note-inline">Çıkışta teslim alma durumu</span>
                  </div>
                  <div>
                    <% if (Number(person.checkout_key_returned || 0) === 1) { %>
                      <span class="badge bg-success">Teslim Alındı</span>
                    <% } else { %>
                      <span class="badge bg-danger">Teslim Alınmadı</span>
                    <% } %>
                  </div>
                </div>
              </div>
            <% } %>

            <% if (checkoutItems.length === 0) { %>
              <div class="text-muted small">Çıkış teslim kaydı bulunamadı.</div>
            <% } else { %>
              <% checkoutItems.forEach(it => { %>
                <div class="border rounded p-2 mb-2">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <strong><%= it.name %></strong>
                      <% if (it.delivered) { %>
                        <span class="delivery-note-inline">Teslim edildi</span>
                      <% } else { %>
                        <span class="delivery-note-inline">Teslim edilmedi</span>
                      <% } %>
                    </div>
                    <div>
                      <% if (it.delivered) { %>
                        <span class="badge bg-success">Teslim Edildi</span>
                      <% } else { %>
                        <span class="badge bg-danger">Teslim Edilmedi</span>
                      <% } %>
                    </div>
                  </div>
                  <% if (!it.delivered) { %>
                    <div class="mt-2 small">
                      <div><span class="text-muted">Sorun:</span> <strong><%= it.tag || '-' %></strong></div>
                      <div class="text-muted" style="white-space: pre-wrap;"><%= it.description || '-' %></div>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="sikayetler">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-chat-dots"></i> Şikayetler (<%= complaints.length %>)</h6>
        <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#addComplaintModal">
          <i class="bi bi-plus-lg"></i> Ekle
        </button>
      </div>
      <div class="card-body p-0">
        <% if (complaints.length === 0) { %>
          <div class="text-center text-muted py-4">Şikayet kaydı yok</div>
        <% } else { %>
          <div class="list-group list-group-flush">
            <% complaints.forEach(c => { %>
            <div class="list-group-item">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <strong><%= c.title %></strong>
                  <% if (c.description) { %>
                    <p class="text-muted small mb-1"><%= c.description %></p>
                  <% } %>
                  <small class="text-muted">
                    <i class="bi bi-calendar"></i> Açılış: <%= new Date(c.created_at).toLocaleDateString('tr-TR') %>
                  </small>
                </div>
                <div class="d-flex gap-2">
                  <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editComplaintModal_<%= c.id %>">
                    <i class="bi bi-pencil"></i> Düzenle
                  </button>
                  <form method="POST" action="/personel/<%= person.id %>/sikayet/<%= c.id %>/sil" onsubmit="return confirm('Bu şikayet kaydını silmek istediğinize emin misiniz?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Sil</button>
                  </form>
                </div>
              </div>

              <div class="modal fade" id="editComplaintModal_<%= c.id %>" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <form method="POST" action="/personel/<%= person.id %>/sikayet/<%= c.id %>/duzenle">
                      <div class="modal-header">
                        <h5 class="modal-title">Şikayet Düzenle</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                      </div>
                      <div class="modal-body">
                        <div class="mb-3">
                          <label class="form-label">Başlık *</label>
                          <input type="text" class="form-control" name="title" value="<%= c.title %>" required>
                        </div>
                        <div class="mb-3">
                          <label class="form-label">Açıklama</label>
                          <textarea class="form-control" name="description" rows="3"><%= c.description || '' %></textarea>
                        </div>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="btn btn-primary">Kaydet</button>
                      </div>
                    </form>
                  </div>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <div class="tab-pane fade" id="gecmis">
    <div class="card border-0 shadow-sm">
      <div class="card-header bg-white">
        <h6 class="mb-0"><i class="bi bi-clock-history"></i> Oda Geçmişi</h6>
      </div>
      <div class="card-body p-0">
        <% if (!personRoomHistory || personRoomHistory.length === 0) { %>
          <div class="text-center text-muted py-4">Bu personel için oda geçmişi yok</div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Oda</th>
                  <th>Giriş Tarihi</th>
                  <th>Çıkış Tarihi</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% personRoomHistory.forEach(h => { %>
                  <tr>
                    <td>
                      <% if (h.room_id) { %>
                        <a href="/odalar/<%= h.room_id %>" class="badge bg-primary text-decoration-none"><%= h.room_number || '-' %></a>
                      <% } else { %>
                        -
                      <% } %>
                    </td>
                    <td><%= h.entry_at ? new Date(h.entry_at).toLocaleString('tr-TR') : '-' %></td>
                    <td><%= h.exit_at ? new Date(h.exit_at).toLocaleString('tr-TR') : '-' %></td>
                    <td>
                      <% if (h.room_id) { %>
                        <a href="/odalar/<%= h.room_id %>" class="btn btn-sm btn-outline-primary" title="Oda Detayı">
                          <i class="bi bi-eye"></i>
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Personel Düzenle Modal -->
<div class="modal fade" id="editPersonModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="POST" action="/personel/<%= person.id %>/guncelle" enctype="multipart/form-data" id="editPersonnelForm">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil"></i> Personel Düzenle</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" style="max-height: 600px; overflow-y: auto;">
          <div class="row g-3">
            <div class="col-6">
              <label class="form-label">Ad *</label>
              <input type="text" class="form-control" name="first_name" value="<%= person.first_name %>" required>
            </div>
            <div class="col-6">
              <label class="form-label">Soyad *</label>
              <input type="text" class="form-control" name="last_name" value="<%= person.last_name %>" required>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-6">
              <label class="form-label">Cinsiyet *</label>
              <select class="form-select" name="gender" required>
                <option value="">Seçin</option>
                <option value="erkek" <%= person.gender === 'erkek' ? 'selected' : '' %>>Erkek</option>
                <option value="kadin" <%= person.gender === 'kadin' ? 'selected' : '' %>>Kadın</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label">TC Kimlik No</label>
              <input type="text" class="form-control" name="tc_number" value="" placeholder="Değiştirmek için yeni 11 haneli TC girin" maxlength="11" pattern="[0-9]{11}">
              <small class="text-muted">Boş bırakırsanız mevcut TC değeri korunur<% if (person.tc_last_four) { %> (mevcut: ******<%= person.tc_last_four %>)<% } %>.</small>
            </div>
          </div>

          <div class="row g-3 mt-1">
            <div class="col-6">
              <label class="form-label">Telefon</label>
              <input type="text" class="form-control" name="phone" value="<%= person.phone || '' %>" placeholder="05XX XXX XXXX">
            </div>
            <div class="col-6">
              <label class="form-label">Departman</label>
              <% const editDepartmentValue = person.department || ''; %>
              <% const editDepartmentInOptions = departmentOptions.includes(editDepartmentValue); %>
              <select class="form-select" id="editDepartmentSelect">
                <option value="">Departman seçin</option>
                <% departmentOptions.forEach(dep => { %>
                  <option value="<%= dep %>" <%= editDepartmentValue === dep ? 'selected' : '' %>><%= dep %></option>
                <% }) %>
                <option value="__manual__" <%= editDepartmentValue && !editDepartmentInOptions ? 'selected' : '' %>>El ile gir...</option>
              </select>
              <input type="text" class="form-control mt-2 <%= editDepartmentValue && !editDepartmentInOptions ? '' : 'd-none' %>" id="editDepartmentInput" name="department" value="<%= editDepartmentValue && !editDepartmentInOptions ? editDepartmentValue : '' %>" placeholder="Departman yazın">
            </div>
          </div>

          <div class="mb-3 mt-3">
            <label class="form-label">Fotoğraf</label>
            
            <% if (person.photo_path) { %>
              <div class="text-center mb-3">
                <img src="<%= person.photo_path %>" alt="Personel Fotoğraf" class="rounded" style="max-height: 200px; max-width: 100%; object-fit: cover;">
                <p class="text-muted small mt-2">Mevcut Fotoğraf</p>
              </div>
            <% } %>
            
            <button type="button" class="btn btn-outline-primary w-100" id="editAddPhotoBtn">
              <i class="bi bi-camera"></i> <%= person.photo_path ? 'Fotoğrafı Değiştir' : 'Fotoğraf Ekle' %>
            </button>

            <div id="editPhotoOptions" class="mt-2" style="display:none;">
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary flex-fill" id="editChooseCameraBtn">
                  <i class="bi bi-camera-video"></i> Çek
                </button>
                <button type="button" class="btn btn-outline-secondary flex-fill" id="editChooseUploadBtn">
                  <i class="bi bi-upload"></i> Yükle
                </button>
              </div>

              <div class="mt-2" id="editCameraInputWrap" style="display:none;">
                <div class="border rounded p-2">
                  <video id="editCameraPreview" class="w-100 rounded" autoplay playsinline style="max-height: 260px; background:#000; transform: scaleX(-1);"></video>
                  <img id="editCapturedPreview" class="w-100 rounded" alt="Çekilen fotoğraf" style="display:none; max-height: 260px; object-fit: contain;">
                  <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-primary flex-fill" id="editTakePhotoBtn">
                      <i class="bi bi-camera"></i> Fotoğraf Çek
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="editStopCameraBtn" disabled>
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </div>
                  <small class="text-muted d-block mt-2">İlk kullanımda kamera izni isteyebilir.</small>
                </div>
                <input type="hidden" name="captured_photo" id="editCapturedPhotoFlag" value="0">
                <input type="hidden" name="captured_photo_data" id="editCapturedPhotoData" value="">
              </div>

              <div class="mt-2" id="editUploadInputWrap" style="display:none;">
                <input type="file" class="form-control" id="editUploadPhotoInput" name="photo" accept="image/jpeg,image/png,image/gif,image/*">
                <small class="text-muted">JPEG, PNG, GIF (Max 5MB)</small>
              </div>

              <small class="text-muted d-block mt-1">Max 5MB</small>
            </div>
          </div>

          <div class="border rounded p-3 mt-3">
            <h6 class="mb-3"><i class="bi bi-clipboard-check"></i> Zimmet Bilgileri</h6>

            <div class="border rounded p-2 mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong>Zimmet Formu</strong>
                  <small class="text-muted d-block">İmzalandı mı?</small>
                </div>
                <div class="form-check m-0">
                  <input class="form-check-input" type="checkbox" id="editFormSignedCheck" name="form_signed" <%= person.form_signed ? 'checked' : '' %>>
                  <label class="form-check-label" for="editFormSignedCheck">Evet</label>
                </div>
              </div>
            </div>

            <div class="border rounded p-2">
              <div class="d-flex justify-content-between align-items-center">
                <div>
