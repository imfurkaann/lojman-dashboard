<%- include('../footer') %>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>

<script>
const roomInventoryMap = <%- JSON.stringify(roomInventoryMap || {}) %>;
const roomInventoryItemsMap = <%- JSON.stringify(roomInventoryItemsMap || {}) %>;
const roomKeyLimitMap = <%- JSON.stringify(roomKeyLimitMap || {}) %>;
const roomOpenIssueMap = <%- JSON.stringify(roomOpenIssueMap || {}) %>;
const roomSelectForHandover = document.getElementById('roomSelectForHandover');
const handoverSection = document.getElementById('handoverSection');
const handoverPayloadInput = document.getElementById('handoverPayloadInput');
const keyCountInfo = document.getElementById('keyCountInfo');
const assignRoomModalEl = document.getElementById('assignRoomModal');
const assignRoomForm = document.getElementById('assignRoomForm');
const assignRoomSelect = document.getElementById('assignRoomSelect');
const assignHandoverSection = document.getElementById('assignHandoverSection');
const assignHandoverPayloadInput = document.getElementById('assignHandoverPayloadInput');
const assignKeyCountInfo = document.getElementById('assignKeyCountInfo');

const addPhotoBtn = document.getElementById('addPhotoBtn');
const photoOptions = document.getElementById('photoOptions');
const chooseCameraBtn = document.getElementById('chooseCameraBtn');
const chooseUploadBtn = document.getElementById('chooseUploadBtn');
const cameraInputWrap = document.getElementById('cameraInputWrap');
const uploadInputWrap = document.getElementById('uploadInputWrap');
const uploadPhotoInput = document.getElementById('uploadPhotoInput');
const cameraPreview = document.getElementById('cameraPreview');
const capturedPreview = document.getElementById('capturedPreview');
const takePhotoBtn = document.getElementById('takePhotoBtn');
const stopCameraBtn = document.getElementById('stopCameraBtn');
const capturedPhotoFlag = document.getElementById('capturedPhotoFlag');
const capturedPhotoData = document.getElementById('capturedPhotoData');
const personnelFilterForm = document.getElementById('personnelFilterForm');
const personnelSearchInput = document.getElementById('personnelSearchInput');
const createdAtRange = document.getElementById('createdAtRange');
const checkInRange = document.getElementById('checkInRange');
const checkOutRange = document.getElementById('checkOutRange');

function setupDateRangePicker(inputEl, fromHiddenElId, toHiddenElId) {
  if (!inputEl) return;
  const fromHiddenEl = document.getElementById(fromHiddenElId);
  const toHiddenEl = document.getElementById(toHiddenElId);
  if (!fromHiddenEl || !toHiddenEl) return;

  const defaultDates = [];
  if (fromHiddenEl.value) defaultDates.push(fromHiddenEl.value);
  if (toHiddenEl.value) defaultDates.push(toHiddenEl.value);

  const picker = flatpickr(inputEl, {
    mode: 'range',
    dateFormat: 'Y-m-d',
    locale: (flatpickr && flatpickr.l10ns && flatpickr.l10ns.tr) ? flatpickr.l10ns.tr : 'tr',
    defaultDate: defaultDates,
    onChange: (selectedDates) => {
      if (!selectedDates || selectedDates.length === 0) {
        fromHiddenEl.value = '';
        toHiddenEl.value = '';
        return;
      }

      fromHiddenEl.value = selectedDates[0] ? flatpickr.formatDate(selectedDates[0], 'Y-m-d') : '';
      toHiddenEl.value = selectedDates[1] ? flatpickr.formatDate(selectedDates[1], 'Y-m-d') : '';
    }
  });

  // Tek tarih seçilip bırakılırsa da başlangıç/bitiş aynı tarih olsun.
  inputEl.addEventListener('blur', () => {
    if (fromHiddenEl.value && !toHiddenEl.value) {
      toHiddenEl.value = fromHiddenEl.value;
      if (picker) picker.setDate([fromHiddenEl.value, fromHiddenEl.value], false);
    }
  });
}

if (typeof flatpickr !== 'undefined') {
  setupDateRangePicker(createdAtRange, 'createdAtFromHidden', 'createdAtToHidden');
  setupDateRangePicker(checkInRange, 'checkInFromHidden', 'checkInToHidden');
  setupDateRangePicker(checkOutRange, 'checkOutFromHidden', 'checkOutToHidden');
}

if (personnelFilterForm && personnelSearchInput) {
  let searchDebounceTimer = null;

  personnelSearchInput.addEventListener('input', () => {
    if (searchDebounceTimer) {
      clearTimeout(searchDebounceTimer);
    }

    searchDebounceTimer = setTimeout(() => {
      personnelFilterForm.submit();
    }, 250);
  });
}

let cameraStream = null;
let capturedBlob = null;

function setTakeButtonLabel() {
  if (!takePhotoBtn) return;
  if (cameraStream) {
    takePhotoBtn.innerHTML = '<i class="bi bi-camera"></i> Çek';
  } else {
    takePhotoBtn.innerHTML = '<i class="bi bi-camera"></i> Fotoğraf Çek';
  }
}

function clearCapturedPreview() {
  capturedBlob = null;
  if (capturedPhotoFlag) capturedPhotoFlag.value = '0';
  if (capturedPhotoData) capturedPhotoData.value = '';
  if (capturedPreview) {
    capturedPreview.style.display = 'none';
    capturedPreview.src = '';
  }
  if (cameraPreview) cameraPreview.style.display = 'block';
}

function showCameraInput() {
  if (uploadPhotoInput) uploadPhotoInput.value = '';
  if (cameraInputWrap) cameraInputWrap.style.display = 'block';
  if (uploadInputWrap) uploadInputWrap.style.display = 'none';
  if (capturedPreview) {
    capturedPreview.style.display = 'none';
    capturedPreview.src = '';
  }
  if (cameraPreview) cameraPreview.style.display = 'block';
}

function showUploadInput() {
  stopCamera();
  if (uploadInputWrap) uploadInputWrap.style.display = 'block';
  if (cameraInputWrap) cameraInputWrap.style.display = 'none';
}

async function startCamera() {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    alert('Bu tarayıcı kamera erişimini desteklemiyor.');
    return;
  }
  try {
    const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
    cameraStream = stream;
    if (cameraPreview) {
      cameraPreview.style.display = 'block';
      cameraPreview.srcObject = stream;
      await cameraPreview.play();
    }
    if (capturedPreview) {
      capturedPreview.style.display = 'none';
      capturedPreview.src = '';
    }
    if (stopCameraBtn) stopCameraBtn.disabled = false;
    setTakeButtonLabel();
  } catch (e) {
    console.error('Kamera açılamadı:', e);
    alert('Kamera açılamadı. Tarayıcı izinlerini kontrol edin.');
  }
}

function stopCamera() {
  if (cameraStream) {
    cameraStream.getTracks().forEach(t => t.stop());
    cameraStream = null;
  }
  if (cameraPreview) cameraPreview.srcObject = null;
  // Keep X usable for clearing / reset even after capture
  if (stopCameraBtn) stopCameraBtn.disabled = false;
  setTakeButtonLabel();
}

function takeSnapshot() {
  if (!cameraPreview) return;
  const canvas = document.createElement('canvas');
  const w = cameraPreview.videoWidth || 640;
  const h = cameraPreview.videoHeight || 480;
  canvas.width = w;
  canvas.height = h;
  const ctx = canvas.getContext('2d');
  // Preview is mirrored for user-facing camera, but we store the unmirrored image.
  ctx.drawImage(cameraPreview, 0, 0, w, h);
  canvas.toBlob((blob) => {
    if (!blob) return;
    capturedBlob = blob;
    if (capturedPhotoData) {
      capturedPhotoData.value = canvas.toDataURL('image/jpeg', 0.9);
    }
    if (capturedPhotoFlag) capturedPhotoFlag.value = '1';
    if (capturedPreview) {
      capturedPreview.src = URL.createObjectURL(blob);
      capturedPreview.style.display = 'block';
      capturedPreview.style.transform = 'scaleX(-1)';
    }
    if (cameraPreview) cameraPreview.style.display = 'none';
    stopCamera();
  }, 'image/jpeg', 0.9);
}

if (addPhotoBtn && photoOptions) {
  addPhotoBtn.addEventListener('click', () => {
    photoOptions.style.display = photoOptions.style.display === 'none' ? 'block' : 'none';
    if (photoOptions.style.display === 'none') {
      if (cameraInputWrap) cameraInputWrap.style.display = 'none';
      if (uploadInputWrap) uploadInputWrap.style.display = 'none';
      if (uploadPhotoInput) uploadPhotoInput.value = '';
      capturedBlob = null;
      if (capturedPhotoFlag) capturedPhotoFlag.value = '0';
      if (capturedPhotoData) capturedPhotoData.value = '';
      stopCamera();
    }
  });
}

// handled below (starts live preview)
if (chooseUploadBtn) chooseUploadBtn.addEventListener('click', showUploadInput);

if (stopCameraBtn) {
  stopCameraBtn.disabled = false;
  stopCameraBtn.addEventListener('click', async () => {
    stopCamera();
    clearCapturedPreview();
    // Auto-reopen live preview for immediate retake
    await startCamera();
  });
}
if (takePhotoBtn) {
  takePhotoBtn.addEventListener('click', async () => {
    // If a previous capture is shown, clear it and start a fresh capture flow
    if (capturedBlob || (capturedPreview && capturedPreview.style.display !== 'none')) {
      clearCapturedPreview();
    }
    // Blue button ONLY takes snapshot; live preview must be started via the grey "Çek" option.
    if (!cameraStream) {
      alert('Önce gri "Çek" butonuyla canlı önizlemeyi başlatın.');
      return;
    }
    takeSnapshot();
  });
}

// Grey option button should start live preview immediately
if (chooseCameraBtn) {
  chooseCameraBtn.addEventListener('click', async () => {
    showCameraInput();
    await startCamera();
  });
}

// If modal closes while camera is on, stop tracks
const addPersonnelModalEl = document.getElementById('addPersonnelModal');
if (addPersonnelModalEl) {
  addPersonnelModalEl.addEventListener('hidden.bs.modal', () => {
    stopCamera();
    capturedBlob = null;
    if (capturedPhotoFlag) capturedPhotoFlag.value = '0';
    if (capturedPhotoData) capturedPhotoData.value = '';
    if (capturedPreview) {
      capturedPreview.style.display = 'none';
      capturedPreview.src = '';
    }
    if (cameraPreview) cameraPreview.style.display = 'block';
  });
}

function getRequiredKeyCountByRoomId(roomId) {
  const value = Number(roomKeyLimitMap[roomId]);
  if (Number.isFinite(value) && value >= 0) return value;
  return 3;
}

function normalizeItemKey(name) {
  return String(name || '').trim().toLocaleLowerCase('tr-TR');
}

function getRoomInventoryItems(roomId) {
  const list = roomInventoryItemsMap[String(roomId)] || roomInventoryItemsMap[roomId] || [];
  return Array.isArray(list) ? list : [];
}

function renderHandoverItems(sectionEl, roomId, radioPrefix, idPrefix) {
  if (!sectionEl) return;
  const container = sectionEl.querySelector('.handover-items-container');
  if (!container) return;

  const roomItems = getRoomInventoryItems(roomId);
  if (!roomItems.length) {
    container.innerHTML = '<div class="text-muted small mb-2">Bu odada teslim kontrolü gerektiren demirbaş bulunmuyor.</div>';
    return;
  }

  container.innerHTML = roomItems.map((itemName, idx) => {
    const safeName = String(itemName || '').replace(/"/g, '&quot;');
    const radioName = `${radioPrefix}${idx}`;
    const yesId = `${idPrefix}_delivered_yes_${idx}`;
    const noId = `${idPrefix}_delivered_no_${idx}`;

    return `
      <div class="border rounded p-2 mb-2 handover-item" data-item-name="${safeName}">
        <div class="mb-2">
          <strong>${safeName}</strong>
          <div class="form-check mt-1 mb-3">
            <input class="form-check-input handover-delivered" type="radio" name="${radioName}" id="${yesId}" value="yes" checked>
            <label class="form-check-label" for="${yesId}">✓ Sağlam Teslim Edildi</label>
          </div>
          <div class="form-check">
            <input class="form-check-input handover-delivered-no" type="radio" name="${radioName}" id="${noId}" value="no">
            <label class="form-check-label" for="${noId}">✗ Teslim Edilmedi</label>
          </div>
        </div>
        <div class="handover-problem" style="display:none; padding-top: 10px; border-top: 1px solid #dee2e6;">
          <div class="mb-2">
            <label class="form-label form-label-sm">Sorun Türü *</label>
            <select class="form-select form-select-sm handover-tag">
              <option value="">Seçin</option>
              <option value="eksik">Eksik</option>
              <option value="arizali">Arızalı</option>
              <option value="kirik">Kırık</option>
              <option value="calismiyor">Çalışmıyor</option>
              <option value="kayip">Kayıp</option>
              <option value="diger">Diğer</option>
            </select>
          </div>
          <div>
            <label class="form-label form-label-sm">Neden Teslim Edilmedi? *</label>
            <textarea class="form-control form-control-sm handover-description" rows="3" placeholder="Sorunu detaylı açıklayın..."></textarea>
          </div>
        </div>
      </div>
    `;
  }).join('');
}

function getOpenIssueForRoomItem(roomId, itemName) {
  const roomIssues = roomOpenIssueMap[String(roomId)] || {};
  const key = normalizeItemKey(itemName);
  return roomIssues[key] || null;
}

function applyOpenIssueDefaults(sectionEl, roomId) {
  if (!sectionEl) return;

  sectionEl.querySelectorAll('.handover-item').forEach((itemEl) => {
    const itemName = itemEl.getAttribute('data-item-name') || '';
    const issue = getOpenIssueForRoomItem(roomId, itemName);

    const yesRadio = itemEl.querySelector('input.handover-delivered[value="yes"]');
    const noRadio = itemEl.querySelector('input.handover-delivered-no[value="no"]');
    const problemBox = itemEl.querySelector('.handover-problem');
    const tagSelect = itemEl.querySelector('.handover-tag');
    const descriptionInput = itemEl.querySelector('.handover-description');

    if (!problemBox || !yesRadio || !noRadio) return;

    if (issue) {
      noRadio.checked = true;
      if (tagSelect) tagSelect.value = issue.tag || '';
      if (descriptionInput) descriptionInput.value = issue.description || '';
      problemBox.style.display = 'block';
    } else {
      yesRadio.checked = true;
      if (tagSelect) tagSelect.value = '';
      if (descriptionInput) descriptionInput.value = '';
      problemBox.style.display = 'none';
    }
  });
}

async function resolveRoomIssueInBackground(roomId, itemName) {
  const response = await fetch(`/odalar/${roomId}/demirbas-sorun-coz`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Accept': 'application/json'
    },
    body: JSON.stringify({ item_name: itemName })
  });

  const payload = await response.json().catch(() => ({}));
  if (!response.ok || !payload.ok) {
    throw new Error(payload.error || 'Sorun kaydı çözümlenirken hata oluştu.');
  }
  return payload;
}

async function handleHealthyOverrideInSection(e, sectionEl, roomId) {
  if (!e.target.classList.contains('handover-delivered')) return;
  if (!(e.target.value === 'yes' && e.target.checked)) return;
  if (!roomId || !sectionEl) return;

  const itemEl = e.target.closest('.handover-item');
  if (!itemEl) return;

  const itemName = (itemEl.getAttribute('data-item-name') || '').trim();
  const issue = getOpenIssueForRoomItem(roomId, itemName);
  if (!issue) return;

  const confirmed = window.confirm('Bu demirbaş için açık sorun kaydı var. Sağlam teslim edildi olarak işaretlerseniz ilgili sorun çözüldü kabul edilecektir. Onaylıyor musunuz?');
  const noRadio = itemEl.querySelector('input.handover-delivered-no[value="no"]');
  const problemBox = itemEl.querySelector('.handover-problem');

  if (!confirmed) {
    if (noRadio) noRadio.checked = true;
    if (problemBox) problemBox.style.display = 'block';
    return;
  }

  try {
    await resolveRoomIssueInBackground(roomId, itemName);
    const roomIssues = roomOpenIssueMap[String(roomId)] || {};
    delete roomIssues[normalizeItemKey(itemName)];
    roomOpenIssueMap[String(roomId)] = roomIssues;

    if (problemBox) problemBox.style.display = 'none';
    const tagSelect = itemEl.querySelector('.handover-tag');
    const descriptionInput = itemEl.querySelector('.handover-description');
    if (tagSelect) tagSelect.value = '';
    if (descriptionInput) descriptionInput.value = '';
  } catch (error) {
    alert(error.message || 'Sorun kaydı çözümlenirken hata oluştu.');
    if (noRadio) noRadio.checked = true;
    if (problemBox) problemBox.style.display = 'block';
  }
}

function updateHandoverSection() {
  const roomId = roomSelectForHandover.value;
  if (!roomId) {
    handoverSection.style.display = 'none';
    handoverPayloadInput.value = '';
    return;
  }
  handoverSection.style.display = 'block';

  renderHandoverItems(handoverSection, roomId, 'delivery_', 'delivery');

  applyOpenIssueDefaults(handoverSection, roomId);

  const requiredKeys = getRequiredKeyCountByRoomId(roomId);
  const inventory = roomInventoryMap[roomId] || {};
  const inHandKeys = inventory['Oda Anahtarı'] || 0;
  keyCountInfo.textContent = `Olması gereken: ${requiredKeys} | Şu an elde: ${inHandKeys}`;
}

roomSelectForHandover.addEventListener('change', updateHandoverSection);

function updateAssignHandoverSection() {
  if (!assignRoomSelect || !assignHandoverSection) return;
  const roomId = assignRoomSelect.value;
  if (!roomId) {
    assignHandoverSection.style.display = 'none';
    if (assignHandoverPayloadInput) assignHandoverPayloadInput.value = '';
    return;
  }

  assignHandoverSection.style.display = 'block';
  renderHandoverItems(assignHandoverSection, roomId, 'assign_delivery_', 'assign_delivery');
  applyOpenIssueDefaults(assignHandoverSection, roomId);

  if (assignKeyCountInfo) {
    const requiredKeys = getRequiredKeyCountByRoomId(roomId);
    const inventory = roomInventoryMap[roomId] || {};
    const inHandKeys = inventory['Oda Anahtarı'] || 0;
    assignKeyCountInfo.textContent = `Olması gereken: ${requiredKeys} | Şu an elde: ${inHandKeys}`;
  }
}

if (assignRoomSelect) {
  assignRoomSelect.addEventListener('change', updateAssignHandoverSection);
}

if (assignRoomModalEl) {
  assignRoomModalEl.addEventListener('show.bs.modal', (event) => {
    if (!assignRoomForm) return;
    const trigger = event.relatedTarget;
    const personnelId = trigger ? trigger.getAttribute('data-personnel-id') : null;
    const personnelName = trigger ? trigger.getAttribute('data-personnel-name') : null;
    const action = trigger ? trigger.getAttribute('data-action') : null;

    assignRoomForm.reset();
    if (personnelName) {
      const nameEl = document.getElementById('assignPersonnelName');
      if (nameEl) nameEl.textContent = personnelName;
    }

    if (action) {
      assignRoomForm.action = action;
    } else if (personnelId) {
      assignRoomForm.action = `/personel/${personnelId}/oda-ata`;
    }

    updateAssignHandoverSection();
  });

  assignRoomModalEl.addEventListener('hidden.bs.modal', () => {
    if (assignRoomForm) assignRoomForm.reset();
    if (assignHandoverSection) assignHandoverSection.style.display = 'none';
    if (assignHandoverPayloadInput) assignHandoverPayloadInput.value = '';
  });
}

// Radio button değişikliğinde sorun formu göster/gizle
async function handleHandoverSectionChange(e, sectionEl, roomId) {
  const t = e.target;
  if (!t || !sectionEl || !roomId) return;

  if (t.classList.contains('handover-delivered-no')) {
    const container = t.closest('.handover-item');
    const problemBox = container ? container.querySelector('.handover-problem') : null;
    if (problemBox) problemBox.style.display = t.checked ? 'block' : 'none';
    return;
  }

  if (t.classList.contains('handover-delivered') && t.value === 'yes' && t.checked) {
    await handleHealthyOverrideInSection(e, sectionEl, roomId);
    const container = t.closest('.handover-item');
    const problemBox = container ? container.querySelector('.handover-problem') : null;
    if (problemBox) problemBox.style.display = 'none';
  }
}

if (handoverSection) {
  handoverSection.addEventListener('change', async (e) => {
    if (!roomSelectForHandover || !roomSelectForHandover.value) return;
    await handleHandoverSectionChange(e, handoverSection, roomSelectForHandover.value);
  });
}

if (assignHandoverSection) {
  assignHandoverSection.addEventListener('change', async (e) => {
    if (!assignRoomSelect || !assignRoomSelect.value) return;
    await handleHandoverSectionChange(e, assignHandoverSection, assignRoomSelect.value);
  });
}

document.querySelector('#addPersonnelModal form').addEventListener('submit', function(e) {
  e.preventDefault();
  
  const roomId = roomSelectForHandover.value;
  
  // Oda seçilmişse handover validasyonları kontrol et
  if (roomId) {
    const items = [];
    let invalid = false;
    handoverSection.querySelectorAll('.handover-item').forEach(itemEl => {
      const name = itemEl.getAttribute('data-item-name');
      const deliveredRadio = itemEl.querySelector('input[type="radio"]:checked');
      const isDelivered = deliveredRadio && deliveredRadio.value === 'yes';
      const tag = (itemEl.querySelector('.handover-tag')?.value || '').trim();
      const description = (itemEl.querySelector('.handover-description')?.value || '').trim();

      // Teslim edilmediyse sorun türü zorunlu; açıklama isteğe bağlı
      if (!isDelivered && !tag) {
        invalid = true;
      }

      items.push({ name, delivered: isDelivered, tag, description });
    });

    if (invalid) {
      alert('Teslim edilmeyen her demirbaş için sorun türü seçilmelidir. Açıklama isteğe bağlıdır.');
      return;
    }

    handoverPayloadInput.value = JSON.stringify({ items });
  } else {
    // Oda seçilmemişse handover payload boş bırak
    handoverPayloadInput.value = '';
  }

  // TC kontrol et
  const tcNumber = document.querySelector('input[name="tc_number"]').value.trim();
  
  const formData = new FormData(this);

  // If user captured via camera, attach as "photo" file
  if (capturedBlob) {
    formData.delete('photo');
    formData.append('photo', new File([capturedBlob], `personel_${Date.now()}.jpg`, { type: 'image/jpeg' }));
  }
  
  // Eğer TC varsa, duplicate kontrol yap
  if (tcNumber) {
    fetch('/personel/ekle', {
      method: 'POST',
      headers: {
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest'
      },
      body: formData
    })
      .then(async r => {
        const contentType = r.headers.get('content-type') || '';
        let body = null;
        if (contentType.includes('application/json')) {
          body = await r.json();
        }
        if (!r.ok) {
          const msg = body && body.error ? body.error : `HTTP ${r.status}`;
          throw new Error(msg);
        }
        if (!body) {
          return { ok: true, redirect: '/personel' };
        }
        return body;
      })
      .then(result => {
        if (result.duplicate && result.existingPerson) {
          // Duplicate bulundu - modal göster
          const duplicateModal = new bootstrap.Modal(document.getElementById('duplicatePersonelModal'), { backdrop: 'static', keyboard: false });
          document.getElementById('existingPersonName').textContent = `${result.existingPerson.first_name} ${result.existingPerson.last_name}`;
          document.getElementById('existingPersonGender').textContent = result.existingPerson.gender === 'erkek' ? 'Erkek' : 'Kadın';
          document.getElementById('existingPersonDept').textContent = result.existingPerson.department || '-';
          document.getElementById('existingPersonPhone').textContent = result.existingPerson.phone || '-';
          
          // Butona tıklanınca sayfasına git
          document.getElementById('goToExistingPerson').onclick = function() {
            window.location.href = `/personel/${result.existingPerson.id}`;
          };
          
          duplicateModal.show();
        } else {
          // Normal redirect
          window.location.href = '/personel';
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('Personel eklenirken hata oluştu: ' + err.message);
      });
  } else {
    // TC yoksa normal submit
    this.submit();
  }
});

if (assignRoomForm) {
  assignRoomForm.addEventListener('submit', function(e) {
    const roomId = assignRoomSelect ? assignRoomSelect.value : '';
    if (!roomId) return;

    const items = [];
    let invalid = false;

    assignHandoverSection.querySelectorAll('.handover-item').forEach(itemEl => {
      const name = itemEl.getAttribute('data-item-name');
      const deliveredRadio = itemEl.querySelector('input[type="radio"]:checked');
      const isDelivered = deliveredRadio && deliveredRadio.value === 'yes';
      const tag = (itemEl.querySelector('.handover-tag')?.value || '').trim();
      const description = (itemEl.querySelector('.handover-description')?.value || '').trim();

      if (!isDelivered && !tag) {
        invalid = true;
      }

      items.push({ name, delivered: isDelivered, tag, description });
    });

    if (invalid) {
      e.preventDefault();
      alert('Teslim edilmeyen her demirbaş için sorun türü seçilmelidir.');
      return;
    }

    if (assignHandoverPayloadInput) {
      assignHandoverPayloadInput.value = JSON.stringify({
        form_signed: !!document.getElementById('assignFormSignedCheck')?.checked,
        key_delivered: !!document.getElementById('assignKeyDeliveredCheck')?.checked,
        items
      });
    }
  });
}
</script>

