<%- include('../layout', { title: 'Personel' }) %>

<%
const defaultDepartmentOptions = [
  'Güvenlik',
  'Housekeeping',
  'Resepsiyon',
  'Ön Büro',
  'Teknik Servis',
  'Kat Hizmetleri',
  'Yiyecek & İçecek',
  'Mutfak',
  'Muhasebe',
  'İnsan Kaynakları',
  'Satış & Pazarlama',
  'Çamaşırhane',
  'Bellboy',
  'Gece Denetimi'
];
const dynamicDepartmentOptions = (departments || []).map(d => d.department).filter(Boolean);
const departmentOptions = Array.from(new Set([...defaultDepartmentOptions, ...dynamicDepartmentOptions]))
  .sort((a, b) => a.localeCompare(b, 'tr'));
%>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="mb-0"><i class="bi bi-people"></i> Personel Yönetimi</h4>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPersonnelModal">
    <i class="bi bi-plus-lg"></i> Yeni Personel Ekle
  </button>
</div>

<% if (errorMessage) { %>
  <div class="alert alert-danger" role="alert"><%= errorMessage %></div>
<% } %>

<!-- Filtre -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body py-2">
    <style>
      .personnel-filters-grid {
        display: grid;
        gap: 0.5rem;
        align-items: end;
        grid-template-columns: minmax(180px, 2.4fr) minmax(130px, 1.3fr) minmax(130px, 1.3fr) minmax(150px, 1.5fr) minmax(150px, 1.5fr) minmax(150px, 1.5fr) auto;
      }

      .personnel-filter-item {
        min-width: 0;
      }

      .personnel-filter-search {
        grid-column: 1;
      }

      .personnel-filter-department,
      .personnel-filter-status {
        grid-column: auto;
      }

      .personnel-filter-date {
        grid-column: auto;
      }

      .personnel-filter-actions {
        grid-column: auto;
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
      }

      .personnel-filter-actions .btn {
        white-space: nowrap;
      }

      @media (max-width: 1199.98px) {
        .personnel-filters-grid {
          grid-template-columns: repeat(6, minmax(0, 1fr));
        }

        .personnel-filter-search {
          grid-column: span 6;
        }

        .personnel-filter-department,
        .personnel-filter-status,
        .personnel-filter-date {
          grid-column: span 3;
        }

        .personnel-filter-actions {
          grid-column: span 12;
          justify-content: flex-end;
        }
      }

      @media (max-width: 767.98px) {
        .personnel-filter-search,
        .personnel-filter-department,
        .personnel-filter-status,
        .personnel-filter-date,
        .personnel-filter-actions {
          grid-column: span 12;
        }

        .personnel-filter-actions {
          justify-content: stretch;
        }

        .personnel-filter-actions .btn {
          flex: 1 1 auto;
        }
      }
    </style>

    <form method="GET" class="personnel-filters-grid" id="personnelFilterForm">
      <div class="personnel-filter-item personnel-filter-search">
        <input type="text" class="form-control form-control-sm" id="personnelSearchInput" name="search" placeholder="İsim veya telefon ara..." value="<%= search %>">
      </div>
      <div class="personnel-filter-item personnel-filter-department">
        <select class="form-select form-select-sm" name="department" onchange="this.form.submit()">
          <option value="">Tüm Departmanlar</option>
          <% departmentOptions.forEach(dep => { %>
            <option value="<%= dep %>" <%= department === dep ? 'selected' : '' %>><%= dep %></option>
          <% }) %>
        </select>
      </div>
      <div class="personnel-filter-item personnel-filter-status">
        <select class="form-select form-select-sm" name="status" onchange="this.form.submit()">
          <option value="" <%= statusFilter === '' ? 'selected' : '' %>>Tümü</option>
          <option value="aktif" <%= statusFilter === 'aktif' ? 'selected' : '' %>>Aktif</option>
          <option value="cikis_yapti" <%= statusFilter === 'cikis_yapti' ? 'selected' : '' %>>Çıkış Yapmış</option>
          <option value="bosta" <%= statusFilter === 'bosta' ? 'selected' : '' %>>Boşta</option>
        </select>
      </div>
      <div class="personnel-filter-item personnel-filter-date">
        <label class="form-label form-label-sm mb-1">Sisteme Kayıt Tarihi</label>
        <input type="text" class="form-control form-control-sm" id="createdAtRange" placeholder="Başlangıç - Bitiş seçin" autocomplete="off">
        <input type="hidden" name="created_at_from" id="createdAtFromHidden" value="<%= createdAtFrom || '' %>">
        <input type="hidden" name="created_at_to" id="createdAtToHidden" value="<%= createdAtTo || '' %>">
      </div>
      <div class="personnel-filter-item personnel-filter-date">
        <label class="form-label form-label-sm mb-1">Odaya Yerleşme Tarihi</label>
        <input type="text" class="form-control form-control-sm" id="checkInRange" placeholder="Başlangıç - Bitiş seçin" autocomplete="off">
        <input type="hidden" name="check_in_from" id="checkInFromHidden" value="<%= checkInFrom || '' %>">
        <input type="hidden" name="check_in_to" id="checkInToHidden" value="<%= checkInTo || '' %>">
      </div>
      <div class="personnel-filter-item personnel-filter-date">
        <label class="form-label form-label-sm mb-1">Odadan Çıkış Tarihi</label>
        <input type="text" class="form-control form-control-sm" id="checkOutRange" placeholder="Başlangıç - Bitiş seçin" autocomplete="off">
        <input type="hidden" name="check_out_from" id="checkOutFromHidden" value="<%= checkOutFrom || '' %>">
        <input type="hidden" name="check_out_to" id="checkOutToHidden" value="<%= checkOutTo || '' %>">
      </div>
      <div class="personnel-filter-item personnel-filter-actions">
        <a href="/personel" class="btn btn-sm btn-outline-secondary">Temizle</a>
        <button type="submit" class="btn btn-sm btn-primary">Filtrele</button>
      </div>
    </form>
  </div>
</div>

<!-- Personel Listesi -->
<div class="card border-0 shadow-sm">
  <div class="card-body p-0">
    <% if (personnel.length === 0) { %>
      <div class="text-center text-muted py-5">
        <i class="bi bi-people fs-1"></i>
        <p class="mt-2">Personel bulunamadı</p>
      </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Ad Soyad</th>
            <th>Cinsiyet</th>
            <th>Departman</th>
            <th>İlk Kayıt</th>
            <th>Oda</th>
            <th>Durum</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% personnel.forEach(p => { %>
          <tr>
            <td>
              <a href="/personel/<%= p.id %>" class="text-decoration-none fw-bold">
                <%= p.first_name %> <%= p.last_name %>
              </a>
            </td>
            <td><%= p.gender === 'erkek' ? 'Erkek' : 'Kadın' %></td>
            <td><%= p.department || '-' %></td>
            <td><%= p.created_at ? new Date(p.created_at).toLocaleDateString('tr-TR') : '-' %></td>
            <td>
              <% if (p.room_number) { %>
                <a href="/odalar/<%= p.room_id %>"><span class="badge bg-primary"><%= p.room_number %></span></a>
              <% } else { %>
                -
              <% } %>
            </td>
            <td>
              <% if (p.status === 'aktif') { %>
                <span class="badge bg-success">Aktif</span>
              <% } else if (p.status === 'bosta') { %>
                <span class="badge bg-warning text-dark">Boşta</span>
              <% } else { %>
                <span class="badge bg-secondary">Çıkış Yapmış</span>
              <% } %>
            </td>
            <td><a href="/personel/<%= p.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<!-- Yeni Personel Ekle Modal -->
<div class="modal fade" id="addPersonnelModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form method="POST" action="/personel/ekle" enctype="multipart/form-data">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-lg"></i> Yeni Personel Ekle</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" style="max-height: 600px; overflow-y: auto;">
          <div class="row g-3">
            <div class="col-6">
              <label class="form-label">Ad *</label>
              <input type="text" class="form-control" name="first_name" required>
            </div>
            <div class="col-6">
              <label class="form-label">Soyad *</label>
              <input type="text" class="form-control" name="last_name" required>
            </div>
          </div>
          <div class="row g-3 mt-1">
            <div class="col-6">
              <label class="form-label">Cinsiyet *</label>
              <select class="form-select" name="gender" required>
                <option value="">Seçin</option>
                <option value="erkek">Erkek</option>
                <option value="kadin">Kadın</option>
              </select>
            </div>
            <div class="col-6">
              <label class="form-label">TC Kimlik No *</label>
              <input type="text" class="form-control" name="tc_number" placeholder="11 haneli TC no" required maxlength="11" pattern="[0-9]{11}">
            </div>
          </div>
          <div class="row g-3 mt-1">
            <div class="col-6">
              <label class="form-label">Telefon</label>
              <input type="text" class="form-control" name="phone" placeholder="05XX XXX XXXX">
            </div>
            <div class="col-6">
              <label class="form-label">Departman</label>
              <select class="form-select" name="department">
                <option value="">Departman Seçin</option>
                <% departmentOptions.forEach(dep => { %>
                  <option value="<%= dep %>"><%= dep %></option>
                <% }) %>
              </select>
            </div>
          </div>
          <div class="mb-3 mt-3">
            <label class="form-label">Fotoğraf</label>
            <button type="button" class="btn btn-outline-primary w-100" id="addPhotoBtn">
              <i class="bi bi-camera"></i> Fotoğraf Ekle
            </button>

            <div id="photoOptions" class="mt-2" style="display:none;">
              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary flex-fill" id="chooseCameraBtn">
                  <i class="bi bi-camera-video"></i> Çek
                </button>
                <button type="button" class="btn btn-outline-secondary flex-fill" id="chooseUploadBtn">
                  <i class="bi bi-upload"></i> Yükle
                </button>
              </div>

              <div class="mt-2" id="cameraInputWrap" style="display:none;">
                <div class="border rounded p-2">
                  <video id="cameraPreview" class="w-100 rounded" autoplay playsinline style="max-height: 260px; background:#000; transform: scaleX(-1);"></video>
                  <img id="capturedPreview" class="w-100 rounded" alt="Çekilen fotoğraf" style="display:none; max-height: 260px; object-fit: contain;">
                  <div class="d-flex gap-2 mt-2">
                    <button type="button" class="btn btn-sm btn-primary flex-fill" id="takePhotoBtn">
                      <i class="bi bi-camera"></i> Fotoğraf Çek
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger" id="stopCameraBtn" disabled>
                      <i class="bi bi-x-lg"></i>
                    </button>
                  </div>
                  <small class="text-muted d-block mt-2">İlk kullanımda kamera izni isteyebilir.</small>
                </div>
                <input type="hidden" name="captured_photo" id="capturedPhotoFlag" value="0">
                <input type="hidden" name="captured_photo_data" id="capturedPhotoData" value="">
              </div>

              <div class="mt-2" id="uploadInputWrap" style="display:none;">
                <input type="file" class="form-control" id="uploadPhotoInput" name="photo" accept="image/jpeg,image/png,image/gif,image/*">
                <small class="text-muted">JPEG, PNG, GIF (Max 5MB)</small>
              </div>

              <small class="text-muted d-block mt-1">Max 5MB</small>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Oda (Opsiyonel)</label>
            <select class="form-select" name="room_id" id="roomSelectForHandover">
              <option value="">Oda Atama</option>
              <% availableRooms.forEach(r => { %>
                <option value="<%= r.id %>">Oda <%= r.room_number %> (<%= r.occupant_count %>/<%= r.capacity %>)</option>
              <% }) %>
            </select>
          </div>

          <div id="handoverSection" class="border rounded p-3" style="display:none;">
            <h6 class="mb-3"><i class="bi bi-clipboard-check"></i> Demirbaş Teslim Kontrolü</h6>

            <div class="border rounded p-2 mb-3">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong>Zimmet Formu</strong>
                  <small class="text-muted d-block">İmzalandı mı?</small>
                </div>
                <div class="form-check m-0">
                  <input class="form-check-input" type="checkbox" id="formSignedCheck" name="form_signed">
                  <label class="form-check-label" for="formSignedCheck">Evet</label>
                </div>
              </div>
            </div>

            <div class="handover-items-container"></div>

            <div class="border rounded p-2 mt-3">
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <strong>Oda Anahtarı</strong>
                  <small class="text-muted d-block" id="keyCountInfo"></small>
                </div>
                <div class="form-check m-0">
                  <input class="form-check-input" type="checkbox" id="keyDeliveredCheck" name="key_delivered" value="1">
                  <label class="form-check-label" for="keyDeliveredCheck">Teslim Edildi</label>
                </div>
              </div>
            </div>
          </div>

          <input type="hidden" name="handover_payload" id="handoverPayloadInput">
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Ekle</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Oda Ata Modal -->
