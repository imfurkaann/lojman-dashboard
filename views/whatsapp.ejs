<%- include('layout', { title: title }) %>

<div class="row g-4">
  <div class="col-12">
    <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-2">
      <div>
        <h1 class="h3 mb-1">WhatsApp Yönetimi</h1>
        <p class="text-muted mb-0">Baileys ile gruplara doğrudan mesaj gönderin.</p>
      </div>
      <div class="d-flex gap-2 flex-wrap align-items-center">
        <span class="badge bg-<%= whatsapp.connection === 'open' ? 'success' : whatsapp.connection === 'logged_out' ? 'danger' : 'warning' %>">
          <%= whatsapp.connection === 'open' ? 'Bağlı' : whatsapp.connection === 'logged_out' ? 'Yeniden eşleme gerekli' : 'Bağlanıyor' %>
        </span>
        <% if (whatsapp.registered) { %>
          <span class="badge bg-info text-dark">Kayıtlı oturum</span>
        <% } else { %>
          <span class="badge bg-secondary">Oturum bekliyor</span>
        <% } %>
        <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#whatsappConnectionModal">
          <i class="bi bi-sliders me-1"></i> Bağlantıyı Yönet
        </button>
        <a href="/whatsapp/mesaj-yonetimi" class="btn btn-outline-primary btn-sm">
          <i class="bi bi-chat-left-text me-1"></i> Mesaj Yönetimi
        </a>
      </div>
    </div>
  </div>

  <% if (notice) { %>
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
      <div id="whatsappNoticeToast" class="toast align-items-center text-bg-success border-0 shadow-sm" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="2500">
        <div class="d-flex">
          <div class="toast-body py-2 px-3 small fw-semibold"><%= notice %></div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
      </div>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;">
      <div id="whatsappErrorToast" class="toast align-items-center text-bg-danger border-0 shadow-sm" role="status" aria-live="polite" aria-atomic="true" data-bs-delay="2500">
        <div class="d-flex">
          <div class="toast-body py-2 px-3 small fw-semibold"><%= error %></div>
          <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
      </div>
    </div>
  <% } %>

  <div class="col-12">
    <div class="card shadow-sm h-100">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-3">
          <h2 class="h5 mb-0">Mesaj Gönder</h2>
          <span id="whatsappGroupCount" class="badge bg-light text-dark"><%= whatsapp.groups.length %> grup yüklü</span>
        </div>

        <div class="row g-4">
          <div class="col-12">
            <div class="border rounded-3 p-3 h-100">
              <h3 class="h6">Kaydedilen gruplara gönder</h3>
              <form method="post" action="/whatsapp/send-selected-groups" class="mt-3" id="whatsappSendForm">
                <div class="mb-3">
                  <label class="form-label">Mesaj</label>
                  <textarea class="form-control" name="message" rows="5" placeholder="Grup mesajı"><%= formData.message || '' %></textarea>
                </div>

                <button type="submit" class="btn btn-primary w-100" id="whatsappSendButton" <%= selectedGroups.length ? '' : 'disabled' %>>
                  <i class="bi bi-chat-dots me-1"></i> Kaydedilen gruplara gönder
                </button>
                <div class="small text-muted mt-2" id="whatsappSendHint">
                  Mesaj, aşağıda seçili olarak tuttuğunuz gruplara gönderilir.
                </div>
              </form>

              <div class="border rounded-3 p-3 mt-4 bg-success-subtle">
                <div class="d-flex align-items-center justify-content-between mb-2">
                  <h4 class="h6 mb-0">Seçili Gruplar</h4>
                  <span id="whatsappSelectedGroupsCount" class="badge bg-success"><%= selectedGroups.length %> grup</span>
                </div>
                <div id="whatsappSelectedGroupsWrap" class="d-flex flex-wrap gap-2">
                  <% if (selectedGroups.length) { %>
                    <% selectedGroups.forEach((group) => { %>
                      <button type="button" class="btn btn-success btn-sm rounded-pill d-inline-flex align-items-center gap-2" data-whatsapp-selected-remove data-group-jid="<%= group.group_jid %>" data-group-subject="<%= group.subject %>">
                        <span><%= group.subject %></span>
                        <i class="bi bi-x-circle"></i>
                      </button>
                    <% }) %>
                  <% } else { %>
                    <div class="small text-muted">Henüz seçili grup yok. Modalden gruplara tıklayarak ekleyin.</div>
                  <% } %>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="whatsappConnectionModal" tabindex="-1" aria-labelledby="whatsappConnectionModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-dark text-white">
        <div>
          <h2 class="modal-title h5 mb-0" id="whatsappConnectionModalLabel">WhatsApp Bağlantı Merkezi</h2>
          <div class="small text-white-50">QR okutma, yeniden bağlanma ve oturumu sıfırlama işlemleri burada yapılır.</div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <div class="modal-body">
        <div class="row g-4">
          <div class="col-12 col-lg-5">
            <div class="border rounded-3 p-3 h-100 bg-light">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h6 mb-0">Bağlantı Durumu</h3>
                <span id="whatsappConnectionBadge" class="badge bg-<%= whatsapp.connection === 'open' ? 'success' : whatsapp.connection === 'logged_out' ? 'danger' : 'warning' %>">
                  <%= whatsapp.connection === 'open' ? 'Bağlı' : whatsapp.connection === 'logged_out' ? 'Yeniden eşleme gerekli' : 'Bağlanıyor' %>
                </span>
              </div>

              <div class="small text-muted">Son durum</div>
              <div id="whatsappConnectionStateText" class="fw-semibold mb-2"><%= whatsapp.connection %></div>
              <div id="whatsappConnectionAccount" class="small text-muted <%= whatsapp.me && whatsapp.me.id ? '' : 'd-none' %>">Hesap: <%= whatsapp.me && whatsapp.me.id ? whatsapp.me.id : '' %></div>
              <div id="whatsappConnectionLastConnected" class="small text-muted <%= whatsapp.lastConnectedAt ? '' : 'd-none' %>">Son bağlantı: <%= whatsapp.lastConnectedAt || '' %></div>
              <div id="whatsappConnectionError" class="small text-danger mt-2 <%= whatsapp.lastError ? '' : 'd-none' %>"><%= whatsapp.lastError || '' %></div>

              <div class="d-grid gap-2 mt-4">
                <button type="button" class="btn btn-success w-100" data-whatsapp-action="start">
                  <i class="bi bi-play-circle me-1"></i> QR başlat / bağlan
                </button>
                <button type="button" class="btn btn-outline-primary w-100" data-whatsapp-action="reconnect">
                  <i class="bi bi-arrow-repeat me-1"></i> Yeniden bağlan
                </button>
                <button type="button" class="btn btn-outline-danger w-100" data-whatsapp-action="reset">
                  <i class="bi bi-trash3 me-1"></i> Sıfırla
                </button>
              </div>
            </div>
          </div>

          <div class="col-12 col-lg-7">
            <div class="border rounded-3 p-3 h-100">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <h3 class="h6 mb-0">QR Kod</h3>
                <span id="whatsappRegistrationBadge" class="badge bg-light text-dark"><%= whatsapp.registered ? 'Kayıtlı oturum' : 'Yeni eşleme' %></span>
              </div>

              <% if (whatsapp.qrDataUrl) { %>
                <div id="whatsappQrWrap" class="text-center">
                  <img id="whatsappQrImage" src="<%= whatsapp.qrDataUrl %>" alt="WhatsApp QR" class="img-fluid border rounded-3 bg-white p-2 whatsapp-qr-image">
                  <p id="whatsappQrHint" class="small text-muted mt-3 mb-0">Telefonunuzdan QR kodu okutun. Ekran açık kalabilir.</p>
                </div>
              <% } else { %>
                <div id="whatsappQrWrap" class="border border-dashed rounded-3 p-4 text-center bg-light">
                  <i class="bi bi-qr-code-scan fs-1 text-muted"></i>
                  <p id="whatsappQrHint" class="mb-0 mt-2 text-muted">QR kod görünür olduğunda burada çıkacak.</p>
                </div>
              <% } %>
            </div>
          </div>

          <div class="col-12">
            <div class="border rounded-3 p-3 bg-light">
              <div class="d-flex align-items-center justify-content-between mb-2">
                <h3 class="h6 mb-0">WhatsApp Grupları</h3>
                <span id="whatsappAvailableGroupsCount" class="badge bg-light text-dark"><%= whatsapp.groups.length %> grup</span>
              </div>
              <div class="small text-muted mb-3">Bir gruba dokunarak seçebilir veya seçimi kaldırabilirsiniz. Seçili gruplar alttaki yeşil alanda tutulur.</div>
              <div id="whatsappAvailableGroupsWrap" class="row g-2">
                <% if (whatsapp.groups.length) { %>
                  <% whatsapp.groups.forEach((group) => { %>
                    <div class="col-12 col-md-6 col-xl-4">
                      <button type="button"
                        class="btn w-100 text-start <%= selectedGroups.some((selected) => String(selected.group_jid) === String(group.id)) ? 'btn-success' : 'btn-outline-secondary' %>"
                        data-whatsapp-group-toggle
                        data-group-jid="<%= group.id %>"
                        data-group-subject="<%= group.subject %>"
                        data-group-participants="<%= group.participants %>"
                        data-group-community="<%= group.isCommunity ? '1' : '0' %>">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                          <div>
                            <div class="fw-semibold"><%= group.subject %></div>
                            <div class="small opacity-75"><%= group.participants %> kişi</div>
                          </div>
                          <span class="badge <%= selectedGroups.some((selected) => String(selected.group_jid) === String(group.id)) ? 'bg-light text-dark' : 'bg-secondary' %>">
                            <%= selectedGroups.some((selected) => String(selected.group_jid) === String(group.id)) ? 'Seçili' : 'Ekle' %>
                          </span>
                        </div>
                      </button>
                    </div>
                  <% }) %>
                <% } else { %>
                  <div class="col-12">
                    <div class="text-muted small">Bağlantı tamamlanınca gruplar burada görünecek.</div>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
      </div>
    </div>
  </div>
</div>

<%- include('footer') %>