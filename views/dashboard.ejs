<%- include('layout', { title: 'Ana Sayfa' }) %>

<!-- İstatistik Kartları -->
<div class="row g-3 mb-4">
  <div class="col-md-2">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center">
        <i class="bi bi-door-open text-primary fs-2"></i>
        <h3 class="mt-2"><%= totalRooms %></h3>
        <p class="text-muted mb-0">Toplam Oda</p>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center">
        <i class="bi bi-people text-success fs-2"></i>
        <h3 class="mt-2"><%= registeredPersonnel %></h3>
        <p class="text-muted mb-0">Kayıtlı Personel</p>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center">
        <i class="bi bi-arrow-down-circle text-success fs-2"></i>
        <h3 class="mt-2"><%= pendingEntries %></h3>
        <p class="text-muted mb-0">Giriş Bekleyen</p>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center">
        <i class="bi bi-arrow-up-circle text-danger fs-2"></i>
        <h3 class="mt-2"><%= pendingExits %></h3>
        <p class="text-muted mb-0">Çıkış Bekleyen</p>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center">
        <i class="bi bi-exclamation-circle text-danger fs-2"></i>
        <h3 class="mt-2"><%= openIssues %></h3>
        <p class="text-muted mb-0">Açık Sorun</p>
      </div>
    </div>
  </div>
  <div class="col-md-2">
    <div class="card border-0 shadow-sm">
      <div class="card-body text-center">
        <i class="bi bi-box-seam text-warning fs-2"></i>
        <h3 class="mt-2"><%= unreturned %></h3>
        <p class="text-muted mb-0">İade Bekleyen Eşya</p>
      </div>
    </div>
  </div>
</div>

<!-- Oda Durumları Hızlı Bakış -->
<div class="row row-cols-1 row-cols-sm-2 row-cols-lg-5 g-3 mb-4">
  <div class="col">
    <div class="card border-start border-success border-4">
      <div class="card-body py-2 d-flex justify-content-between align-items-center">
        <span class="text-muted">Boş Odalar</span>
        <span class="badge bg-success fs-6"><%= emptyRooms %></span>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-start border-danger border-4">
      <div class="card-body py-2 d-flex justify-content-between align-items-center">
        <span class="text-muted">Dolu Odalar</span>
        <span class="badge bg-danger fs-6"><%= fullRooms %></span>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-start border-warning border-4">
      <div class="card-body py-2 d-flex justify-content-between align-items-center">
        <span class="text-muted">Kısmi Dolu</span>
        <span class="badge bg-warning fs-6"><%= partialRooms %></span>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-start border-warning border-4">
      <div class="card-body py-2 d-flex justify-content-between align-items-center">
        <span class="text-muted">Temizlenmesi Gerekiyor</span>
        <span class="badge bg-warning text-dark fs-6"><%= cleaningNeededRooms %></span>
      </div>
    </div>
  </div>
  <div class="col">
    <div class="card border-start border-danger border-4">
      <div class="card-body py-2 d-flex justify-content-between align-items-center">
        <span class="text-muted">Kullanılamaz</span>
        <span class="badge bg-danger fs-6"><%= unavailableRooms %></span>
      </div>
    </div>
  </div>
</div>

<!-- Son Hareketler -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <h6 class="mb-0"><i class="bi bi-clock-history"></i> Son Hareketler</h6>
    <a href="/gecmis" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
  </div>
  <div class="card-body p-0">
    <% if (recentActivity.length === 0) { %>
      <div class="text-center text-muted py-4">Henüz hareket kaydı yok</div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Tarih</th>
            <th>İşlem</th>
            <th>Açıklama</th>
            <th>Kullanıcı</th>
          </tr>
        </thead>
        <tbody>
          <% recentActivity.forEach(a => { %>
          <tr>
            <td class="text-nowrap"><small><%= new Date(a.created_at).toLocaleString('tr-TR') %></small></td>
            <td><span class="badge bg-primary"><%= a.action_type %></span></td>
            <td><%= a.description %></td>
            <td><%= a.user_name || '-' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('footer') %>
