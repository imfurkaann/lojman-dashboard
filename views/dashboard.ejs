<%- include('layout', { title: 'Ana Sayfa' }) %>

<!-- Use global modern dashboard styles from public/css/style.css -->
<div class="card header-hero">
  <div class="d-flex justify-content-between align-items-center">
    <div>
      <h4>Ana Sayfa</h4>
      <p class="mb-0">Hızlı genel bakış — odalar, personel ve son hareketler</p>
    </div>
    <div class="text-end muted-sep"><small><%= (new Date()).toLocaleString('tr-TR') %></small></div>
  </div>
</div>

<!-- İstatistik Kartları - Modern Tiles -->
<div class="metrics-grid">
  <div class="metric-tile metric-variant-primary">
    <div class="metric-top">
      <div class="metric-icon-wrap"><i class="bi bi-door-open"></i></div>
      <div class="metric-body">
        <div class="metric-label">Toplam Oda</div>
        <div class="metric-number"><%= totalRooms %></div>
      </div>
    </div>
    <svg class="sparkline" viewBox="0 0 100 34" preserveAspectRatio="none"><polyline fill="none" stroke="#6366f1" stroke-width="2" points="0,28 20,18 40,10 60,12 80,8 100,6"/></svg>
  </div>

  <div class="metric-tile metric-variant-success">
    <div class="metric-top">
      <div class="metric-icon-wrap"><i class="bi bi-people"></i></div>
      <div class="metric-body">
        <div class="metric-label">Çıkış Yapmış Personel</div>
        <div class="metric-number"><%= exitedPersonnel %></div>
      </div>
    </div>
    <div class="metric-change">Bugün <strong><%= todayExits %></strong> kişi</div>
  </div>

  <div class="metric-tile metric-variant-info">
    <div class="metric-top">
      <div class="metric-icon-wrap"><i class="bi bi-house-heart"></i></div>
      <div class="metric-body">
        <div class="metric-label">Mevcut Konaklayan Personel</div>
        <div class="metric-number"><%= occupiedPersonnel %></div>
      </div>
    </div>
    <div class="metric-change">Doluluk: <strong><%= occupiedPersonnel %></strong></div>
  </div>

  <div class="metric-tile metric-variant-primary">
    <div class="metric-top">
      <div class="metric-icon-wrap"><i class="bi bi-box-arrow-in-down"></i></div>
      <div class="metric-body">
        <div class="metric-label">Bugün Giriş</div>
        <div class="metric-number"><%= todayEntries %></div>
      </div>
    </div>
  </div>

  <div class="metric-tile metric-variant-danger">
    <div class="metric-top">
      <div class="metric-icon-wrap"><i class="bi bi-box-arrow-up"></i></div>
      <div class="metric-body">
        <div class="metric-label">Bugün Çıkış</div>
        <div class="metric-number"><%= todayExits %></div>
      </div>
    </div>
  </div>

  <div class="metric-tile metric-variant-warning">
    <div class="metric-top">
      <div class="metric-icon-wrap"><i class="bi bi-exclamation-circle"></i></div>
      <div class="metric-body">
        <div class="metric-label">Açık Sorun</div>
        <div class="metric-number"><%= openIssues %></div>
      </div>
    </div>
  </div>

  <div class="metric-tile metric-variant-warning">
    <div class="metric-top">
      <div class="metric-icon-wrap"><i class="bi bi-box-seam"></i></div>
      <div class="metric-body">
        <div class="metric-label">İade Bekleyen Eşya</div>
        <div class="metric-number"><%= unreturned %></div>
      </div>
    </div>
  </div>
</div>

<!-- Oda Durumları Hızlı Bakış - Tile Style -->
<div class="rooms-tiles">
  <div class="room-tile"><div class="label">Boş Oda Sayısı</div><div class="count"><%= emptyRooms %></div></div>
  <div class="room-tile"><div class="label">Dolu Oda Sayısı</div><div class="count"><%= fullRooms %></div></div>
  <div class="room-tile"><div class="label">Kısmi Dolu Oda Sayısı</div><div class="count"><%= partialRooms %></div></div>
  <div class="room-tile"><div class="label">Temiz Oda Sayısı</div><div class="count"><%= availableRooms %></div></div>
  <div class="room-tile"><div class="label">Temizlenmesi Gereken Oda Sayısı</div><div class="count"><%= cleaningNeededRooms %></div></div>
  <div class="room-tile"><div class="label">Kullanılamaz Oda Sayısı</div><div class="count"><%= unavailableRooms %></div></div>
</div>
<!-- Son Hareketler -->
<div class="card border-0 shadow-sm">
  <div class="card-header bg-white d-flex justify-content-between align-items-center">
    <h6 class="mb-0"><i class="bi bi-clock-history"></i> Son Hareketler</h6>
    <a href="/gecmis" class="btn btn-sm btn-outline-primary">Tümünü Gör</a>
  </div>
  <div class="card-body p-0">
    <% if (recentActivity.length === 0) { %>
      <div class="text-center text-muted py-4">Henüz hareket kaydı yok</div>
    <% } else { %>
      <ul class="activity-list">
        <% recentActivity.forEach(a => { %>
          <li class="activity-item">
            <div class="activity-avatar"><i class="bi bi-person"></i></div>
            <div class="activity-content">
              <div><strong><%= a.action_type %></strong> — <span class="muted-sep"><%= a.description %></span></div>
              <div class="activity-time"><small><%= new Date(a.created_at).toLocaleString('tr-TR') %> • <%= a.user_name || '-' %></small></div>
            </div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </div>
</div>

<%- include('footer') %>
