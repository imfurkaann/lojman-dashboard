<%- include('layout', { title: title }) %>

<%
  const safeDailyTemplates = typeof dailyTemplates !== 'undefined' && Array.isArray(dailyTemplates) ? dailyTemplates : [];
  const safeEquipmentReminderRules = typeof equipmentReminderRules !== 'undefined' && Array.isArray(equipmentReminderRules) ? equipmentReminderRules : [];
  const safeSavedEquipmentItems = typeof savedEquipmentItems !== 'undefined' && Array.isArray(savedEquipmentItems) ? savedEquipmentItems : [];
  const activeDailyCount = safeDailyTemplates.filter((template) => template.isEnabled).length;
  const activeEquipmentCount = safeEquipmentReminderRules.filter((rule) => rule.isEnabled).length;
%>

<div class="container-fluid py-4">
  <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 mb-3">
    <div>
      <h1 class="h3 mb-1">WhatsApp Mesaj Yönetimi</h1>
      <p class="text-muted mb-0">Mesaj şablonlarını yönetin, başlıklarını görün ve aktiflik durumlarını açıp kapatın.</p>
    </div>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#messageTemplateModal">
      <i class="bi bi-plus-circle me-1"></i> Mesaj Oluştur
    </button>
  </div>

  <% if (notice) { %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
  <% } %>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
      <h5 class="mb-0">Mesaj Şablonları</h5>
      <span class="badge bg-light text-dark"><%= safeDailyTemplates.length %> şablon - <%= activeDailyCount %> aktif</span>
    </div>
    <div class="card-body">
      <% if (!safeDailyTemplates.length) { %>
        <div class="alert alert-light border mb-0">Henüz mesaj şablonu yok.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="min-width: 320px;">Başlık</th>
                <th style="width: 100px;">Saat</th>
                <th style="width: 120px;">Aktiflik</th>
              </tr>
            </thead>
            <tbody>
              <% safeDailyTemplates.forEach((template) => { %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= template.title %></div>
                    <div class="small text-muted text-truncate" style="max-width: 300px;"><%= template.messageTemplate %></div>
                  </td>
                  <td>
                    <span class="badge bg-info"><%= template.sendTime %></span>
                  </td>
                  <td>
                    <form method="post" action="/whatsapp/daily-templates/<%= template.id %>/toggle" class="d-inline">
                      <button type="submit" class="btn btn-sm <%= template.isEnabled ? 'btn-success' : 'btn-secondary' %>">
                        <%= template.isEnabled ? 'Aktif' : 'Pasif' %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <div class="card border-0 shadow-sm mt-4">
    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between">
      <h5 class="mb-0">Eşya Bazlı Şablonlar</h5>
      <span class="badge bg-light text-dark"><%= safeEquipmentReminderRules.length %> şablon - <%= activeEquipmentCount %> aktif</span>
    </div>
    <div class="card-body">
      <% if (!safeEquipmentReminderRules.length) { %>
        <div class="alert alert-light border mb-0">Henüz eşya bazlı şablon yok.</div>
      <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th style="min-width: 280px;">Başlık</th>
                <th>Eşya</th>
                <th style="width: 100px;">Dakika</th>
                <th style="width: 120px;">Durum</th>
              </tr>
            </thead>
            <tbody>
              <% safeEquipmentReminderRules.forEach((rule) => { %>
                <tr>
                  <td>
                    <div class="fw-semibold"><%= rule.title || rule.itemName %></div>
                    <div class="small text-muted text-truncate" style="max-width: 320px;"><%= rule.messageTemplate %></div>
                  </td>
                  <td><%= rule.itemName %></td>
                  <td><span class="badge bg-warning text-dark"><%= rule.delayMinutes %></span></td>
                  <td>
                    <form method="post" action="/whatsapp/equipment-reminder-rules/<%= rule.id %>/toggle" class="d-inline">
                      <button type="submit" class="btn btn-sm <%= rule.isEnabled ? 'btn-success' : 'btn-secondary' %>">
                        <%= rule.isEnabled ? 'Aktif' : 'Pasif' %>
                      </button>
                    </form>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="modal fade" id="messageTemplateModal" tabindex="-1" aria-labelledby="messageTemplateModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="messageTemplateModalLabel">Mesaj Şablonu Oluştur</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
      </div>
      <form id="messageTemplateForm">
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold">Şablon Türü</label>
            <div class="row g-3">
              <div class="col-12 col-md-6">
                <label class="border rounded-3 p-3 w-100 d-block">
                  <input class="form-check-input me-2 template-type" type="radio" name="templateType" value="daily" checked>
                  <strong>Genel Günlük Mesaj</strong>
                  <div class="small text-muted mt-1">Belirli saatte gönderilecek genel şablon.</div>
                </label>
              </div>
              <div class="col-12 col-md-6">
                <label class="border rounded-3 p-3 w-100 d-block">
                  <input class="form-check-input me-2 template-type" type="radio" name="templateType" value="equipment">
                  <strong>Eşya Bazlı Mesaj</strong>
                  <div class="small text-muted mt-1">Eşya tesliminden sonra gönderilecek mesaj.</div>
                </label>
              </div>
            </div>
          </div>

          <div id="dailyFields">
            <div class="mb-3">
              <label class="form-label">Başlık</label>
              <input type="text" class="form-control" name="daily_title" placeholder="Örn. Günlük kontrol mesajı">
            </div>
            <div class="mb-3">
              <label class="form-label">Gönderim Saati</label>
              <input type="time" class="form-control" name="daily_send_time">
            </div>
            <div class="mb-3">
              <label class="form-label">Mesaj İçeriği</label>
              <textarea class="form-control" name="daily_message_template" rows="4" placeholder="Mesajınızı yazın"></textarea>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="daily_is_enabled" value="1" checked>
              <label class="form-check-label">Aktif</label>
            </div>
          </div>

          <div id="equipmentFields" style="display:none;">
            <div class="mb-3">
              <label class="form-label">Başlık</label>
              <input type="text" class="form-control" name="equipment_title" placeholder="Örn. Monitör hatırlatması">
            </div>
            <div class="mb-3">
              <label class="form-label">Eşya</label>
              <select class="form-select" name="equipment_item_name">
                <option value="">Eşya seçin</option>
                <% safeSavedEquipmentItems.forEach((item) => { %>
                  <option value="<%= item.name %>"><%= item.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label">Dakika</label>
              <input type="number" class="form-control" name="equipment_delay_minutes" min="0" step="1" placeholder="Örn. 60">
            </div>
            <div class="mb-3">
              <label class="form-label">Mesaj İçeriği</label>
              <textarea class="form-control" name="equipment_message_template" rows="4" placeholder="Mesajınızı yazın"></textarea>
            </div>
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="equipment_is_enabled" value="1" checked>
              <label class="form-check-label">Aktif</label>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">İptal</button>
          <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  const templateTypeInputs = document.querySelectorAll('.template-type');
  const dailyFields = document.getElementById('dailyFields');
  const equipmentFields = document.getElementById('equipmentFields');

  templateTypeInputs.forEach((input) => {
    input.addEventListener('change', () => {
      const selected = document.querySelector('input[name="templateType"]:checked')?.value;
      dailyFields.style.display = selected === 'daily' ? 'block' : 'none';
      equipmentFields.style.display = selected === 'equipment' ? 'block' : 'none';
    });
  });

  document.getElementById('messageTemplateForm').addEventListener('submit', async (event) => {
    event.preventDefault();

    const selected = document.querySelector('input[name="templateType"]:checked')?.value;
    const formData = new FormData();

    if (selected === 'equipment') {
      formData.append('rows[0][title]', event.target.equipment_title.value.trim());
      formData.append('rows[0][item_name]', event.target.equipment_item_name.value.trim());
      formData.append('rows[0][delay_minutes]', event.target.equipment_delay_minutes.value.trim());
      formData.append('rows[0][message_template]', event.target.equipment_message_template.value.trim());
      formData.append('rows[0][is_enabled]', event.target.equipment_is_enabled.checked ? '1' : '0');

      const response = await fetch('/whatsapp/equipment-reminder-rules', {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        window.location.reload();
      }
      return;
    }

    formData.append('title', event.target.daily_title.value.trim());
    formData.append('send_time', event.target.daily_send_time.value.trim());
    formData.append('message_template', event.target.daily_message_template.value.trim());
    formData.append('is_enabled', event.target.daily_is_enabled.checked ? '1' : '0');

    const response = await fetch('/whatsapp/daily-templates', {
      method: 'POST',
      body: formData
    });

    if (response.ok) {
      window.location.reload();
    }
  });
</script>

<%- include('footer') %>
